---
import { getJsonLdBlocks } from '~/config/schema';
import { getCustomSchema, isSchemaFreePath } from '~/config/schema/customOverrides';

export interface Props {
  /** Page-specific nodes (blog posts) used only when the document has no block for this path. */
  extra?: Array<Record<string, unknown>>;
}

const { extra = [] } = Astro.props;
const pathname = Astro.url.pathname;
const custom = getCustomSchema(pathname);
const generated = custom || isSchemaFreePath(pathname) ? [] : [...getJsonLdBlocks(pathname), ...extra];
---

{
  custom ? (
    <script type="application/ld+json" is:inline set:html={JSON.stringify(custom)} />
  ) : (
    generated.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)
  )
}
