---
import { getCustomSchema } from '~/config/schema/customOverrides';

/**
 * Document blocks only. The old generator (placeholder phone, brand Restaurant,
 * price range) is not rendered. Pages the document leaves blank emit nothing.
 */
const custom = getCustomSchema(Astro.url.pathname);
---

{custom && <script type="application/ld+json" is:inline set:html={JSON.stringify(custom)} />}
