---
import { getJsonLdBlocks } from '~/config/schema';

export interface Props {
  /** Page-specific nodes (e.g. BlogPosting) added after the path-based blocks. */
  extra?: Array<Record<string, unknown>>;
}

const { extra = [] } = Astro.props;
const blocks = [...getJsonLdBlocks(Astro.url.pathname), ...extra];
---

{blocks.map((block) => <script type="application/ld+json" is:inline set:html={JSON.stringify(block)} />)}
