---
import Image from '~/components/common/Image.astro';
import type { ContentImage } from '~/lib/content/types';

export interface Props {
  image?: ContentImage;
  caption?: string;
  eager?: boolean;
  class?: string;
  /** Hero uses cover. Inline photos use contain so the full picture stays visible. */
  fit?: 'cover' | 'contain';
}

const { image, caption, eager = false, class: className = 'my-8', fit = 'cover' } = Astro.props;
const contained = fit === 'contain';
---

{
  image?.src && (
    <figure class={className}>
      <div class:list={[contained ? 'w-full' : 'relative w-full aspect-[16/9] overflow-hidden rounded-md bg-[#EFEFEF]']}>
        <Image
          src={image.src}
          alt={image.alt}
          class:list={[contained ? 'w-full h-auto object-contain' : 'w-full h-full object-cover']}
          widths={[400, 768, 1200]}
          sizes="(max-width: 768px) 100vw, 70vw"
          width={1200}
          height={contained ? undefined : 675}
          layout={contained ? 'constrained' : 'cover'}
          format="webp"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
        />
      </div>
      {caption && (
        <figcaption class="mt-3 text-[14px] md:text-[15px] font-normal leading-[160%] text-muted">{caption}</figcaption>
      )}
    </figure>
  )
}
