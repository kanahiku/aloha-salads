---
/**
 * Interior page shell used until each route is designed from Figma.
 * Compose Hero2 + optional sections. Do not fork this per page.
 */
import Hero2 from '~/components/widgets/Hero2.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import type { InteriorPageContent } from '~/data/pages/interior';

export interface Props {
  page: InteriorPageContent;
  /** Skip the built-in hero when the route composes its own (e.g. /careers). */
  hideHero?: boolean;
  /** Extra classes for the section container (merged over the WidgetWrapper defaults). */
  containerClass?: string;
  /** Render only the section content, with no section wrapper, so a parent layout can place it (e.g. beside a form). */
  bare?: boolean;
  /** Light text and dividers for use on a dark panel. */
  onDark?: boolean;
}

const { page, hideHero = false, containerClass = '', bare = false, onDark = false } = Astro.props;
const Wrapper = bare ? Fragment : WidgetWrapper;
const wrapperProps = bare ? {} : { containerClass: `max-w-container mx-auto ${containerClass}` };
const sections = page.sections ?? [];
const hasBody = sections.length > 0;
---

{hideHero ? null : <Hero2 variant="page" overlapHeader={false} stacked title={page.heading} subtitle={page.lede} />}

{
  hasBody && (
    <Wrapper {...wrapperProps}>
      <div class="flex max-w-3xl flex-col gap-12 md:gap-16">
        {sections.map((section) => (
          <section class="flex flex-col items-start gap-6">
            {section.heading && (
              <Heading variant="h2" color={onDark ? 'white' : 'default'}>
                {section.heading}
              </Heading>
            )}
            {section.body && (
              <Text variant="body-lg" color={onDark ? 'white' : 'muted'}>
                {section.body}
              </Text>
            )}
            {section.items && section.items.length > 0 && (
              <ul class="flex w-full flex-col gap-3">
                {section.items.map((item) => (
                  <li
                    class:list={[
                      'flex flex-col gap-1 border-b pb-3 last:border-b-0 last:pb-0',
                      onDark ? 'border-page/15' : 'border-heading/10',
                    ]}
                  >
                    <Heading variant="h4" as="p" color={onDark ? 'white' : 'default'}>
                      {item.title}
                    </Heading>
                    {item.description && <Text color={onDark ? 'white' : 'muted'}>{item.description}</Text>}
                  </li>
                ))}
              </ul>
            )}
            {section.links && section.links.length > 0 && (
              <ul class="flex flex-col items-start gap-3">
                {section.links.map((link) => (
                  <li>
                    <Button
                      variant="ghost"
                      tone="light"
                      text={link.text}
                      href={link.href}
                      hideNote
                      class="self-start"
                    />
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </Wrapper>
  )
}
