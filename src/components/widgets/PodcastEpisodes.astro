---
/**
 * PodcastEpisodes — category header + grid of Card variant="podcast".
 * Dark (121:916): tan wash bg-cta/60, cream cards, dark type.
 * Light (121:1286): white section, same cream cards (Figma 121:1293).
 *
 * Pass a single episode while the grid is still a template; the layout is a
 * 3-col grid so additional cards drop in without a restyle.
 */
import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface PodcastEpisodeItem {
  title: string;
  tag: string;
  description: string;
  ctaText?: string;
  ctaHref?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  episodes: PodcastEpisodeItem[];
  tone?: 'light' | 'dark';
  id?: string;
}

const {
  eyebrow,
  heading,
  description,
  episodes = [],
  tone = 'light',
  id,
} = Astro.props;

const isDark = tone === 'dark';
---

<section
  {...id ? { id } : {}}
  class:list={[
    'not-prose w-full',
    isDark ? 'bg-cta/60' : 'bg-white',
  ]}
>
  <div class="mx-auto flex w-full max-w-container flex-col items-center gap-10 px-5 py-10 sm:px-8 md:gap-16 md:px-16 md:py-16 lg:px-[120px]">
    <div class="flex flex-col items-center gap-4 text-center">
      {eyebrow && (
        <Heading variant="eyebrow">{eyebrow}</Heading>
      )}
      <Heading variant="h2">{heading}</Heading>
      {description && (
        <Text>{description}</Text>
      )}
    </div>

    {episodes.length > 0 && (
      <div class="grid w-full grid-cols-1 items-stretch gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {episodes.map((episode) => (
          <Card
            variant="podcast"
            tone={tone}
            title={episode.title}
            label={episode.tag}
            description={episode.description}
            ctaText={episode.ctaText ?? 'Read the guidebook'}
            ctaHref={episode.ctaHref ?? '#'}
          />
        ))}
      </div>
    )}
  </div>
</section>
