---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import BlogCard from '~/components/ui/BlogCard.astro';
import { getBlogPostsRelatedTo, getRelatedBlogPosts } from '~/lib/content';
import { isDarkSurface, type SectionSurface } from '~/lib/content/sectionTheme';
import type { BlogPost } from '~/lib/content/types';

export interface Props {
  pageSlug?: string;
  post?: BlogPost;
  excludeSlug?: string;
  surface?: SectionSurface;
  title?: string;
  /** Render the section and card titles as paragraphs, e.g. below a blog article whose headings must match its document. */
  plainHeadings?: boolean;
}

const RELATED_LIMIT = 3;

const {
  pageSlug,
  post,
  excludeSlug,
  surface = 'grey',
  title = 'Related Blogs',
  plainHeadings = false,
} = Astro.props;

const related = post
  ? await getRelatedBlogPosts(post, RELATED_LIMIT)
  : pageSlug
    ? (await getBlogPostsRelatedTo(pageSlug))
        .filter((item) => item.slug !== excludeSlug)
        .slice(0, RELATED_LIMIT)
    : [];

const isDark = isDarkSurface(surface);
---

{
  related.length > 0 && (
    <WidgetWrapper containerClass="max-w-container mx-auto" isDark={isDark}>
      <Headline
        isDark={isDark}
        title={title}
        titleTag={plainHeadings ? 'p' : 'h2'}
        classes={{ container: 'mb-[30px]' }}
      />
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-6">
        {related.map((item) => (
          <BlogCard post={item} variant="outlined" titleTag={plainHeadings ? 'p' : 'h3'} />
        ))}
      </div>
      <Fragment slot="bg">
        <SectionBg variant={surface} />
      </Fragment>
    </WidgetWrapper>
  )
}
