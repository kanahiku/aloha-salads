---
/**
 * LocalSourcing — Homepage 59:106.
 * Transparent band so the page gradient + leaf motif show through.
 * Inner intro panel and fact cards stay filled. One widget for the whole site.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import basketIcon from '~/assets/icons/Shopping-Basket-Like--Streamline-Freehand.svg?url';
import onoIsland from '~/assets/images/ono-island.webp';

export interface SourcingFact {
  title: string;
  description: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  facts?: SourcingFact[];
  /**
   * When true, replaces the right text column with a tall food-photo placeholder.
   * The intro panel becomes a split layout: text+CTA left / photo right.
   */
  withPhoto?: boolean;
  id?: string;
}

const {
  eyebrow = 'Our ingredients & local sourcing',
  title = 'Sourced close to home, on purpose.',
  subtitle = "We've bought from local farmers and fishermen since day one in Kailua. Here's what that actually means on your plate — in specifics, not adjectives.",
  ctaText = 'See where our food comes from',
  ctaHref = '/ingredients',
  withPhoto = false,
  facts = [],
  id,
} = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full"
>
  <div class="mx-auto flex w-full max-w-container flex-col px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
    <div class:list={['flex w-full flex-col', facts.length > 0 && 'md:mb-[-42px]']}>
      {withPhoto ? (
        /* ── withPhoto: text-stack left / tall photo placeholder right ── */
        <div class="flex w-full flex-col overflow-hidden bg-section-grey md:flex-row">
          {/* Text column */}
          <div class="flex flex-col items-start gap-6 px-6 py-10 md:w-[52%] md:px-14 md:py-16 md:pb-[100px]">
            {eyebrow && (
              <Heading variant="eyebrow" color="inherit" class="text-heading mix-blend-overlay opacity-80">
                {eyebrow}
              </Heading>
            )}
            {title && <Heading variant="h2">{title}</Heading>}
            {subtitle && (
              <Text variant="body-lg" color="default">{subtitle}</Text>
            )}
            {ctaText && (
              <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />
            )}
          </div>
          {/* Photo column */}
          <div class="relative min-h-[280px] flex-1 overflow-hidden md:min-h-0">
            <img
              src={onoIsland.src}
              alt="Fresh avocado and mango salad bowl with local ingredients"
              width={onoIsland.width}
              height={onoIsland.height}
              class="absolute inset-0 h-full w-full object-cover object-center"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>
      ) : (
        /* ── default: 2-col text split ── */
        <div class="flex w-full flex-col bg-section-grey px-6 pb-10 pt-10 backdrop-blur-sm md:px-16 md:pb-[92px] md:pr-[100px] md:pt-16">
          <div class="flex w-full flex-col items-start gap-8 md:flex-row md:gap-16">
            <div class="flex min-w-0 flex-1 flex-col items-start gap-6">
              {eyebrow && (
                <Heading variant="eyebrow" color="inherit" class="text-heading mix-blend-overlay opacity-80">
                  {eyebrow}
                </Heading>
              )}
              {title && <Heading variant="h2">{title}</Heading>}
            </div>
            <div class="flex min-w-0 flex-1 flex-col items-start gap-6">
              {subtitle && (
                <Text variant="body-lg" color="default">{subtitle}</Text>
              )}
              {ctaText && (
                <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />
              )}
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="relative z-[1] grid w-full grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        facts.length > 0 && facts.map((fact) => (
          <article class="flex h-full flex-col items-start gap-3 border-8 border-section-grey bg-page p-6">
            <div class="flex w-full items-center gap-3">
              <div
                class="size-12 shrink-0 bg-accent"
                style={`-webkit-mask-image: url('${basketIcon}'); mask-image: url('${basketIcon}'); -webkit-mask-size: contain; mask-size: contain; -webkit-mask-repeat: no-repeat; mask-repeat: no-repeat; -webkit-mask-position: center; mask-position: center;`}
                aria-hidden="true"
              ></div>
              <Heading variant="h3" class="min-w-0 flex-1">{fact.title}</Heading>
            </div>
            <Text color="default">{fact.description}</Text>
          </article>
        ))
      }
    </div>
  </div>
</section>
