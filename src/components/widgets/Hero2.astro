---
import Image from '~/components/common/Image.astro';
import ArtDirectedImage from '~/components/ui/ArtDirectedImage.astro';
import CTAActions from '~/components/ui/CTAActions.astro';
import overlayImage from '~/assets/images/patterns/hero-image.svg';
import type { ContentImage } from '~/lib/content/types';

import type { Hero as Props } from '~/types';

const {
  title = await Astro.slots.render('title'),
  subtitle = await Astro.slots.render('subtitle'),
  tagline,
  content = await Astro.slots.render('content'),
  actions = await Astro.slots.render('actions'),
  image = await Astro.slots.render('image'),
  imageMobile,
  variant = 'split',
  isReversed = false,
  overlapHeader = true,
  id,
  bg = await Astro.slots.render('bg'),
} = Astro.props;

const isOverlay = variant === 'overlay';
const hasStats = isOverlay && Astro.slots.has('stats');
const hasImage = Boolean(image && (typeof image !== 'string' || image.trim()));
const isSplitImage = !isOverlay && hasImage;

const asContentImage = (value: unknown): ContentImage | undefined => {
  if (!value || typeof value !== 'object' || Array.isArray(value)) return undefined;
  const src = 'src' in value && typeof value.src === 'string' ? value.src.trim() : '';
  if (!src) return undefined;
  const alt = 'alt' in value && typeof value.alt === 'string' ? value.alt : '';
  return { src, alt };
};

const overlayDesktop = isOverlay ? asContentImage(image) : undefined;
const overlayMobile = isOverlay ? asContentImage(imageMobile) : undefined;
const hasOverlayPhoto = Boolean(overlayDesktop || overlayMobile);
---

<section
  class:list={['relative not-prose', overlapHeader && 'md:-mt-[76px]', isOverlay && 'min-h-[70vh] flex flex-col']}
  {...id ? { id } : {}}
>
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <slot name="bg">
      {bg ? <Fragment set:html={bg} /> : null}
    </slot>
    {
      isOverlay && hasOverlayPhoto && (
        <>
          <ArtDirectedImage
            desktop={overlayDesktop}
            mobile={overlayMobile}
            class="absolute inset-0 h-full w-full object-cover object-center"
            widths={[768, 1200, 1600, 1920]}
            mobileWidths={[400, 640, 828, 1080]}
            sizes="100vw"
            mobileSizes="100vw"
            loading="eager"
            fetchpriority="high"
            width={1920}
            layout="cover"
            format="webp"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/10 to-transparent"></div>
        </>
      )
    }
    {
      isOverlay && !hasOverlayPhoto && !bg && (
        <>
          <img
            src={overlayImage.src}
            alt=""
            class="absolute inset-0 h-full w-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/10 to-transparent"></div>
        </>
      )
    }
  </div>
  <div
    class:list={[
      'relative max-w-[1400px] mx-auto',
      isOverlay && 'flex-1 flex flex-col w-full',
      !isSplitImage && 'px-4 sm:px-6',
    ]}
  >
    {!isSplitImage && overlapHeader && <div class="pt-0 md:pt-[76px] pointer-events-none" />}
    <div
      class:list={[
        isOverlay && hasStats && 'flex-1 flex items-center pt-16 md:pt-[140px] pb-12 md:pb-16',
        isOverlay && !hasStats && 'flex-1 flex items-center py-16 md:py-[120px]',
        isSplitImage && 'md:flex md:items-stretch md:min-h-[640px] lg:min-h-[760px]',
        isSplitImage && isReversed && 'md:flex-row-reverse',
        !isOverlay && !hasImage && 'py-12 md:py-[100px]',
      ]}
    >
      <div
        class:list={[
          isOverlay ? 'w-full max-w-2xl text-left' : hasImage ? 'md:basis-1/2 self-center text-left' : 'w-full max-w-3xl text-left',
          isSplitImage && [
            'px-4 sm:px-6 py-12 md:pb-20 lg:pb-[100px]',
            overlapHeader ? 'md:pt-[calc(76px+5rem)]' : 'md:pt-20',
            isReversed ? 'md:pl-16 lg:pl-24' : 'md:pr-16 lg:pr-24',
          ],
        ]}
      >
        {
          tagline && (
            <p
              class="text-base text-secondary dark:text-blue-200 font-bold tracking-wide uppercase intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
              set:html={tagline}
            />
          )
        }
        {
          title && (
            <h1
              class:list={[
                'text-[42px] md:text-[56px] font-normal leading-[105%] tracking-tighter mb-[20px] font-heading intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter',
                isOverlay ? 'text-white' : 'text-heading dark:text-gray-200',
              ]}
              set:html={title}
            />
          )
        }
        <div class="max-w-3xl lg:max-w-none">
          {
            subtitle && (
              <p
                class:list={[
                  'text-[16px] md:text-[17px] font-normal leading-[160%] mb-[30px] intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter',
                  isOverlay ? 'text-white/80' : 'text-[#444444] dark:text-slate-300',
                ]}
                set:html={subtitle}
              />
            )
          }

          {
            actions &&
              (Array.isArray(actions) ? (
                <CTAActions
                  actions={actions}
                  noteTone={isOverlay ? 'onDark' : 'light'}
                  class="intersect-once motion-safe:md:intersect:animate-fade motion-safe:md:opacity-0 intersect-quarter"
                />
              ) : (
                <Fragment set:html={actions} />
              ))
          }
        </div>
        {content && <Fragment set:html={content} />}
      </div>
      {
        isSplitImage && (
          <div class="relative mt-8 md:mt-0 md:basis-1/2 aspect-[4/3] md:aspect-auto">
            <div class="absolute inset-0 overflow-hidden [&>*]:!h-full [&>*]:!w-full [&>*]:!max-w-none [&>*]:!rounded-none [&>*]:!aspect-auto [&_img]:h-full [&_img]:w-full [&_img]:object-cover [&_img]:rounded-none">
              {typeof image === 'string' ? (
                <Fragment set:html={image} />
              ) : (
                <Image
                  {...image}
                  class="w-full h-full object-cover"
                  widths={[400, 768, 1200]}
                  sizes="(max-width: 768px) 100vw, 50vw"
                  loading="eager"
                  width={700}
                  height={700}
                  layout="cover"
                  format="webp"
                />
              )}
            </div>
          </div>
        )
      }
    </div>
  </div>
  {
    hasStats && (
      <div class="relative bg-[rgb(14_13_7_/_0.1)] backdrop-blur-[15px]">
        <div class="max-w-[1400px] mx-auto px-4 sm:px-6 py-2 md:py-[22px]">
          <slot name="stats" />
        </div>
      </div>
    )
  }
</section>
