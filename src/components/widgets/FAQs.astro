---
import Headline from '~/components/ui/Headline.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import type { Faqs as Props } from '~/types';

const {
  title = '',
  subtitle = '',
  tagline = '',
  items = [],

  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render('bg'),
} = Astro.props;

// CSS variable-based classes
const itemBorder = isDark ? 'border-faq-dark' : 'border-faq-light';
const questionColor = classes?.question ?? (isDark ? 'text-faq-question-dark' : 'text-faq-question-light');
const answerColor = classes?.answer ?? (isDark ? 'text-faq-answer-dark' : 'text-faq-answer-light');
const toggleBase = isDark ? 'border-faq-toggle-dark text-faq-toggle-dark' : 'border-faq-toggle-light text-faq-toggle-light';
const toggleActive = 'group-open:border-accent group-open:text-accent';
---

<WidgetWrapper id={id} isDark={isDark} containerClass={`max-w-container mx-auto ${classes?.container ?? ''}`} bg={bg}>
  <Headline title={title} subtitle={subtitle} tagline={tagline} isDark={isDark} classes={classes?.headline} />

  {
    items.length > 0 && (
      <div class="intersect-once intersect-quarter motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        {items.map(({ title: itemTitle, description }, index) => (
          <details class:list={['group py-1', index > 0 && `border-t ${itemBorder}`]} name="faq-accordion">
            <summary class="flex items-center justify-between gap-4 cursor-pointer py-4 list-none select-none">
              <span class={`text-[16px] md:text-[18px] font-sans font-medium leading-snug pr-4 ${questionColor}`}>
                {itemTitle}
              </span>
              <span class={`flex-shrink-0 w-6 h-6 flex items-center justify-center rounded-full border transition-colors duration-200 ${toggleBase} ${toggleActive}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 transition-transform duration-300 group-open:rotate-45" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <div class="pb-5 pr-10">
              <p class={`text-[15px] md:text-[16px] font-normal leading-[160%] ${answerColor}`} set:html={description} />
            </div>
          </details>
        ))}
      </div>
    )
  }
</WidgetWrapper>

<style>
  details > summary::-webkit-details-marker {
    display: none;
  }
</style>
