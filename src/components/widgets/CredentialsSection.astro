---
/**
 * Medical Credentials / Journey section.
 *
 * Layout (Figma 121:1861):
 *   bg-cta (tan), rounded-tl/tr-[64px], p-[120px], flex row gap-[32px]
 *   Left col (704px):
 *     Header: eyebrow + h2
 *     Two credential cards: Education + Board Certification
 *       Card variant="pillar" with iconBg (same 36px mobile / 50px desktop tile
 *       as homepage Bucket #1 cards)
 *   Right col (510px, self-stretch):
 *     Single tall residencies card with timeline entries
 */

import Card from '~/components/ui/Card.astro';

interface Props {
  id?: string;
}

const { id } = Astro.props;

/* ── icon SVGs — size is set by Card iconBg (14px mobile / 20px desktop) ── */
const schoolIconSvg = `<svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M11 2L2 7l9 5 9-5-9-5zm0 0v10M2 12v5l9 5 9-5v-5" stroke="#2C4A5B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const ribbonIconSvg = `<svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><circle cx="11" cy="8" r="6" stroke="#2C4A5B" stroke-width="1.5"/><path d="M7.5 13.5L6 21l5-3 5 3-1.5-7.5" stroke="#2C4A5B" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const medkitIconSvg = `<svg viewBox="0 0 22 22" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><rect x="2" y="7" width="18" height="13" rx="2" stroke="#2C4A5B" stroke-width="1.5"/><path d="M8 7V5a3 3 0 016 0v2M11 11v4M9 13h4" stroke="#2C4A5B" stroke-width="1.5" stroke-linecap="round"/></svg>`;

const residencies = [
  {
    title: 'Plastic Surgery Residency',
    institution: 'Baylor College of Medicine, Texas Medical Center',
  },
  {
    title: 'General Surgery',
    institution: 'University of Hawaii Integrated Surgery Residency Program',
  },
  {
    title: 'Fellowship, Microsurgical Hand Surgery',
    institution: "9th People's Hospital, Shanghai",
  },
  {
    title: 'Fellowship, Pediatric Reconstructive Surgery',
    institution: 'Showa University, Tokyo',
  },
  {
    title: 'Fellowship, Microsurgery & Rehabilitation Surgery',
    institution: 'Baylor College of Medicine',
  },
];
---

<section
  class="not-prose w-full bg-page"
  {...id ? { id } : {}}
>
  <div class="bg-cta rounded-tl-[64px] rounded-tr-[64px]">
    <div class="mx-auto flex max-w-container flex-col gap-8 px-5 py-10 sm:px-8 sm:py-12 md:flex-row md:items-start md:gap-8 md:px-16 md:py-16 lg:gap-[32px] lg:px-[120px] lg:py-[120px]">

      {/* ── Left column: heading + credential cards ── */}
      <div class="flex w-full flex-col gap-10 md:max-w-[704px] lg:gap-[64px]">

        {/* Section header */}
        <div class="flex flex-col gap-4">
          <p class="font-sans text-eyebrow uppercase tracking-[0.06em] text-eyebrow">Medical Credentials</p>
          <h2 class="font-heading text-h2 font-normal leading-none text-heading">
            Four decades of surgical and scientific training.
          </h2>
        </div>

        {/* Credential cards — Card variant="pillar" so icon tiles match homepage */}
        <div class="flex flex-col gap-3">

          <Card variant="pillar" label="Education" iconBg={true}>
            <Fragment slot="icon" set:html={schoolIconSvg} />
            <p class="font-heading text-h4 font-normal leading-[1.2] text-primary">
              MD — Harvard Medical School, 1982
            </p>
          </Card>

          <Card variant="pillar" label="Board Certification & Licensure" iconBg={true}>
            <Fragment slot="icon" set:html={ribbonIconSvg} />
            <ul class="list-disc space-y-1 pl-5 font-heading text-h4 font-normal leading-[1.2] text-primary">
              <li>Diplomate, American Board of Plastic Surgery (1993)</li>
              <li>Diplomate, National Board of Medical Examiners</li>
              <li>Licensed physician, State of Hawaii</li>
            </ul>
          </Card>

        </div>
      </div>

      {/* ── Right column: residencies timeline card ── */}
      <div class="flex w-full md:flex-1 md:self-stretch lg:w-[510px] lg:flex-none">
        <Card variant="pillar" label="Residencies & Fellowships" iconBg={true} class="h-full w-full">
          <Fragment slot="icon" set:html={medkitIconSvg} />
          <div class="flex flex-col">
            {residencies.map((item, i) => (
              <div class="flex gap-4">
                <div class="relative flex w-[18px] shrink-0 flex-col items-center">
                  <div class="mt-[6px] size-[8px] shrink-0 rounded-full bg-accent"></div>
                  {i < residencies.length - 1 && (
                    <div class="mt-1 flex-1 border-l-2 border-dashed border-accent/30"></div>
                  )}
                </div>
                <div class:list={['flex flex-col gap-[4px] pb-4', i === residencies.length - 1 && 'pb-0']}>
                  <p class="font-heading text-[22px] font-normal leading-[1.2] text-primary">
                    {item.title}
                  </p>
                  <p class="font-sans text-body leading-[1.3] text-muted opacity-60">
                    {item.institution}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </Card>
      </div>

    </div>
  </div>
</section>
