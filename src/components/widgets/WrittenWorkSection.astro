---
/**
 * WrittenWorkSection — 2-column written work section (Figma node 2:1375).
 *
 * Visual spec:
 *   bg-page full-width section, p-[120px] outer, gap-[32px] between columns.
 *
 *   LEFT column  (flex-1) — top header (eyebrow + h2) + stacked feature cards
 *     Each card: Card variant="feature" (compact, ghost CTA, no image).
 *
 *   RIGHT column (flex-1, self-stretch) — ONE tall featured Card
 *     Card variant="feature" featured={true} — grey image placeholder + solid CTA.
 *
 * Data shape:
 *   cards           — FeatureCardItem[]  (left column stacked cards, compact layout)
 *   featuredCard    — FeatureCardItem    (right column tall card)
 *
 * FeatureCardItem:
 *   iconType?   — 'calendar' | 'book' (default: 'book')
 *   label?      — category eyebrow (e.g. "NEXT SESSION", "BOOKS")
 *   title       — Fraunces 28px heading
 *   description — body text
 *   ctaText?    — CTA label (default: "Explore")
 *   ctaHref?    — CTA link
 *
 * Usage:
 *   <WrittenWorkSection
 *     eyebrow="The written work"
 *     heading="Seven ways to understand what's actually happening."
 *     cards={[
 *       { iconType: 'calendar', label: 'Next Session', title: '…', description: '…', ctaHref: '/sessions' },
 *       { iconType: 'book',     label: 'Books',       title: '…', description: '…', ctaHref: '/books' },
 *     ]}
 *     featuredCard={{ iconType: 'book', label: 'Books', title: '…', description: '…', ctaHref: '/books' }}
 *   />
 */

import Card from '~/components/ui/Card.astro';
import Heading from '~/components/ui/Heading.astro';

export interface FeatureCardItem {
  iconType?: 'calendar' | 'book';
  label?: string;
  title: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  cards?: FeatureCardItem[];
  featuredCard?: FeatureCardItem;
  id?: string;
}

const { eyebrow, heading, cards = [], featuredCard, id } = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full py-12 md:py-16 lg:py-[120px]"
>
<div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">
  <div class="flex flex-col gap-8 lg:flex-row lg:items-start lg:gap-8">

    {/* ── LEFT: header + stacked compact cards ── */}
    <div class="flex min-w-0 flex-1 flex-col gap-12">

      {/* Header */}
      <div class="flex flex-col gap-4">
        {eyebrow && (
          <Heading variant="eyebrow">{eyebrow}</Heading>
        )}
        <Heading variant="h2">{heading}</Heading>
      </div>

      {/* Compact feature cards */}
      {cards.length > 0 && (
        <div class="flex flex-col gap-6">
          {cards.map((card) => (
            <Card
              variant="feature"
              iconType={card.iconType}
              label={card.label}
              title={card.title}
              description={card.description}
              ctaText={card.ctaText}
              ctaHref={card.ctaHref}
              featured={false}
            />
          ))}
        </div>
      )}

    </div>

    {/* ── RIGHT: tall featured card ── */}
    {featuredCard && (
      <div class="min-w-0 flex-1 self-stretch">
        <Card
          variant="feature"
          iconType={featuredCard.iconType}
          label={featuredCard.label}
          title={featuredCard.title}
          description={featuredCard.description}
          ctaText={featuredCard.ctaText}
          ctaHref={featuredCard.ctaHref}
          featured={true}
          class="h-full"
        />
      </div>
    )}

  </div>
</div>
</section>
