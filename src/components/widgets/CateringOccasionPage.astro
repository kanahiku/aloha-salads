---
/**
 * CateringOccasionPage — the whole body of a catering sub-page (corporate, meetings, events, …).
 *
 * Hero → numbered occasion cards → "More catering options" → FAQs → CTA banner.
 * All seven catering sub-pages use this one widget; copy comes from the matching Sanity document
 * (Catering → <page>). Do not fork per page.
 */
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF } from '~/config/cta';
import peach from '~/assets/images/peach-motif.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';
import { textToHtml } from '~/lib/content/richText';
import type { CateringSharedContent, CateringSubpageContent } from '~/lib/content/types';

export interface Props {
  page: CateringSubpageContent;
  /** Every sub-page, used for the "More catering options" list. */
  subpages: CateringSubpageContent[];
  shared: CateringSharedContent;
}

const { page, subpages, shared } = Astro.props;
const href = `/catering/${page.slug}`;
---

{/* ── 1. Hero ───────────────────────────────────────────── */}
<Hero2
  variant="split-dark"
  overlapHeader={false}
  title={textToHtml(page.title)}
  content={textToHtml(page.heroContent)}
  image={page.heroImage}
  actions={[
    { variant: 'primary', text: shared.orderLabel, href: CATERING_CTA_HREF },
    { variant: 'ghost', tone: 'dark', text: shared.menuLabel, href: '/catering' },
  ]}
/>

{/* ── 2. Occasions — 2×2 editorial card grid ─── */}
<section class="not-prose relative w-full overflow-hidden bg-page" aria-label={`${page.title} occasions`}>
  {/* Motifs */}
  <img
    src={peach.src}
    alt=""
    aria-hidden="true"
    width={peach.width}
    height={peach.height}
    class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none"
    loading="lazy"
    decoding="async"
  />
  <img
    src={bigLeaf.src}
    alt=""
    aria-hidden="true"
    width={bigLeaf.width}
    height={bigLeaf.height}
    class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none"
    loading="lazy"
    decoding="async"
  />

  <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        page.occasions.map((occ, index) => {
          const number = String(index + 1).padStart(2, '0');
          return (
            <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
              {/* Large ghosted number — top-right decorative */}
              <span
                class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-page/[0.07] md:text-[120px]"
                aria-hidden="true"
              >
                {number}
              </span>

              <div class="relative flex flex-col gap-4">
                <span class="font-rough text-[15px] leading-none text-page/90">{number}</span>
                <Heading variant="h3" color="white">
                  {occ.title}
                </Heading>
                <Text color="white" class="text-page/75 leading-relaxed">
                  {occ.description}
                </Text>
              </div>

              {/* Bottom accent rule */}
              <div class="mt-8 h-px w-12 bg-accent" />
            </article>
          );
        })
      }
    </div>
  </div>
</section>

{/* ── 3. Other catering sub-pages ───────────────────────── */}
<CateringSubNav
  excludeHref={href}
  eyebrow={shared.subNavEyebrow}
  title={shared.subNavTitle}
  subtitle={shared.subNavSubtitle}
  options={subpages.map((sub) => ({ label: sub.title, href: `/catering/${sub.slug}` }))}
/>

{/* ── 4. FAQs ──────────────────────────────────────────── */}
{
  page.faqs.length > 0 && (
    <FAQs
      isDark={true}
      title={shared.faqTitle}
      items={page.faqs.map((faq) => ({ title: faq.question, description: textToHtml(faq.answer) }))}
    />
  )
}

{/* ── 5. Ready to order CTA ────────────────────────────── */}
<CTABanner title={shared.readyTitle} subtitle={page.ctaSubtitle} />
