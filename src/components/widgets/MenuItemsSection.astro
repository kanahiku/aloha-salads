---
/**
 * MenuItemsSection — restaurant menu list for location pages and category pages.
 * Stays a vertical list so 4 items and 20 items use the same rhythm.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import HeroImagePlaceholder from '~/components/ui/HeroImagePlaceholder.astro';
import peach from '~/assets/images/peach-motif.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';

export interface MenuItem {
  title: string;
  description?: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items?: MenuItem[];
  ctaText?: string;
  ctaHref?: string;
  id?: string;
}

const { eyebrow, title, intro, items = [], ctaText, ctaHref, id } = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full scroll-mt-24 overflow-hidden bg-page md:scroll-mt-32"
>
  <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
    <img
      src={peach.src}
      alt=""
      width={peach.width}
      height={peach.height}
      class="absolute right-0 top-[-6%] w-[38%] max-w-[560px] select-none"
      loading="lazy"
      decoding="async"
    />
    <img
      src={bigLeaf.src}
      alt=""
      width={bigLeaf.width}
      height={bigLeaf.height}
      class="absolute bottom-0 left-[-20px] z-0 w-[33%] max-w-[480px] select-none"
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
    <div class="mb-10 flex max-w-4xl flex-col gap-6 md:mb-14">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      <Heading variant="h2">{title}</Heading>
      {intro && <Text variant="body-lg" color="default">{intro}</Text>}
    </div>

    {items.length > 0 && (
      <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
        {items.map((item) => (
          <article class="flex h-full flex-col overflow-hidden bg-card shadow-card">
            <div class="relative w-full bg-section-grey" style="aspect-ratio: 4 / 3;">
              <!-- TODO: replace with <Image> when asset is ready -->
              <HeroImagePlaceholder fill class="absolute inset-0" label={`${item.title} menu item placeholder`} />
            </div>
            <div class="flex flex-1 flex-col gap-3 px-5 py-5">
              <h3 class="font-rough text-h4 font-normal leading-none text-heading">{item.title}</h3>
              {item.description && (
                <p class="font-sans text-body leading-[1.45] tracking-[-0.01em] text-muted">
                  {item.description}
                </p>
              )}
            </div>
          </article>
        ))}
      </div>
    )}

    {ctaText && ctaHref && (
      <div class="mt-10 md:mt-16">
        <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />
      </div>
    )}
  </div>
</section>
