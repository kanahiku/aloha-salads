---
/**
 * MenuItemsSection — restaurant menu list for location pages and category pages.
 * Stays a vertical list so 4 items and 20 items use the same rhythm.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';

export interface MenuItem {
  title: string;
  description?: string;
}

export interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  items?: MenuItem[];
  ctaText?: string;
  ctaHref?: string;
  id?: string;
}

const { eyebrow, title, intro, items = [], ctaText, ctaHref, id } = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full bg-cta"
>
  <div class="mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
    <div class="mb-12 flex max-w-4xl flex-col gap-6 md:mb-16">
      {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
      <Heading variant="h2">{title}</Heading>
      {intro && <Text variant="body-lg" color="default">{intro}</Text>}
    </div>

    {items.length > 0 && (
      <ol class="flex list-none flex-col">
        {items.map((item, index) => {
          const n = String(index + 1).padStart(2, '0');

          return (
            <li class="relative overflow-hidden border-t border-heading/15 last:border-b">
              <span
                class="pointer-events-none absolute left-3 top-1/2 hidden -translate-y-1/2 select-none font-script text-h1 text-heading/10 md:block"
                aria-hidden="true"
              >
                {n}
              </span>

              <div class="relative grid grid-cols-[3.25rem_minmax(0,1fr)] items-start gap-x-4 gap-y-3 px-4 py-8 md:grid-cols-[5.5rem_minmax(0,1fr)] md:px-10 md:py-10 lg:grid-cols-[5.5rem_minmax(0,1fr)_minmax(14rem,26rem)] lg:gap-x-10">
                <span class="type-quote pt-1 text-accent" aria-hidden="true">
                  {n}
                </span>

                <Heading variant="h3">{item.title}</Heading>

                {item.description && (
                  <Text
                    as="p"
                    variant="body-lg"
                    color="inherit"
                    class="col-start-2 max-w-prose text-heading/60 lg:col-start-3 lg:pt-1"
                  >
                    {item.description}
                  </Text>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    )}

    {ctaText && ctaHref && (
      <div class="mt-10 md:mt-16">
        <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} />
      </div>
    )}
  </div>
</section>
