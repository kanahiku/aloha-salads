---
/**
 * BookSeriesFeature — dark-gradient section featuring one book from a series.
 * Reused for both Textbook Series (node 121:246) and Bargaining with Aging (node 121:532).
 *
 * Layout:
 *   Full-width dark navy→primary gradient section.
 *   Header row: eyebrow + h2 (left) | description (right).
 *   Glass card: book info + tags + buy buttons (left) | cover placeholder (right).
 *
 * Props:
 *   eyebrow         — small uppercase "Series" label
 *   heading         — h2 section title (e.g. "Textbook Series")
 *   description     — subtitle on the right of the header row
 *   book            — featured book data (subtitle, title, description, tags, buyButtons, publisherNote)
 *   roundedBottom   — add rounded-b-hero (for Bargaining with Aging section)
 *   id              — section anchor
 */
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';
import { Icon } from 'astro-icon/components';

export interface BuyButton {
  label: string;
  href?: string;
}

export interface BookFeatureItem {
  slug?: string;
  subtitle?: string;
  title: string;
  description: string;
  image?: { src: string; alt: string };
  tags?: string[];
  buyButtons?: BuyButton[];
  publisherNote?: string;
  podcastHref?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  book?: BookFeatureItem;
  roundedBottom?: boolean;
  id?: string;
}

const {
  eyebrow = 'Series',
  heading,
  description,
  book,
  roundedBottom = false,
  id,
} = Astro.props;
---

<section
  {...id ? { id } : {}}
  class:list={[
    'not-prose w-full',
    roundedBottom && 'rounded-b-hero',
  ]}
  style="background: linear-gradient(94deg, var(--aw-color-bg-section-dark) 5%, var(--aw-color-primary) 97%)"
>
  <div class="mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-10 sm:px-8 md:gap-12 md:px-16 md:py-[64px] lg:px-[120px]">
  <!-- Header row: eyebrow+h2 (left) | description (right) -->
  <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 md:gap-8">
    <div class="flex flex-col gap-4 shrink-0">
      {eyebrow && (
        <Heading variant="eyebrow" color="white" class="opacity-60">{eyebrow}</Heading>
      )}
      <Heading variant="h2" color="white">{heading}</Heading>
    </div>
    {description && (
      <p class="font-sans text-body text-white/70 max-w-md md:text-right md:self-center">{description}</p>
    )}
  </div>

  <!-- Feature card -->
  {book && (
    <div
      {...book.slug ? { id: `book-${book.slug}` } : {}}
      class="w-full rounded-[32px] border border-white/10 p-6 md:p-12 flex flex-col md:flex-row items-start justify-between gap-8 scroll-mt-28"
      style="background: linear-gradient(to top, transparent, rgba(210,225,234,0.05))"
    >
      <!-- Left: book info -->
      <div class="flex flex-col gap-10 md:gap-12 shrink-0 md:max-w-[604px]">
        <div class="flex flex-col gap-4">
          {book.subtitle && (
            <p class="font-sans type-eyebrow text-eyebrow">{book.subtitle}</p>
          )}
          <Heading variant="h3" color="white">{book.title}</Heading>
          <p class="font-sans text-body text-white/60 whitespace-pre-wrap">{book.description}</p>
        </div>

        {book.tags && book.tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {book.tags.map((tag) => (
              <span class="bg-primary/20 border border-white/20 font-sans text-[11px] tracking-[0.04em] uppercase text-white/90 rounded-full px-3 py-1">
                {tag}
              </span>
            ))}
          </div>
        )}

        {book.buyButtons && book.buyButtons.length > 0 && (
          <div class="flex flex-col gap-3">
            {book.publisherNote && (
              <p class="font-sans type-eyebrow text-[11px] tracking-[0.06em] uppercase text-eyebrow">{book.publisherNote}</p>
            )}
            <div class="flex flex-wrap gap-3">
              {book.buyButtons.map((btn) => (
                <Button
                  variant="ghost"
                  tone="dark"
                  text={btn.label}
                  href={btn.href ?? '#'}
                  hideNote={true}
                  class="whitespace-nowrap"
                />
              ))}
            </div>
            {book.podcastHref && (
              <a
                href={book.podcastHref}
                class="btn-link gap-1.5 self-start"
              >
                <Icon name="tabler:headphones" class="w-4 h-4 shrink-0" />
                <span>Listen to the matching podcast episode</span>
              </a>
            )}
          </div>
        )}
      </div>

      {book.image?.src ? (
        <Image
          src={book.image.src}
          alt={book.image.alt || book.title}
          class="rounded-[16px] shrink-0 w-full md:w-[343px] object-cover"
          width={343}
          height={512}
          layout="none"
          widths={[343, 686]}
          sizes="(max-width: 768px) 100vw, 343px"
        />
      ) : (
        <div
          class="rounded-[16px] bg-section-grey shrink-0 w-full md:w-[343px]"
          style="aspect-ratio: 343 / 512;"
          aria-hidden="true"
        />
      )}
    </div>
  )}
  </div>
</section>
