---
/**
 * PodcastFilter — centered roadmap intro + filter pills that scroll
 * to the matching PodcastEpisodes section.
 * Figma node 121:1169.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';

export interface FilterTab {
  label: string;
  id: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  tabs: FilterTab[];
  id?: string;
  spotifyUrl?: string;
  youtubeUrl?: string;
}

const { eyebrow, heading, description, tabs = [], id, spotifyUrl, youtubeUrl } = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full"
>
  <div class="mx-auto flex w-full max-w-container flex-col items-center gap-8 px-5 py-10 sm:px-8 md:gap-16 md:px-16 md:py-16 lg:px-[120px]">
    <div class="flex w-full flex-col items-center gap-8 text-center">
      <div class="flex max-w-[806px] flex-col items-center gap-4">
        {eyebrow && (
          <Heading variant="eyebrow">{eyebrow}</Heading>
        )}
        <Heading variant="h2">{heading}</Heading>
      </div>
      {description && (
        <Text class="max-w-[718px]">{description}</Text>
      )}

      {/* Global platform links */}
      {(spotifyUrl || youtubeUrl) && (
        <div class="flex flex-wrap items-center justify-center gap-4">
          {spotifyUrl && (
            <a
              href={spotifyUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[#1DB954] px-5 py-2.5 font-sans text-[13px] font-semibold text-white transition-opacity hover:opacity-80"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0" aria-hidden="true">
                <path d="M12 2C6.477 2 2 6.477 2 12s4.477 10 10 10 10-4.477 10-10S17.523 2 12 2zm4.586 14.424a.623.623 0 01-.857.207c-2.348-1.435-5.304-1.76-8.785-.964a.623.623 0 11-.277-1.215c3.809-.87 7.076-.496 9.712 1.115a.622.622 0 01.207.857zm1.223-2.722a.78.78 0 01-1.072.257c-2.687-1.652-6.785-2.131-9.965-1.166a.78.78 0 01-.973-.518.781.781 0 01.518-.973c3.632-1.102 8.147-.568 11.234 1.328a.78.78 0 01.258 1.072zm.105-2.835C14.692 8.95 9.375 8.775 6.297 9.71a.937.937 0 11-.543-1.794c3.548-1.076 9.45-.868 13.18 1.336a.937.937 0 01-.32 1.615z"/>
              </svg>
              Listen on Spotify
            </a>
          )}
          {youtubeUrl && (
            <a
              href={youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-full bg-[#FF0000] px-5 py-2.5 font-sans text-[13px] font-semibold text-white transition-opacity hover:opacity-80"
            >
              <svg viewBox="0 0 24 24" fill="currentColor" class="size-4 shrink-0" aria-hidden="true">
                <path d="M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              Watch on YouTube
            </a>
          )}
        </div>
      )}
    </div>

    <div
      class="flex max-w-[933px] flex-wrap items-center justify-center gap-3"
      role="tablist"
      aria-label="Filter episodes by system"
    >
      {tabs.map((tab, i) => (
        <button
          role="tab"
          aria-selected={i === 0 ? 'true' : 'false'}
          data-filter={tab.id}
          class:list={[
            'podcast-filter-tab cursor-pointer rounded-xl border px-6 py-3.5 font-sans font-semibold text-[14px] leading-none tracking-[0.01em] whitespace-nowrap transition-colors',
            i === 0
              ? 'border-accent bg-accent text-white'
              : 'border-primary bg-transparent text-primary hover:bg-accent hover:text-white hover:border-accent',
          ]}
        >
          {tab.label}
        </button>
      ))}
    </div>
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('.podcast-filter-tab');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      // Update active styles
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', 'false');
        t.classList.remove('bg-accent', 'text-white', 'border-accent');
        t.classList.add('bg-transparent', 'text-primary', 'border-primary', 'hover:bg-accent', 'hover:text-white', 'hover:border-accent');
      });
      tab.setAttribute('aria-selected', 'true');
      tab.classList.add('bg-accent', 'text-white', 'border-accent');
      tab.classList.remove('bg-transparent', 'text-primary', 'border-primary', 'hover:bg-accent', 'hover:text-white', 'hover:border-accent');

      // Scroll to the matching section
      const sectionId = tab.dataset.filter;
      if (sectionId) {
        const target = document.getElementById(sectionId);
        if (target) {
          target.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }
      }
    });
  });
</script>
