---
import { Icon } from 'astro-icon/components';
import Logo from '~/components/Logo.astro';
import ToggleTheme from '~/components/common/ToggleTheme.astro';
import ToggleMenu from '~/components/common/ToggleMenu.astro';
import Button from '~/components/ui/Button.astro';

import { getHomePermalink } from '~/utils/permalinks';
import { trimSlash, getAsset } from '~/utils/permalinks';
import type { CallToAction } from '~/types';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface MenuLink extends Link {
  links?: Array<MenuLink>;
  columns?: Array<{ title: string; links: Array<MenuLink> }>;
}

export interface Props {
  id?: string;
  links?: Array<MenuLink>;
  actions?: Array<CallToAction>;
  phone?: { text: string; href: string };
  isSticky?: boolean;
  isDark?: boolean;
  isFullWidth?: boolean;
  showToggleTheme?: boolean;
  showRssFeed?: boolean;
  position?: string;
  /** Render only the glass nav bar, for use inside an overlay hero. */
  embedded?: boolean;
}

const {
  id = 'header',
  links = [],
  actions = [],
  phone,
  isSticky = false,
  isDark = false,
  isFullWidth = false,
  showToggleTheme = false,
  showRssFeed = false,
  position = 'center',
  embedded = false,
} = Astro.props;

const extraActions = (actions ?? []).filter(
  (action) => action.href !== phone?.href && !String(action.href ?? '').startsWith('tel:')
);
const phoneAction = phone
  ? { variant: 'primary' as const, text: phone.text, href: phone.href, icon: 'tabler:phone' }
  : undefined;
const phoneLabel = phone ? `Call ${phone.text}` : '';
const phoneBoxClass =
  'inline-flex items-center justify-center shrink-0 size-9 rounded-md bg-accent text-black border-2 border-accent hover:bg-accent-hover hover:border-accent-hover transition duration-200';

const currentPath = `/${trimSlash(new URL(Astro.url).pathname)}`;

const mobileLinkClass =
  'flex items-center rounded-[12px] px-3 py-3 font-sans text-[16px] font-medium leading-none text-white/90 transition-colors hover:bg-white/10 hover:text-white';
const mobilePanelClass =
  'absolute inset-x-0 top-[calc(100%+8px)] z-50 max-h-[min(24rem,calc(100dvh-5.5rem))] flex-col overflow-y-auto rounded-[var(--aw-radius-xl)] border border-white/10 bg-section-dark p-3 shadow-[4px_4px_30px_rgba(0,0,0,0.18)] backdrop-blur-xl';
---

<aw-header transition:persist={embedded ? 'hero-nav' : 'header'}>
  {
    embedded ? (
      <header class="relative z-40 w-full" data-nav="embedded" {...id ? { id } : {}}>
        <div class="flex h-14 w-full items-center justify-between box-border rounded-[var(--aw-radius-lg)] bg-nav-glass py-2 pl-4 pr-2 backdrop-blur-[15px] md:h-[77px] md:py-3 md:pl-6 md:pr-3">
          <div class="flex shrink-0 items-center justify-between w-full md:w-auto">
            <a class="flex items-center shrink-0" href={getHomePermalink()}>
              <Logo class="h-5 w-auto max-w-none mix-blend-soft-light md:h-[31px] md:w-[43px]" />
            </a>
            <ToggleMenu class="flex size-10 flex-col items-center justify-center rounded-lg bg-white/10 cursor-pointer group md:hidden" />
          </div>
          <nav class="hidden md:flex items-center shrink-0 w-full md:w-auto" data-desktop-nav aria-label="Main navigation">
            <ul class="flex flex-col md:flex-row md:items-center gap-6 font-sans font-medium text-[16px] leading-normal text-white">
              {links.map(({ text, href }) => (
                <li class="shrink-0">
                  <a
                    class:list={[
                      'whitespace-nowrap text-white hover:text-white/80',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {extraActions.length > 0 && (
            <div class="hidden md:flex items-center shrink-0">
              {extraActions.map((btnProps) => (
                <Button {...btnProps} hideNote class="whitespace-nowrap" />
              ))}
            </div>
          )}
        </div>

        <div class={mobilePanelClass} data-mobile-panel>
          <nav aria-label="Mobile navigation">
            <ul class="flex flex-col">
              {links.map(({ text, href }) => (
                <li>
                  <a class:list={[mobileLinkClass, { 'aw-link-active': href === currentPath }]} href={href}>
                    {text}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          {extraActions.length > 0 && (
            <div class="mt-2 flex flex-col gap-2 border-t border-white/10 pt-3">
              {extraActions.map((btnProps) => (
                <Button {...btnProps} hideNote class="w-full justify-center" />
              ))}
            </div>
          )}
        </div>
      </header>
    ) : (
  <header
    class:list={[
      { sticky: isSticky, relative: !isSticky, dark: isDark },
      'top-0 z-40 flex-none mx-auto w-full border-b border-gray-50/0 transition-[opacity] ease-in-out',
    ]}
    {...isSticky ? { 'data-aw-sticky-header': true } : {}}
    {...id ? { id } : {}}
  >
    <div class="absolute inset-0 bg-section-dark"></div>
    <div
      class:list={[
        'relative text-white py-2 px-3 md:py-3 md:px-6 mx-auto w-full flex items-center justify-between',
        {
          'max-w-container': !isFullWidth,
        },
      ]}
    >
      <div class="flex items-center justify-between w-full md:w-auto">
        <a class="flex items-center min-w-0" href={getHomePermalink()}>
          <Logo class="h-5 max-w-[140px] md:h-9 md:max-w-[240px]" />
        </a>
        <div class="flex items-center gap-2 md:hidden">
          {
            phone && (
              <a href={phone.href} class={phoneBoxClass} aria-label={phoneLabel}>
                <Icon name="tabler:phone" class="size-4" aria-hidden="true" />
              </a>
            )
          }
          <ToggleMenu class="flex size-10 flex-col items-center justify-center rounded-lg bg-white/10 cursor-pointer group" />
        </div>
      </div>
      <nav
        class="items-center w-full md:w-auto hidden md:flex md:ml-auto text-default overflow-y-auto overflow-x-hidden md:overflow-visible"
        data-desktop-nav
        aria-label="Main navigation"
      >
        <ul class="flex flex-col md:flex-row md:self-center w-full md:w-auto text-xl md:text-[15px] tracking-[0.01rem] font-medium md:justify-center">
          {
            links.map(({ text, href, links: childLinks, columns }) => {
              const isDropdown = Boolean(childLinks?.length || columns?.length);
              return (
              <li class:list={[{ dropdown: isDropdown, mega: Boolean(columns?.length), 'md:relative': isDropdown }]}>
                {isDropdown ? (
                  <>
                    <div class="flex items-center">
                    {href ? (
                    <a
                      href={href}
                      class:list={[
                        'text-white/80 hover:text-white px-[8px] py-3 flex items-center flex-1 min-w-0 whitespace-nowrap',
                        { 'aw-link-active': href === currentPath },
                      ]}
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline transition-transform duration-200"
                      />
                    </a>
                    ) : (
                    <button
                      type="button"
                      data-aw-toggle-dropdown
                      aria-expanded="false"
                      class="text-white/80 hover:text-white px-[8px] py-3 flex items-center flex-1 min-w-0 whitespace-nowrap select-none text-left"
                    >
                      {text}{' '}
                      <Icon
                        name="tabler:chevron-down"
                        class="w-3.5 h-3.5 ml-0.5 rtl:ml-0 rtl:mr-0.5 hidden md:inline transition-transform duration-200"
                      />
                    </button>
                    )}
                    <button
                      type="button"
                      data-aw-toggle-dropdown
                      aria-expanded="false"
                      aria-label={`Toggle ${text} submenu`}
                      class="md:hidden shrink-0 p-3 text-white/80 hover:text-white"
                    >
                      <Icon name="tabler:chevron-down" class="w-5 h-5 transition-transform duration-200" />
                    </button>
                    </div>
                    {columns?.length ? (
                    <div class="dropdown-menu mega-menu hidden md:backdrop-blur-md rounded md:absolute md:top-full md:left-1/2 md:-mt-1 pl-4 md:pl-0 font-medium md:bg-card-dark md:w-[900px] md:max-w-[calc(100vw-2rem)] md:z-50 drop-shadow-xl">
                      <div class="mega-menu-columns flex flex-col md:grid md:gap-8 md:p-5" style={`--mega-columns: ${columns.length}`}>
                        {columns.map((col) => (
                          <div class="min-w-0">
                            <p class="text-[11px] font-semibold uppercase tracking-[0.08em] text-accent px-5 md:px-2 pt-3 md:pt-0 pb-1">
                              {col.title}
                            </p>
                            <ul>
                              {col.links.map(({ text: text2, href: href2 }) => (
                                <li>
                                  <a
                                    class:list={[
                                      'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 md:px-2 block whitespace-normal break-words',
                                      { 'aw-link-active': href2 === currentPath },
                                    ]}
                                    href={href2}
                                  >
                                    {text2}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          </div>
                        ))}
                      </div>
                    </div>
                    ) : (
                    <ul class="dropdown-menu hidden md:backdrop-blur-md rounded md:absolute pl-4 md:pl-0 font-medium md:bg-card-dark md:min-w-[200px] drop-shadow-xl">
                      {childLinks?.map(({ text: text2, href: href2, links: links2 }) => (
                        <li class:list={[{ 'relative group/nested': links2?.length }]}>
                          <a
                            class:list={[
                              'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 block whitespace-normal break-words md:whitespace-nowrap',
                              { 'aw-link-active': href2 === currentPath },
                              { 'flex items-center justify-between': links2?.length },
                            ]}
                            href={href2}
                          >
                            {text2}
                            {links2?.length && (
                              <Icon
                                name="tabler:chevron-right"
                                class="w-3.5 h-3.5 ml-2 hidden md:inline"
                              />
                            )}
                          </a>
                          {links2?.length && (
                            <ul class="hidden md:absolute md:left-full md:top-0 group-hover/nested:md:block pl-4 md:pl-0 md:backdrop-blur-md rounded font-medium md:bg-card-dark md:min-w-[200px] drop-shadow-xl">
                              {links2.map(({ text: text3, href: href3 }) => (
                                <li>
                                  <a
                                    class:list={[
                                      'first:rounded-t last:rounded-b hover:bg-accent/[0.12] hover:text-white text-white/80 py-2 px-5 block whitespace-normal break-words md:whitespace-nowrap',
                                      { 'aw-link-active': href3 === currentPath },
                                    ]}
                                    href={href3}
                                  >
                                    {text3}
                                  </a>
                                </li>
                              ))}
                            </ul>
                          )}
                        </li>
                      ))}
                    </ul>
                    )}
                  </>
                ) : (
                  <a
                    class:list={[
                      embedded
                        ? 'text-white hover:text-white/80 px-0 py-3 flex items-center whitespace-nowrap'
                        : 'text-white/80 hover:text-white px-[8px] py-3 flex items-center whitespace-nowrap',
                      { 'aw-link-active': href === currentPath },
                    ]}
                    href={href}
                  >
                    {text}
                  </a>
                )}
              </li>
              );
            })
          }
        </ul>
      </nav>
      <div
        class:list={[
          'hidden md:self-center md:flex items-center md:mb-0 md:static justify-end',
          embedded ? 'shrink-0 p-0' : 'fixed w-full md:w-auto left-0 rtl:left-auto rtl:right-0 bottom-0 p-3 md:p-0',
        ]}
      >
        <div class="items-center flex justify-between w-full md:w-auto">
          <div class="flex">
            {showToggleTheme && <ToggleTheme iconClass="w-6 h-6 md:w-5 md:h-5 md:inline-block" />}
            {
              showRssFeed && (
                <a
                  class="text-muted dark:text-gray-400 focus:outline-none focus:ring-4 focus:ring-gray-200 dark:focus:ring-gray-700 rounded-lg text-sm p-2.5 inline-flex items-center"
                  aria-label="RSS Feed"
                  href={getAsset('/rss.xml')}
                >
                  <Icon name="tabler:rss" class="w-5 h-5" />
                </a>
              )
            }
          </div>
          {
            (phoneAction || extraActions.length) && (
              <span class:list={['flex items-center', !embedded && 'ml-4 rtl:ml-0 rtl:mr-4']}>
                {phoneAction && (
                  <Button
                    {...phoneAction}
                    hideNote
                    class="ml-2 shadow-none w-auto whitespace-nowrap"
                  />
                )}
                {extraActions.map((btnProps) => (
                  <Button
                    {...btnProps}
                    hideNote
                    class="ml-2 shadow-none w-auto whitespace-nowrap"
                  />
                ))}
              </span>
            )
          }
        </div>
      </div>
    </div>

    <div class:list={[mobilePanelClass, 'mx-3']} data-mobile-panel>
      <nav aria-label="Mobile navigation">
        <ul class="flex flex-col">
          {
            links.map(({ text, href, links: childLinks, columns }) => {
              const isDropdown = Boolean(childLinks?.length || columns?.length);
              const nested = columns?.length
                ? columns.flatMap((col) => col.links)
                : (childLinks ?? []);
              return (
                <li>
                  {isDropdown ? (
                    <details>
                      <summary class:list={[mobileLinkClass, 'cursor-pointer list-none']}>{text}</summary>
                      <ul class="mb-1 ml-2 flex flex-col border-l border-white/10 pl-2">
                        {nested.map(({ text: nestedText, href: nestedHref }) => (
                          <li>
                            <a
                              class:list={[mobileLinkClass, 'py-2.5 text-[15px]', { 'aw-link-active': nestedHref === currentPath }]}
                              href={nestedHref}
                            >
                              {nestedText}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : (
                    <a class:list={[mobileLinkClass, { 'aw-link-active': href === currentPath }]} href={href}>
                      {text}
                    </a>
                  )}
                </li>
              );
            })
          }
        </ul>
      </nav>
      {(phoneAction || extraActions.length > 0) && (
        <div class="mt-2 flex flex-col gap-2 border-t border-white/10 pt-3">
          {phoneAction && <Button {...phoneAction} hideNote class="w-full justify-center" />}
          {extraActions.map((btnProps) => (
            <Button {...btnProps} hideNote class="w-full justify-center" />
          ))}
        </div>
      )}
    </div>
  </header>
    )
  }
</aw-header>

<style>
  aw-header {
    display: contents;
  }

  [data-mobile-panel] {
    display: none;
  }

  @media (max-width: 767px) {
    #header.expanded [data-mobile-panel] {
      display: flex;
    }

    [data-aw-toggle-dropdown][aria-expanded='true'] :global(svg) {
      transform: rotate(180deg);
    }

    [data-mobile-panel] summary::-webkit-details-marker {
      display: none;
    }
  }

  @media (min-width: 768px) {
    .mega-menu-columns {
      grid-template-columns: repeat(var(--mega-columns), minmax(0, 1fr));
    }

    li.mega .mega-menu {
      transform: translateX(calc(-50% + var(--mega-shift, 0px)));
    }

    /* Desktop chevron follows hover / keyboard focus, never click-to-toggle. */
    li.dropdown:hover > div > a :global(svg),
    li.dropdown:hover > div > button :global(svg),
    li.dropdown:has(:focus-visible) > div > a :global(svg),
    li.dropdown:has(:focus-visible) > div > button :global(svg) {
      transform: rotate(180deg);
    }
  }
</style>

<script>
  class AwHeader extends HTMLElement {
    private onScroll?: () => void;
    private mql?: MediaQueryList;
    private onMqlChange?: () => void;
    private onResize?: () => void;
    private onPageLoad = () => {
      this.updateActiveLinks();
      this.closeOpenDropdown();
    };

    connectedCallback() {
      const header = this.querySelector<HTMLElement>('#header');
      const toggle = this.querySelector<HTMLElement>('[data-aw-toggle-menu]');
      const nav = this.querySelector<HTMLElement>('[data-desktop-nav]');
      const panel = this.querySelector<HTMLElement>('[data-mobile-panel]');

      // The header persists across view transitions (transition:persist), so
      // the server-rendered `aw-link-active` class would go stale. Re-compute it
      // on every navigation (astro:page-load fires on load and after each swap).
      this.updateActiveLinks();
      document.addEventListener('astro:page-load', this.onPageLoad);
      window.addEventListener('hashchange', this.onPageLoad);

      const setDropdownOpen = (li: HTMLElement, open: boolean) => {
        li.classList.toggle('expanded', open);
        li.querySelectorAll<HTMLElement>('[data-aw-toggle-dropdown]').forEach((btn) => {
          btn.setAttribute('aria-expanded', String(open));
        });
      };

      const collapseDropdowns = () => {
        nav?.querySelectorAll<HTMLElement>('li.dropdown.expanded').forEach((li) => setDropdownOpen(li, false));
      };

      const closeMenu = () => {
        toggle?.classList.remove('expanded');
        toggle?.setAttribute('aria-expanded', 'false');
        document.body.classList.remove('overflow-hidden');
        header?.classList.remove('expanded');
        collapseDropdowns();
      };

      // Mobile menu toggle.
      toggle?.addEventListener('click', () => {
        const expanded = toggle.classList.toggle('expanded');
        toggle.setAttribute('aria-expanded', String(expanded));
        document.body.classList.toggle('overflow-hidden', expanded);
        header?.classList.toggle('expanded', expanded);
        if (!expanded) collapseDropdowns();
      });

      const isMobileNav = () => window.matchMedia('(max-width: 767px)').matches;

      // Mobile: accordion chevrons toggle a submenu. Desktop: ignore clicks so
      // the menu never pins open and the chevron does not flip on its own.
      nav?.addEventListener('click', (e) => {
        const dropdownToggle = (e.target as HTMLElement)?.closest<HTMLElement>('[data-aw-toggle-dropdown]');
        if (dropdownToggle) {
          if (!isMobileNav()) {
            dropdownToggle.blur();
            return;
          }
          e.preventDefault();
          e.stopPropagation();
          const li = dropdownToggle.closest<HTMLElement>('li.dropdown');
          if (!li) return;
          const willOpen = !li.classList.contains('expanded');
          nav.querySelectorAll<HTMLElement>('li.dropdown.expanded').forEach((open) => {
            if (open !== li) setDropdownOpen(open, false);
          });
          setDropdownOpen(li, willOpen);
          return;
        }

        const link = (e.target as HTMLElement)?.closest<HTMLElement>('a');
        if (link) link.blur();

        if (header?.classList.contains('expanded')) closeMenu();
      });

      panel?.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest<HTMLElement>('a');
        if (link) closeMenu();
      });

      // Close it when leaving the mobile breakpoint.
      this.mql = window.matchMedia('(max-width: 767px)');
      this.onMqlChange = () => closeMenu();
      this.mql.addEventListener('change', this.onMqlChange);

      this.querySelectorAll<HTMLElement>('li.mega').forEach((li) => {
        li.addEventListener('mouseenter', () => this.clampMegaMenu(li));
        li.addEventListener('focusin', () => this.clampMegaMenu(li));
      });
      this.onResize = () => {
        this.querySelectorAll<HTMLElement>('li.mega:hover, li.mega:focus-within').forEach((li) => {
          this.clampMegaMenu(li);
        });
      };
      window.addEventListener('resize', this.onResize);

      // Sticky header: toggle the `scroll` class past a small threshold.
      if (header?.hasAttribute('data-aw-sticky-header')) {
        let ticking = false;
        const applyStyles = () => {
          if (window.scrollY > 60) header.classList.add('scroll');
          else header.classList.remove('scroll');
          ticking = false;
        };
        this.onScroll = () => {
          if (!ticking) {
            window.requestAnimationFrame(applyStyles);
            ticking = true;
          }
        };
        applyStyles();
        document.addEventListener('scroll', this.onScroll, { passive: true });
      }

      document.documentElement.classList.add('motion-safe:scroll-smooth');
    }

    disconnectedCallback() {
      if (this.onScroll) document.removeEventListener('scroll', this.onScroll);
      if (this.mql && this.onMqlChange) this.mql.removeEventListener('change', this.onMqlChange);
      if (this.onResize) window.removeEventListener('resize', this.onResize);
      document.removeEventListener('astro:page-load', this.onPageLoad);
      window.removeEventListener('hashchange', this.onPageLoad);
    }

    private clampMegaMenu(li: HTMLElement) {
      const menu = li.querySelector<HTMLElement>('.mega-menu');
      if (!menu) return;
      if (window.matchMedia('(max-width: 767px)').matches) {
        menu.style.removeProperty('--mega-shift');
        return;
      }

      menu.style.setProperty('--mega-shift', '0px');
      requestAnimationFrame(() => {
        const pad = 16;
        const vw = window.innerWidth;
        const rect = menu.getBoundingClientRect();
        if (!rect.width) return;

        let shift = 0;
        if (rect.width >= vw - pad * 2) {
          shift = pad - rect.left;
        } else if (rect.left < pad) {
          shift = pad - rect.left;
        } else if (rect.right > vw - pad) {
          shift = vw - pad - rect.right;
        }
        menu.style.setProperty('--mega-shift', `${Math.round(shift)}px`);
      });
    }

    // With `transition:persist` the header (and its focus) survives client-side
    // navigations, so a clicked dropdown link keeps `:focus-within` and its menu
    // would stay open on the next page. Drop the focus so the CSS closes it.
    private closeOpenDropdown() {
      const active = document.activeElement as HTMLElement | null;
      if (active && this.contains(active) && active.closest('.dropdown')) active.blur();
    }

    private updateActiveLinks() {
      const norm = (p: string) => '/' + p.replace(/^\/+|\/+$/g, '');
      const current = norm(window.location.pathname);
      const currentHash = window.location.hash;

      const isActive = (href: string) => {
        const url = new URL(href, window.location.origin);
        if (norm(url.pathname) !== current) return false;
        if (url.hash) return url.hash === currentHash;
        return !currentHash || currentHash === '#';
      };

      this.querySelectorAll<HTMLAnchorElement>('nav a[href]').forEach((a) => {
        a.classList.toggle('aw-link-active', isActive(a.href));
      });

      this.querySelectorAll<HTMLElement>('nav > ul > li.dropdown').forEach((li) => {
        const childLinks = li.querySelectorAll<HTMLAnchorElement>('.dropdown-menu a[href]');
        const anyChildActive = Array.from(childLinks).some((a) => isActive(a.href));
        const trigger = li.querySelector<HTMLElement>(':scope > a, :scope > span, :scope > div > a, :scope > div > button');
        const triggerHref = trigger instanceof HTMLAnchorElement ? trigger.href : null;
        const triggerActive = Boolean(triggerHref && isActive(triggerHref));
        if (trigger) trigger.classList.toggle('aw-link-active', anyChildActive || triggerActive);
      });
    }
  }

  if (!customElements.get('aw-header')) {
    customElements.define('aw-header', AwHeader);
  }
</script>
