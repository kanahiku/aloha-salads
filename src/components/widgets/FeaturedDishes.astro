---
/**
 * FeaturedDishes — Homepage 59:66.
 * Header row + three photo tiles with overlay titles.
 * One widget for the whole site. Do not fork per page.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import alohaPassionImage from '~/assets/images/aloha-passion.webp';
import onoIslandImage from '~/assets/images/ono-island.webp';
import paniolaImage from '~/assets/images/paniola.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';
import peach from '~/assets/images/peach-motif.webp';

export interface FeaturedDish {
  title: string;
  description: string;
}

export interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  ctaText?: string;
  ctaHref?: string;
  dishes?: FeaturedDish[];
  id?: string;
}

const {
  eyebrow = 'Featured dishes',
  title = 'The ones people come back for.',
  subtitle = 'A few island favorites — or skip the menu entirely and build your own.',
  ctaText = 'view full menu',
  ctaHref = '/menu',
  dishes = [
    {
      title: 'Ono Island Ahi',
      description: 'Fresh local ahi, never frozen, over crisp island greens.',
    },
    {
      title: 'Aloha Passion',
      description: 'Blue cheese, candied walnuts, and a bright vinaigrette.',
    },
    {
      title: 'The Paniolo',
      description: 'Cheddar, black beans, and a smoky BBQ ranch.',
    },
  ],
  id,
} = Astro.props;

const dishImages = [
  { src: onoIslandImage, alt: 'Ono Island Ahi salad with fresh avocado and mango' },
  { src: alohaPassionImage, alt: 'Aloha Passion salad with strawberries, mango, and grilled fish' },
  { src: paniolaImage, alt: 'The Paniolo sandwich with fresh toppings' },
];
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-page"
>
  {/* ── Peach / feather motif — top-right, overflowing edge ── */}
  <img
    src={peach.src}
    alt=""
    aria-hidden="true"
    width={peach.width}
    height={peach.height}
    class="pointer-events-none absolute right-[-8%] top-[-6%] w-[38%] max-w-[560px] select-none"
    loading="eager"
    decoding="async"
  />

  {/* ── Big-leaf motif — bottom-left, behind cards ── */}
  <img
    src={bigLeaf.src}
    alt=""
    aria-hidden="true"
    width={bigLeaf.width}
    height={bigLeaf.height}
    class="pointer-events-none absolute bottom-0 left-[-20px] w-[33%] max-w-[480px] select-none"
    loading="lazy"
    decoding="async"
  />

  <div class="relative z-[1] mx-auto flex w-full max-w-container flex-col gap-10 px-5 pb-10 pt-16 sm:px-8 md:gap-16 md:px-16 md:pb-16 md:pt-[120px]">
    <div class="flex w-full min-w-0 flex-col items-start justify-between gap-6 md:flex-row md:items-center">
      <div class="flex min-w-0 max-w-[822px] flex-1 flex-col items-start gap-6">
        {eyebrow && <Heading variant="eyebrow">{eyebrow}</Heading>}
        {title && <Heading variant="h2">{title}</Heading>}
        {subtitle && (
          <Text variant="body-lg" color="inherit" class="text-heading">{subtitle}</Text>
        )}
      </div>
      {ctaText && (
        <Button variant="primary" text={ctaText} href={ctaHref} hideNote={true} class="shrink-0" />
      )}
    </div>

    <div class="grid w-full grid-cols-1 gap-8 md:grid-cols-3">
      {
        dishes.map((dish, index) => (
          <article class="relative flex w-full flex-col overflow-hidden" style="aspect-ratio: 457 / 514">
            <img
              src={dishImages[index]?.src.src}
              alt={dishImages[index]?.alt ?? dish.title}
              width={dishImages[index]?.src.width}
              height={dishImages[index]?.src.height}
              class="absolute inset-0 h-full w-full object-cover"
              loading="lazy"
              decoding="async"
            />
            <div class="relative z-[1] flex w-full flex-col items-center justify-center gap-2 bg-black/30 px-4 py-6 text-center backdrop-blur-[5px]">
              <Heading variant="h3" color="white">{dish.title}</Heading>
              <Text color="inherit" class="text-page">{dish.description}</Text>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
