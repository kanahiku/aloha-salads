---
/**
 * StoreVisit — address, phone, hours, directions, and map for a single shop.
 * Used on every location subpage. Hours belong here, not on the hub directory.
 */
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import type { StoreLocation } from '~/data/locations';
import { storeDirectionsHref, storeMapEmbedSrc } from '~/data/locations';
import bigLeaf from '~/assets/images/big-leaf.png';
import peach from '~/assets/images/peach-motif.png';

export interface Props {
  store: StoreLocation;
  title?: string;
  id?: string;
}

const { store, title = 'Location, Hours, and Contact', id } = Astro.props;
const hoursLines = store.hours.split(' · ').map((line) => line.trim()).filter(Boolean);
const directionsHref = storeDirectionsHref(store);
const mapSrc = storeMapEmbedSrc(store);
---

<section
  {...id ? { id } : {}}
  class="not-prose relative w-full overflow-hidden bg-page"
  aria-label={`${store.name} location details`}
>
  <img
    src={peach.src}
    alt=""
    aria-hidden="true"
    width={peach.width}
    height={peach.height}
    class="pointer-events-none absolute right-0 top-[-6%] z-0 w-[38%] max-w-[560px] select-none"
    loading="lazy"
    decoding="async"
  />
  <img
    src={bigLeaf.src}
    alt=""
    aria-hidden="true"
    width={bigLeaf.width}
    height={bigLeaf.height}
    class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[33%] max-w-[480px] select-none"
    loading="lazy"
    decoding="async"
  />

  <div class="relative z-[1] mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-16 sm:px-8 md:gap-16 md:px-16 md:py-[120px]">
    <Heading variant="h2">{title}</Heading>

    <div class="grid w-full grid-cols-1 gap-3 lg:grid-cols-2 lg:items-stretch">
      <article class="flex h-full flex-col gap-8 bg-section-dark px-6 py-8 md:px-10 md:py-10">
        <div class="flex flex-col gap-2">
          <Heading variant="eyebrow" color="white" class="text-page/55">Address</Heading>
          <address class="not-italic text-page">
            <Text variant="body-lg" color="white" as="span" class="block">{store.shopName}</Text>
            <Text variant="body-lg" color="white" as="span" class="block">{store.addressLine1}</Text>
            <Text variant="body-lg" color="white" as="span" class="block">{store.addressLine2}</Text>
          </address>
        </div>

        <div class="flex flex-col gap-2">
          <Heading variant="eyebrow" color="white" class="text-page/55">Phone</Heading>
          <a href={store.phoneHref} class="font-sans text-body-lg tracking-[-0.01em] text-page transition-opacity hover:opacity-80">
            {store.phoneDisplay}
          </a>
        </div>

        <div class="flex flex-1 flex-col gap-2">
          <Heading variant="eyebrow" color="white" class="text-page/55">Hours</Heading>
          {hoursLines.map((line) => (
            <Text variant="body-lg" color="white">{line}</Text>
          ))}
        </div>

        <Button
          variant="ghost"
          tone="dark"
          text="Get Directions"
          href={directionsHref}
          target="_blank"
          hideNote={true}
          class="mt-auto self-start"
        />
      </article>

      <div class="min-h-[280px] overflow-hidden bg-section-grey aspect-[600/450] lg:aspect-auto lg:h-auto lg:min-h-full">
        <iframe
          src={mapSrc}
          title={`Map of Aloha Salads at ${store.shopName}`}
          class="h-full w-full border-0"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>
