---
/**
 * BooksGrid — series jump links + book-cover grid.
 * Figma node 121:18. Cover order matches the live catalog (textbook, then
 * anatomy guidebooks, then bargaining).
 */
import Image from '~/components/common/Image.astro';
import type { Book } from '~/lib/content';

export interface FilterTab {
  label: string;
  href: string;
}

export interface Props {
  id?: string;
  books?: Book[];
}

const { id, books = [] } = Astro.props;

const tabs: FilterTab[] = [
  { label: 'Textbook Series', href: '#textbook-series' },
  { label: 'Rebellious Aging Guidebook Series', href: '#guidebook-series' },
  { label: 'Bargaining with Aging Series', href: '#bargaining-series' },
  { label: 'Rebellious Aging Podcast', href: '/podcast' },
];
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full"
>
  <div class="mx-auto w-full max-w-container px-5 py-10 sm:px-8 md:px-16 md:py-[64px] lg:px-[120px]">
  <div class="flex flex-wrap items-start gap-3 mb-8" aria-label="Jump to a book series">
    {tabs.map((tab) => (
      <a
        href={tab.href}
        class="rounded-[12px] px-6 py-4 border font-sans type-eyebrow leading-none transition-colors whitespace-nowrap bg-transparent border-primary text-primary hover:bg-primary/10"
      >
        {tab.label}
      </a>
    ))}
  </div>

  {books.length > 0 && (
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
      {books.map((book) => (
        <a
          href={`#book-${book.slug}`}
          class="group block"
          aria-label={`Jump to ${book.title}`}
        >
          {book.image?.src ? (
            <Image
              src={book.image.src}
              alt={book.image.alt || book.title}
              class="w-full rounded-[8px] object-cover"
              width={190}
              height={284}
              layout="none"
              widths={[190, 380, 570]}
              sizes="(max-width: 640px) 50vw, (max-width: 1024px) 25vw, 190px"
            />
          ) : (
            <div
              class="w-full rounded-[8px] bg-section-grey"
              style="aspect-ratio: 190 / 284;"
              aria-hidden="true"
            />
          )}
        </a>
      ))}
    </div>
  )}
  </div>
</section>
