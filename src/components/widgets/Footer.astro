---
/**
 * Site footer — same on every page.
 *
 * Structure (fixed, from Figma):
 *   full-bleed photo background
 *   └─ max-w-container content column
 *      ├─ CTA card (eyebrow + heading + body + primary button)
 *      └─ logo + tagline + legal links | nav columns
 *
 * Copy lives in src/config/cta.ts.
 * Background image: src/assets/images/footer-bg.png.
 * Do NOT fork this component per page.
 */
import Logo from '~/components/Logo.astro';
import Button from '~/components/ui/Button.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { getHomePermalink } from '~/utils/permalinks';
import { site } from '~/config/site';
import {
  FOOTER_CTA_BODY,
  FOOTER_CTA_EYEBROW,
  FOOTER_CTA_HREF,
  FOOTER_CTA_LABEL,
  FOOTER_CTA_TITLE,
} from '~/config/cta';
import footerBg from '~/assets/images/footer-bg.png';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  tagline?: string;
}

const {
  secondaryLinks = [],
  links = [],
  tagline = site.footerTagline,
} = Astro.props;
---

<footer class="relative not-prose w-full overflow-hidden">
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <img
      src={footerBg.src}
      alt=""
      width={footerBg.width}
      height={footerBg.height}
      class="absolute inset-0 h-full w-full object-cover object-center"
      loading="lazy"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-b from-heading/20 to-heading/50"></div>
  </div>

  <div
    class="relative mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-10 sm:px-8 md:gap-16 md:px-16 md:py-16 lg:px-[120px]"
  >
    <div
      class="flex w-full flex-col items-start gap-8 rounded-[var(--aw-radius-xl)] bg-gradient-to-r from-cta to-cta-end p-8 md:flex-row md:gap-16 md:p-16"
    >
      <div class="flex shrink-0 flex-col items-start gap-4">
        <Heading variant="eyebrow" color="inherit" class="text-tan opacity-50">{FOOTER_CTA_EYEBROW}</Heading>
        <Heading variant="h2" color="inherit" class="text-tan" html={FOOTER_CTA_TITLE} />
      </div>
      <div class="flex min-w-0 flex-1 flex-col items-start justify-center gap-8">
        <Text color="inherit" class="text-tan-body" html={FOOTER_CTA_BODY} />
        <Button variant="secondary" text={FOOTER_CTA_LABEL} href={FOOTER_CTA_HREF} class="w-full" />
      </div>
    </div>

    <div class="flex w-full flex-col items-start justify-between gap-10 md:flex-row md:gap-16">
      <div class="flex w-full max-w-[243px] shrink-0 flex-col items-start gap-4">
        <a class="inline-block" href={getHomePermalink()}>
          <Logo class="h-[95px] w-[132px] max-w-none mix-blend-soft-light" width={132} height={95} />
        </a>
        <Text variant="small" color="white">{tagline}</Text>
        {
          secondaryLinks.length > 0 && (
            <p class="text-small font-sans text-white/50">
              {secondaryLinks.map(({ text, href }, index) => (
                <>
                  {index !== 0 ? ' · ' : ''}
                  <a class="hover:text-white transition duration-150 ease-in-out" href={href} set:html={text} />
                </>
              ))}
            </p>
          )
        }
      </div>

      <nav class="flex flex-wrap items-start gap-10 text-white sm:gap-16 lg:flex-nowrap" aria-label="Footer">
        {
          links.map(({ title, links: items }) => (
            <div class="flex flex-col items-start gap-4">
              {title && <Heading variant="eyebrow" color="white">{title}</Heading>}
              {items && Array.isArray(items) && items.length > 0 && (
                <ul class="flex flex-col items-start gap-2 text-small font-sans font-medium">
                  {items.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="text-white hover:text-white/80 transition duration-150 ease-in-out"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>
  </div>
</footer>
