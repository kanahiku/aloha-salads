---
/**
 * Site footer — Homepage 59:577 (stamp + columns) and 66:833 (wordmark).
 * Same widget on every page. Do NOT fork a HomeFooter.
 *
 */
import { Icon } from 'astro-icon/components';
import alohaWordsMotif from '~/assets/images/aloha-words-motif.svg?url';
import circleMotif from '~/assets/images/circle-motif.svg?url';
import { getHomePermalink } from '~/utils/permalinks';

interface Link {
  text?: string;
  href?: string;
  ariaLabel?: string;
  icon?: string;
}

interface Links {
  title?: string;
  links: Array<Link>;
}

export interface Props {
  links: Array<Links>;
  secondaryLinks?: Array<Link>;
  socialLinks?: Array<Link>;
  footNote?: string;
  theme?: string;
  tagline?: string;
}

const {
  links = [],
  secondaryLinks = [],
  socialLinks = [],
  footNote = '',
} = Astro.props;
---

<footer class="relative not-prose w-full bg-card">
  <div
    class="mx-auto flex w-full max-w-container flex-col px-5 pt-16 sm:px-8 md:px-16"
  >
    <div class="flex w-full flex-col items-start justify-between gap-12 md:flex-row md:items-center">
      <a href={getHomePermalink()} class="shrink-0" aria-label="Aloha Salads">
        <img
          src={circleMotif}
          alt=""
          class="block h-auto"
          style="width: min(242px, 70vw);"
          loading="lazy"
          decoding="async"
        />
      </a>

      <nav class="grid w-full grid-cols-2 gap-x-8 gap-y-10 sm:gap-x-16 md:w-auto md:grid-cols-4" aria-label="Footer">
        {
          links.map(({ title, links: items }) => (
            <div class="flex min-w-0 flex-col items-start gap-4">
              {title && <p class="type-label text-accent">{title}</p>}
              {items && items.length > 0 && (
                <ul class="flex flex-col items-start gap-2">
                  {items.map(({ text, href, ariaLabel }) => (
                    <li>
                      <a
                        class="text-small text-heading hover:text-accent"
                        href={href}
                        aria-label={ariaLabel}
                      >
                        <Fragment set:html={text} />
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </nav>
    </div>
  </div>

  {(socialLinks.length > 0 || secondaryLinks.length > 0 || footNote) && (
    <div class="mx-auto flex w-full max-w-container flex-col gap-6 px-5 py-10 sm:px-8 md:flex-row md:items-center md:justify-between md:px-16">
      {socialLinks.length > 0 && (
        <ul class="flex items-center gap-4">
          {socialLinks.map(({ href, ariaLabel, icon }) => (
            <li>
              <a
                href={href}
                aria-label={ariaLabel}
                target="_blank"
                rel="noopener noreferrer"
                class="text-heading hover:text-accent"
              >
                {icon ? <Icon name={icon} class="size-5" /> : ariaLabel}
              </a>
            </li>
          ))}
        </ul>
      )}
      {secondaryLinks.length > 0 && (
        <nav aria-label="Legal">
          <ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
            {secondaryLinks.map(({ text, href }) => (
              <li>
                <a class="text-small text-heading hover:text-accent" href={href}>
                  {text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {footNote && <p class="text-small text-muted" set:html={footNote} />}
    </div>
  )}

  <div class="mx-auto w-full max-w-container pt-6">
    <img
      src={alohaWordsMotif}
      alt="Aloha Salads"
      class="block h-auto w-full"
      loading="lazy"
      decoding="async"
    />
  </div>
</footer>
