---
/**
 * GuideBookGrid — 3-column grid of book cards for the Guidebook series.
 * Figma node 121:313.
 *
 * Layout:
 *   Light bg-page section.
 *   Header: eyebrow + h2 (left) | description (right).
 *   2-row × 3-col grid of book cards.
 *   Each card: light-blue bg, cover, title, subtitle, description, badges,
 *              buy buttons, publisher note, optional podcast link.
 *
 * Props:
 *   eyebrow     — section eyebrow label (e.g. "Series")
 *   heading     — section h2 (e.g. "Rebellious Aging Guidebook Series")
 *   description — right-column header description
 *   books       — array of GuideBookItem
 *   id          — section anchor
 */
import Heading from '~/components/ui/Heading.astro';
import Button from '~/components/ui/Button.astro';
import Image from '~/components/common/Image.astro';

export interface BuyButton {
  _key?: string;
  label: string;
  href?: string;
}

export interface GuideBookItem {
  slug?: string;
  title: string;
  subtitle?: string;
  description?: string;
  image?: { src: string; alt: string };
  tags?: string[];
  buyButtons?: BuyButton[];
  publisherNote?: string;
  podcastHref?: string;
}

export interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  books?: GuideBookItem[];
  id?: string;
}

const {
  eyebrow = 'Series',
  heading,
  description,
  books = [],
  id,
} = Astro.props;
---

<section
  {...id ? { id } : {}}
  class="not-prose w-full bg-page"
>
  <div class="mx-auto flex w-full max-w-container flex-col gap-10 px-5 py-10 sm:px-8 md:gap-16 md:px-16 md:py-[120px] lg:px-[120px]">
  <!-- Header row -->
  <div class="flex flex-col md:flex-row md:items-start gap-6 md:gap-[120px]">
    <div class="flex flex-col gap-4 shrink-0 md:flex-1">
      {eyebrow && (
        <Heading variant="eyebrow">{eyebrow}</Heading>
      )}
      <Heading variant="h2">{heading}</Heading>
    </div>
    {description && (
      <p class="font-sans text-body text-muted md:flex-1 md:self-center leading-[1.3]">{description}</p>
    )}
  </div>

  <!-- Book grid — 3-col, wrapping into rows -->
  {books.length > 0 && (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
      {books.map((book) => (
        <article
          {...book.slug ? { id: `book-${book.slug}` } : {}}
          class="flex flex-col h-full gap-3 bg-card-light rounded-[16px] p-3 scroll-mt-28"
        >
          {book.image?.src ? (
            <Image
              src={book.image.src}
              alt={book.image.alt || book.title}
              class="w-full rounded-[16px] object-cover"
              width={429}
              height={640}
              layout="none"
              widths={[320, 429, 640, 858]}
              sizes="(max-width: 640px) 100vw, (max-width: 1024px) 50vw, 429px"
            />
          ) : (
            <div
              class="w-full rounded-[16px] bg-section-grey"
              style="aspect-ratio: 1286 / 1920;"
              aria-hidden="true"
            />
          )}

          <div class="flex flex-col flex-1 gap-6 p-2">
            <div class="flex flex-col gap-3 flex-1">
              <Heading variant="h3" class="text-h4 leading-none">{book.title}</Heading>
              {book.subtitle && (
                <p class="font-sans text-body text-primary leading-[1.3]">{book.subtitle}</p>
              )}
              {book.description && (
                <p class="font-sans text-body text-primary/60 leading-[1.3]">{book.description}</p>
              )}
            </div>

            {book.tags && book.tags.length > 0 && (
              <div class="flex flex-wrap gap-2">
                {book.tags.map((tag) => (
                  <span class="bg-card-dark font-sans text-body text-white/90 rounded-full px-4 py-2 drop-shadow-sm">
                    {tag}
                  </span>
                ))}
              </div>
            )}

            <div class="mt-auto flex flex-col gap-3">
              {book.buyButtons && book.buyButtons.length > 0 && (
                <div class="flex flex-wrap gap-3">
                  {book.buyButtons.map((btn) => (
                    <Button
                      variant="ghost"
                      tone="light"
                      text={btn.label}
                      href={btn.href ?? '#'}
                      hideNote={true}
                      class="min-w-0 flex-1 whitespace-nowrap"
                    />
                  ))}
                </div>
              )}
              {book.podcastHref && (
                <Button
                  variant="link"
                  text="Listen to the matching podcast episode"
                  href={book.podcastHref}
                  hideNote={true}
                  class="self-start"
                />
              )}
              {book.publisherNote && (
                <p class="font-sans type-eyebrow text-[11px] tracking-[0.06em] uppercase text-eyebrow">{book.publisherNote}</p>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
  </div>
</section>
