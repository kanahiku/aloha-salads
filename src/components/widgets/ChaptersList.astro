---
/**
 * ChaptersList — "Our Locations" section with glassmorphism rows (Figma node 2:323).
 *
 * Visual spec:
 *   bg-page outer, px-[120px].
 *   Inner card: rounded-[64px], overflow-hidden, p-[64px], bg photo (grey placeholder).
 *   Content (z-10): eyebrow → list of location rows → footer note.
 *
 *   Each row: backdrop-blur-[3px] bg-heading/25, rounded-full, px-8 py-8, items-center justify-between.
 *     Left: location name (font-heading, text-h2, text-white)
 *     Right: members badge (bg-primary, rounded-full, eyebrow text) + arrow-circle icon
 *
 * Usage:
 *   <ChaptersList
 *     eyebrow="Our locations"
 *     locations={[
 *       { name: "Kailua ʻohana", memberCount: 142, href: "/chapters/kailua" },
 *       …
 *     ]}
 *     footerNote="First three visits are always free. Bring a friend, an empty water bottle, and something to put lunch in."
 *     footerLink={{ text: "See all seven chapters.", href: "/chapters" }}
 *   />
 *
 * Background image: pass `bgImage` (imported PNG/JPG ImageMetadata) to show a real photo.
 * Falls back to a bg-section-grey placeholder when omitted.
 */

export interface ChapterLocation {
  name: string;
  memberCount?: number;
  href: string;
}

export interface Props {
  eyebrow?: string;
  locations: ChapterLocation[];
  footerNote?: string;
  footerLink?: { text: string; href: string };
  /** Optional background image (imported ImageMetadata). Falls back to bg-section-grey. */
  bgImage?: { src: string; width: number; height: number };
  id?: string;
}

const {
  eyebrow = 'Our locations',
  locations = [],
  footerNote,
  footerLink,
  bgImage,
  id = 'our-locations',
} = Astro.props;
---

<section {...id ? { id } : {}} class="bg-page not-prose w-full py-8 md:py-16">
  <div class="mx-auto w-full max-w-container px-5 sm:px-8 md:px-16 lg:px-[120px]">

    {/* Card with photo background */}
    <div class="relative flex flex-col items-center gap-8 overflow-hidden rounded-[32px] p-6 md:rounded-[64px] md:p-[64px]">

      {/* ── BACKGROUND ── */}
      {bgImage ? (
        <img
          src={bgImage.src}
          width={bgImage.width}
          height={bgImage.height}
          alt=""
          aria-hidden="true"
          class="absolute inset-0 h-full w-full object-cover object-center"
          loading="lazy"
          decoding="async"
        />
      ) : (
        /* Fallback placeholder — TODO: replace with real image via bgImage prop */
        <div class="absolute inset-0 bg-section-grey" aria-hidden="true" />
      )}

      {/* ── CONTENT (above background) ── */}
      <div class="relative z-10 flex w-full flex-col items-center gap-8">

        {/* Eyebrow */}
        <p class="type-eyebrow font-sans text-[14px] text-primary/60">{eyebrow}</p>

        {/* Location rows */}
        <div class="flex w-full flex-col gap-4">
          {locations.map((loc) => (
            <a
              href={loc.href}
              class="group flex w-full flex-col items-start gap-4 rounded-[24px] bg-heading/25 px-5 py-5 no-underline backdrop-blur-[3px] transition-colors hover:bg-heading/35 sm:flex-row sm:items-center sm:justify-between sm:rounded-full sm:px-8 sm:py-8"
            >
              {/* Location name */}
              <span class="min-w-0 font-heading text-h3 font-normal leading-none text-white md:text-h2">
                {loc.name}
              </span>

              {/* Right: badge + arrow */}
              <div class="flex shrink-0 items-center gap-2.5">

                {/* Members badge */}
                {loc.memberCount !== undefined && (
                  <div class="flex h-8 items-center gap-1 rounded-full bg-primary px-2.5 py-1 sm:h-12 sm:gap-1.5 sm:px-4 sm:py-2">
                    {/* People / group icon */}
                    <svg class="size-3 shrink-0 sm:size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                      <path d="M10.5 8c-.642 0-1.263-.287-1.75-.808-.473-.508-.761-1.185-.812-1.906-.054-.77.18-1.477.661-1.993C9.078 2.778 9.75 2.5 10.5 2.5c.744 0 1.418.283 1.897.797.483.52.718 1.225.664 1.988-.053.722-.341 1.399-.813 1.906C11.763 7.713 11.143 8 10.5 8z"/>
                      <path d="M14.619 13.5H6.38a.627.627 0 01-.621-.638c.263-1.057.915-1.933 1.885-2.534.86-.533 1.957-.827 3.086-.827 1.152 0 2.219.281 3.085.814.972.598 1.625 1.479 1.887 2.548a.627.627 0 01-.083.324.63.63 0 01-.23.228.627.627 0 01-.37.085z"/>
                      <path d="M4.593 8.125c-1.1 0-2.066-1.022-2.156-2.279a2.12 2.12 0 01.563-1.676A2.076 2.076 0 014.593 3.5c.625 0 1.188.24 1.591.674.41.44.61 1.034.563 1.672-.09 1.256-1.056 2.279-2.154 2.279z"/>
                      <path d="M6.645 9.108c-.55-.269-1.263-.403-2.051-.403-.92 0-1.814.24-2.517.675-.797.495-1.334 1.215-1.55 2.085a.625.625 0 00.19.637.628.628 0 00.436.398H4.77a.066.066 0 00.065-.058c.265-1.064.886-1.963 1.804-2.619a.069.069 0 00.004-.115c-.054-.03-.11-.06-.198-.1z"/>
                    </svg>
                    <span class="type-eyebrow font-sans text-[11px] text-white sm:text-[12px]">
                      {loc.memberCount} members
                    </span>
                  </div>
                )}

                {/* Arrow-forward-circle icon */}
                <div class="size-8 shrink-0 sm:size-12" aria-hidden="true">
                  <svg viewBox="25.52 25.52 48 48" fill="currentColor" class="size-full text-white" xmlns="http://www.w3.org/2000/svg">
                    <path d="M73.04 49.52C73.04 36.53 62.51 26 49.52 26 36.53 26 26 36.53 26 49.52c0 12.99 10.53 23.52 23.52 23.52 12.99 0 23.52-10.53 23.52-23.52zm-24.05 10.33a1.81 1.81 0 01-.54-1.28l5.92-5.96H39.8a1.81 1.81 0 010-3.62h14.6l-5.91-5.96a1.81 1.81 0 012.56-2.56l8.98 9.05c.336.34.525.797.525 1.274 0 .478-.189.935-.525 1.274l-8.98 9.05a1.812 1.812 0 01-2.56-.012z"/>
                  </svg>
                </div>

              </div>
            </a>
          ))}
        </div>

        {/* Footer note */}
        {(footerNote || footerLink) && (
          <p class="text-center font-sans text-[14px] leading-[1.3] text-primary/80">
            {footerNote && <span>{footerNote} </span>}
            {footerLink && (
              <a href={footerLink.href} class="font-bold text-primary underline decoration-solid underline-offset-2">
                {footerLink.text}
              </a>
            )}
          </p>
        )}

      </div>
    </div>
  </div>
</section>
