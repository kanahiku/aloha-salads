---
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import MotifLayer from '~/components/ui/MotifLayer.astro';
import { MOTIF, MOTIF_COLOR_VARS, MOTIF_OPACITY_VARS } from '~/config/motif';
import { PRIMARY_CTA_LABEL } from '~/config/cta';
import { CONTACT } from '~/config/contact';

export interface Props {
  title: string;
  subtitle: string;
  ctaText?: string;
  ctaHref?: string;
  showAfterHoursNote?: boolean;
  license?: string;
  extraLines?: string[];
}

const {
  title,
  subtitle,
  ctaText = PRIMARY_CTA_LABEL,
  ctaHref = '/contact',
  showAfterHoursNote = false,
  license,
  extraLines = [],
} = Astro.props;
---

<WidgetWrapper containerClass="max-w-[1400px] mx-auto">
  <div class="relative w-full p-8 md:p-12 rounded-md overflow-hidden bg-cta">
    {MOTIF.sections.cta && (
      <MotifLayer
        color={MOTIF_COLOR_VARS.cta}
        opacityFallback={MOTIF_OPACITY_VARS.cta}
        class="rounded-md"
      />
    )}
    
    <div class="relative z-10">
      <div class="text-left mb-[30px]">
        <h2 class="text-[26px] md:text-[40px] font-normal leading-[110%] tracking-tighter font-heading text-black mb-[20px]">
          {title}
        </h2>
        <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-black/70" set:html={subtitle} />
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6 border-t-2 border-black pt-8">
        <div class="text-[15px] md:text-[16px] font-medium leading-[180%] text-black/70">
          <p class="font-semibold text-black text-[16px] md:text-[17px]">{CONTACT.businessName}</p>
          <p>{CONTACT.address.street}, {CONTACT.address.cityLine}</p>
          <p><a href={CONTACT.phone.href} class="hover:underline">{CONTACT.phone.display}</a></p>
          {extraLines?.map((line) => (
            <p set:html={line} />
          ))}
          {license && <p>{license}</p>}
          {showAfterHoursNote && extraLines.length === 0 && (
            <p class="mt-2 text-[13px] md:text-[14px] italic">Need help after hours? Use the contact form or the online chat.</p>
          )}
        </div>
        <div class="flex flex-col gap-1.5 w-full sm:w-auto sm:max-w-xs">
          <a href={ctaHref} class="inline-flex w-auto self-start sm:self-end items-center justify-center px-6 py-3 rounded-md bg-black text-white font-semibold text-[15px] leading-snug hover:bg-zinc-900 transition-colors duration-200">{ctaText}</a>
        </div>
      </div>
    </div>
  </div>
</WidgetWrapper>
