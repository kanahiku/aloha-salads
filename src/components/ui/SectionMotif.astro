---
interface Props {
  bg?: 'grey' | 'white' | 'navy' | 'none';
  pattern?: 'simple' | 'fancy-two' | 'none';
  patternColor?: 'accent' | 'muted' | 'dark' | 'white' | 'heading';
  patternOpacity?: number;
  class?: string;
}

const {
  bg = 'grey',
  pattern = 'none',
  patternColor = 'muted',
  patternOpacity = 0.03,
  class: className = '',
} = Astro.props;

const bgClasses: Record<string, string> = {
  grey: 'bg-section-grey dark:bg-slate-900/30',
  white: 'bg-white dark:bg-transparent',
  navy: 'bg-heading',
  none: '',
};

void pattern;
void patternColor;
void patternOpacity;
---

<div class:list={['absolute inset-0', bgClasses[bg], className]} aria-hidden="true"></div>
