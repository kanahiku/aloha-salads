---
import type { ImageMetadata } from 'astro';
import MotifLayer from '~/components/ui/MotifLayer.astro';
import { MOTIF, MOTIF_COLOR_VARS, MOTIF_OPACITY_VARS } from '~/config/motif';

export interface Props {
  variant: 'hero' | 'dark' | 'grey' | 'white';
  /** Override opacity for this section. Number (0.15) or percent string ("15%"). */
  motifOpacity?: number | string;
  fadeDirection?: 'top-to-bottom' | 'bottom-to-top' | 'none';
  pattern?: ImageMetadata;
  /** Force motif on/off for this section, ignoring MOTIF.sections. */
  showMotif?: boolean;
  /** CSS color or `var(--aw-color-motif-hero)`. Defaults to the variant token. */
  motifColor?: string;
}

const {
  variant,
  motifOpacity,
  fadeDirection = MOTIF.fade,
  pattern = MOTIF.pattern,
  showMotif,
  motifColor,
} = Astro.props;

const bgClass = {
  hero: '',
  dark: 'bg-section-dark',
  grey: 'bg-section-grey',
  white: '',
}[variant];

const hasMotif = showMotif ?? MOTIF.sections[variant];
const color = motifColor ?? MOTIF_COLOR_VARS[variant];
const opacityFallback = MOTIF_OPACITY_VARS[variant];
---

{bgClass && <div class={`absolute inset-0 ${bgClass}`}></div>}
{hasMotif && (
  <MotifLayer
    color={color}
    opacity={motifOpacity}
    opacityFallback={opacityFallback}
    fade={fadeDirection}
    pattern={pattern}
  />
)}
