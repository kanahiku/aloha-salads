---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore, storeDirectionsHref } from '~/data/locations';
import locationsCover from '~/assets/images/locations-cover.png';
import onoIsland from '~/assets/images/ono-island.png';

const store = findStore('kaneohe');
if (!store) throw new Error('Missing Kaneohe store');

const directionsHref = storeDirectionsHref(store);

const metadata = {
  title: 'Aloha Salads Kaneohe | Fresh Local Food at Windward Mall',
  description:
    'Visit our Aloha Salads location at Windward Mall. We serve fresh salads and wraps made with never-frozen local ahi in 100% compostable packaging.',
  ignoreTitleTemplate: true,
};

const menuFavorites = [
  {
    title: 'Signature Salads',
    description: 'Choose from local favorites like the Aloha Passion or Ono Island Ahi.',
  },
  {
    title: 'Wraps and Subs',
    description: 'Enjoy hearty, wholesome ingredients wrapped up for a quick meal on the go.',
  },
  {
    title: 'Design Your Own Salad',
    description:
      'Build your perfect meal with your choice of greens and toppings dressed with our house-made dressings.',
  },
  {
    title: 'Local Refreshments',
    description: 'Pair your food with refreshing, locally sourced Big Island māmaki mint tea.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Kaneohe"
    title="Aloha Salads Kaneohe<br/>at Windward Mall"
    content="Enjoy fresh, locally sourced food on the Windward coast. Order ahead for quick pickup or stop in for a healthy meal."
    image={{ ...locationsCover, alt: 'Aloha Salads team with fresh salad bowls at the Kaneohe location' }}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Get Directions', href: directionsHref, target: '_blank' },
    ]}
  />

  <TextSplit heading="Your Neighborhood Stop in Kaneohe" withImage imageAspect="4 / 5">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Our Kaneohe store sits near the base of the Koolau mountains and serves fresh food to the Windward side. We opened our doors inside Windward Mall to give this community a reliable, healthy dining option. Our kitchen operates with a clear mission. We use produce grown directly by Hawaii farmers and ingredients caught by local fishermen.
      </Text>
      <Text variant="body-lg" color="default">
        Every salad bowl we make includes crisp greens and our signature house-made dressings. We serve never-frozen local ahi to our customers every single day. Protecting the environment is just as important as the ingredients we use. That is why we pack all our meals in 100% compostable packaging to help reduce waste on the island.
      </Text>
      <Text variant="body-lg" color="default">
        You can find our restaurant right inside Windward Mall. The shopping center provides plenty of seating and parking for a quick workday lunch or a family dinner. Stop by to build a custom salad bowl or pick up a signature wrap to take home. Cool down from the Hawaii heat with a glass of Big Island māmaki mint tea. We are proud to feed our neighbors here in Kaneohe.
      </Text>
    </div>
    <img
      slot="image"
      src={onoIsland.src}
      alt="Fresh salad bowl with local greens and island produce"
      width={onoIsland.width}
      height={onoIsland.height}
      class="h-full w-full rounded-[32px] object-cover"
      loading="lazy"
      decoding="async"
    />
  </TextSplit>

  <StoreVisit store={store} id="visit" />

  <MenuItemsSection
    id="favorites"
    eyebrow="Kaneohe"
    title="Fresh Menu Favorites in Kaneohe"
    items={menuFavorites}
    ctaText="View Menu"
    ctaHref="/menu"
  />

  <CTABanner
    title="Kaneohe Catering for Offices and Events"
    subtitle="We provide fresh catering for business meetings and events across the Windward side. Order custom salad trays and sandwich platters for your next gathering."
    ctaText="Order Catering"
    ctaHref={CATERING_CTA_HREF}
  />
</PageLayout>
