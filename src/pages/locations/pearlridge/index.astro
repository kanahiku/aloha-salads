---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import StoreVisit from '~/components/widgets/StoreVisit.astro';
import MenuItemsSection from '~/components/widgets/MenuItemsSection.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { findStore, storeDirectionsHref } from '~/data/locations';
import locationsCover from '~/assets/images/locations-cover.webp';
import onoIsland from '~/assets/images/ono-island.webp';

const store = findStore('pearlridge');
if (!store) throw new Error('Missing Pearlridge store');

const directionsHref = storeDirectionsHref(store);

const metadata = {
  title: 'Aloha Salads Pearlridge | Fresh Local Food at Pearlridge Center',
  description:
    'Visit our Aloha Salads location at Pearlridge Center in Aiea. We serve fresh salads and wraps made with never-frozen local ahi in 100% compostable packaging.',
  ignoreTitleTemplate: true,
};

const menuFavorites = [
  {
    title: 'Signature Salads',
    description: 'Choose from local favorites like the Aloha Passion or Ono Island Ahi.',
  },
  {
    title: 'Wraps and Subs',
    description: 'Enjoy hearty, wholesome ingredients wrapped up for a quick meal on the go.',
  },
  {
    title: 'Design Your Own Salad',
    description:
      'Build your perfect meal with your choice of greens and toppings dressed with our house-made dressings.',
  },
  {
    title: 'Local Refreshments',
    description: 'Pair your food with refreshing, locally sourced Big Island māmaki mint tea.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Pearlridge / Aiea"
    title="Aloha Salads Pearlridge<br/>at Pearlridge Center"
    content="Enjoy fresh, locally sourced food right in Aiea. Order ahead for quick pickup or stop in for a healthy meal."
    image={{ ...locationsCover, alt: 'Aloha Salads team with fresh salad bowls at the Pearlridge location' }}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Get Directions', href: directionsHref, target: '_blank' },
    ]}
  />

  <TextSplit heading="Your Neighborhood Stop in Pearlridge" withImage imageAspect="4 / 5">
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Our Pearlridge location brings healthy dining directly to the Aiea community. We set up shop inside Pearlridge Center Downtown to offer a convenient food option for busy shoppers and local professionals. Our kitchen operates with a strict focus on quality sourcing. We build our menu around fresh produce supplied by trusted Hawaii farmers. We also source our seafood directly from local fishermen.
      </Text>
      <Text variant="body-lg" color="default">
        Every meal starts with high standards. You will find crisp greens and our daily scratch-made dressings on the menu. We are proud to serve never-frozen local ahi in our bowls. Taking care of the island environment is just as crucial as serving great food. To reduce waste, we pack every single takeout order in 100% compostable packaging.
      </Text>
      <Text variant="body-lg" color="default">
        Visiting us is easy when you are at the mall. The center provides plenty of parking and a comfortable space to sit down for a quick lunch. You can easily stop by to customize a salad bowl or pick up a signature wrap on your way home. Cool off with a refreshing glass of Big Island māmaki mint tea. We look forward to feeding you here in Aiea.
      </Text>
    </div>
    <img
      slot="image"
      src={onoIsland.src}
      alt="Fresh salad bowl with local greens and island produce"
      width={onoIsland.width}
      height={onoIsland.height}
      class="h-full w-full rounded-[32px] object-cover"
      loading="lazy"
      decoding="async"
    />
  </TextSplit>

  <StoreVisit store={store} id="visit" />

  <MenuItemsSection
    id="favorites"
    eyebrow="Pearlridge"
    title="Fresh Menu Favorites in Pearlridge"
    items={menuFavorites}
    ctaText="View Menu"
    ctaHref="/menu"
  />

  <CTABanner
    title="Pearlridge Catering for Offices and Events"
    subtitle="We provide fresh catering for business meetings and events across Aiea and the surrounding area. Order custom salad trays and sandwich platters for your next gathering."
    ctaText="Order Catering"
    ctaHref={CATERING_CTA_HREF}
  />
</PageLayout>
