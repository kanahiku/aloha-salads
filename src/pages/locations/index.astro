---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getLocationsContent } from '~/lib/content/locationContent';
import { escapeHtml, textToHtml } from '~/lib/content/richText';

const { hub, shared, stores } = await getLocationsContent();
const metadata = { ...hub.meta, ignoreTitleTemplate: true };
const faqs = hub.faqs.map((faq) => ({ title: faq.question, description: faq.answer }));
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline={escapeHtml(hub.hero.tagline)}
    title={textToHtml(hub.hero.title)}
    content={textToHtml(hub.hero.content)}
    image={hub.hero.image}
    actions={[
      { variant: 'primary', text: shared.heroPrimaryCtaLabel, href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: shared.heroSecondaryCtaLabel, href: CATERING_CTA_HREF },
    ]}
  />

  <LocationDirectory id="find-a-location" title={hub.directoryTitle} stores={stores} viewLabel={shared.viewLabel} />

  {faqs.length > 0 && <FAQs title={shared.faqTitle} items={faqs} isDark={true} />}

  <CTABanner
    title={hub.cta.title}
    subtitle={hub.cta.subtitle}
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
