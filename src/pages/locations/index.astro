---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocationDirectory from '~/components/widgets/LocationDirectory.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';

const metadata = {
  title: 'Aloha Salads Locations | Find Our 6 Oahu Restaurants',
  description:
    'Find an Aloha Salads location near you. We operate six restaurants across Oahu offering fresh meals for dine-in or fast pickup.',
  ignoreTitleTemplate: true,
};

const heroTitle = 'Aloha Salads Locations<br/>on Oahu';
const heroContent =
  "Find your nearest Aloha Salads. We operate six neighborhood restaurants across O'ahu. Every location offers online ordering for fast pickup and convenient dine-in seating.";

const faqs = [
  {
    title: 'Do all locations offer dine-in seating?',
    description:
      "Yes. All six of our O'ahu restaurants feature dedicated dining areas for guests who prefer to eat in.",
  },
  {
    title: 'Is parking available at your restaurants?',
    description:
      'Yes. Each of our mall and shopping center locations provides ample free parking for our guests.',
  },
  {
    title: 'Can I collect a catering order from the stores?',
    description:
      'Yes. Catering trays can be collected from this store. Call ahead to arrange it.',
  },
  {
    title: 'Do you offer delivery from these locations?',
    description:
      'We partner with third-party delivery services to bring our meals directly to you. Delivery availability depends on your proximity to a specific restaurant.',
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Locations"
    title={heroTitle}
    content={heroContent}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  <LocationDirectory id="find-a-location" />

  <FAQs
    title="Frequently Asked Questions"
    items={faqs}
    isDark={true}
  />

  <CTABanner
    title="Visit Us Today"
    subtitle="Stop by your neighborhood restaurant for a fresh meal or place your order online for convenient pickup."
    ctaText="View Full Menu"
    ctaHref="/menu"
    secondaryCtaText="Order Online"
    secondaryCtaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
