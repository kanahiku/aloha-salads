---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import ConceptCards from '~/components/widgets/ConceptCards.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';

const metadata = {
  title: `Four Pillars | ${site.name}`,
  description:
    'Not the introduction — the first treatment. Movement, food, sleep, and connection: the four things to do before you spend a dollar on anything else.',
  ignoreTitleTemplate: true,
};

const header = navigationData.header;

const conceptCards = [
  {
    label: 'the mechanism',
    title: 'Trajectories',
    description:
      'Peak, slope, floor, reserve. What the average rate of decline looks like per system, and how to work out where you sit on your own curves. Failure modes: some systems fail by gradual attrition, others go off a cliff.',
  },
  {
    label: 'the strategy',
    title: 'The Weakest Link',
    description:
      'Put disproportionate effort into the system closest to its floor, not the one that is already strong. And watch the interlinkage — lose your hearing and you hasten dementia; damage your vasculature and it pulls your muscles, brain, eyes and kidneys down with it.',
  },
  {
    label: 'the sequence',
    title: 'The Buckets',
    description:
      'Do the basics first, then earn your way to the fancy stuff. The price goes up as the evidence goes down — which is why bucket one is free and bucket three costs thousands.',
  },
  {
    label: 'the philosophy',
    title: 'Accept vs. Change',
    description:
      'Your eyes will stiffen no matter what you do. Accept it. Your kidney function falling from unmanaged blood pressure is not the same thing at all. The wisdom to know the difference is the whole product.',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <Hero2
    variant="page"
    overlapHeader={false}
    title="Four Pillars"
    subtitle={`<p>Not the introduction — the first treatment. Once you know your weakest link, these are the four things to do before you spend a dollar on anything else. They carry the strongest evidence in the literature and cost, between them, almost nothing.</p><p>Fill the first bucket. Let the surplus flow.</p>`}
  >
    <Header
      slot="nav"
      embedded
      isSticky={false}
      links={header.links}
      actions={header.actions}
    />
  </Hero2>

  <ConceptCards cards={conceptCards} />

  <TextSplit heading="And then we stop.">
    <Text>
      There is a point past which this is medical care, and we do not deliver medical care. What we do is hand you a shorter, sharper list of things to raise with the person who does — including the ones almost nobody raises, like whether you still need every medication you are taking.
    </Text>
    <Button
      variant="primary"
      text="What to ask your doctor"
      href="/guidebooks/bucket-02"
      hideNote
      class="mt-8 self-start"
    />
  </TextSplit>
</Layout>
