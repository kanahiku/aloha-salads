---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import SessionCards from '~/components/widgets/SessionCards.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';

const metadata = {
  title: `Guidebooks | ${site.name}`,
  description:
    'Each chapter hosts roughly twenty-four Guidebook sessions a year — lectures from working clinicians and researchers, paired with member-led journal clubs.',
  ignoreTitleTemplate: true,
};

const header = navigationData.header;

const GUIDEBOOKS_PAGE_HIDDEN = true;
if (GUIDEBOOKS_PAGE_HIDDEN) {
  return Astro.redirect('/');
}

const sessionCopy = {
  label: 'Apr 22 · Kailua chapter',
  title: 'Exercise is a drug. What dose, and when?',
  speaker: 'Dr. Naomi Kahale, Exercise Physiologist',
  description:
    'A working prescription: how much strength, how much zone 2, how much VO₂ max work, and how to build a sustainable weekly plan after sixty.',
  ctaText: 'Explore',
  ctaHref: '/guidebooks/exercise',
};

const sessions = [sessionCopy, sessionCopy, sessionCopy, sessionCopy, sessionCopy, sessionCopy];
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <Hero2
    variant="page"
    overlapHeader={false}
    title="Experts come.<br />We read the papers."
    subtitle="Each chapter hosts roughly twenty-four Guidebook sessions a year — lectures from working clinicians and researchers, paired with member-led journal clubs that work directly from the primary literature."
  >
    <Header
      slot="nav"
      embedded
      isSticky={false}
      links={header.links}
      actions={header.actions}
    />
  </Hero2>

  <SessionCards id="calendar" eyebrow="Spring 2026 calendar" cards={sessions} />
</Layout>
