---
import Layout from '~/layouts/PageLayout.astro';
import InteriorPage from '~/components/widgets/InteriorPage.astro';
import { getSanityInteriorPage } from '~/lib/content/pageContent';

const page = await getSanityInteriorPage('nutrition-allergens');
const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <InteriorPage page={page} />
</Layout>
