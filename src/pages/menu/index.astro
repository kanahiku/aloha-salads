---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FullMenuSection from '~/components/widgets/FullMenuSection.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import { getMenuHubData } from '~/lib/content/menuContent';
import { textToHtml } from '~/lib/content/richText';

const { hub, shared, categories } = await getMenuHubData();
const metadata = { ...hub.meta, ignoreTitleTemplate: true };
const faqs = hub.faqs.map((faq) => ({ title: faq.question, description: faq.answer }));
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title={textToHtml(hub.hero.title)}
    content={textToHtml(hub.hero.content)}
    image={hub.hero.image}
    actions={[
      { variant: 'primary', text: shared.orderLabel, href: PRIMARY_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: shared.locationLabel, href: LOCATION_CTA_HREF },
    ]}
  />

  <FullMenuSection
    id="full-menu"
    title={hub.fullMenu.title}
    subtitle={hub.fullMenu.subtitle}
    categories={categories}
    ctaText={shared.orderLabel}
    ctaHref={PRIMARY_CTA_HREF}
  />

  <LocalSourcing
    title={hub.sourcing.title}
    subtitle={hub.sourcing.subtitle}
    ctaText={hub.sourcing.ctaLabel}
    ctaHref="/ingredients"
    withPhoto={true}
    image={hub.sourcing.image}
  />

  <CTABanner
    title={shared.readyTitle}
    subtitle={hub.cta.subtitle}
    ctaText={shared.orderLabel}
    ctaHref={PRIMARY_CTA_HREF}
  />

  {faqs.length > 0 && <FAQs title={shared.faqTitle} items={faqs} isDark={true} />}
</PageLayout>
