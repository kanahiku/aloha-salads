---
import PageLayout from '~/layouts/PageLayout.astro';
import CateringOccasionPage from '~/components/widgets/CateringOccasionPage.astro';
import { getCateringContent } from '~/lib/content/pageContent';

const { main, subpages } = await getCateringContent();
const page = subpages.find((sub) => sub.slug === 'corporate')!;

const metadata = { title: page.meta.title, description: page.meta.description, ignoreTitleTemplate: true };
---

<PageLayout metadata={metadata}>
  <CateringOccasionPage page={page} subpages={subpages} shared={main.shared} />
</PageLayout>
