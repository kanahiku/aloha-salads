---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import peach from '~/assets/images/peach-motif.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';

const metadata = {
  title: 'Office Lunch Catering Oahu | Team Meals | Aloha Salads',
  description:
    "Order fresh office lunch catering for your team. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.",
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Team Lunch Platters',
    description:
      "Keep your team energized with our fresh options. Our sandwich platters and signature salad trays offer easy sharing for breakroom lunches and casual Friday meals.",
  },
  {
    number: '02',
    title: 'Accommodating Every Diet',
    description:
      "Offices have diverse dietary requirements. We provide dedicated vegetarian options and plant-based trays to ensure everyone on your team has a meal they can enjoy.",
  },
  {
    number: '03',
    title: 'Built From Our Daily Menu',
    description:
      "We build every catering tray using the same quality components as our daily menu. This includes our scratch-made dressings and fresh Hau'ula tomatoes.",
  },
  {
    number: '04',
    title: 'Reliable Office Meals',
    description:
      "Skip the heavy takeout. Our fresh salads offer a lighter alternative that keeps your team productive throughout the afternoon.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Catering"
    title="Office Lunch Catering"
    content="Provide fresh meals for your coworkers. We prepare scaled-up versions of our signature salads and wraps for daily team lunches. All office catering orders are available for pickup across our six O'ahu locations."
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Office lunch catering occasions">
    <img src={peach.src} alt="" aria-hidden="true" width={peach.width} height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none" loading="lazy" decoding="async" />
    <img src={bigLeaf.src} alt="" aria-hidden="true" width={bigLeaf.width} height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none" loading="lazy" decoding="async" />

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {occasions.map((occ) => (
          <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
            <span class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-page/[0.07] md:text-[120px]" aria-hidden="true">{occ.number}</span>
            <div class="relative flex flex-col gap-4">
              <span class="font-rough text-[15px] leading-none text-page/90">{occ.number}</span>
              <Heading variant="h3" color="white">{occ.title}</Heading>
              <Text color="white" class="text-page/75 leading-relaxed">{occ.description}</Text>
            </div>
            <div class="mt-8 h-px w-12 bg-accent"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CateringSubNav
    excludeHref="/catering/office-lunches"
    subtitle="We provide catering services for various event types. Explore our other catering menus below:"
  />

  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      { title: "How much food do I need for my office?", description: "Please contact your nearest location to confirm specific serving sizes and tray yields for your headcount." },
      { title: "Does office catering include serving utensils?", description: "Ask the store when you order and they will let you know what is included." },
      { title: "Can I accommodate vegetarian coworkers?", description: "Yes. We prepare dedicated meatless options including the Aloha Mediterranean Tray and the Aloha Passion Tray." },
      { title: "Can we add drinks to our office lunch order?", description: "Yes. You can include bottled beverages and our refreshing Big Island māmaki mint tea to complete your team meal." },
      { title: "Can individuals customize their own bowls?", description: "Our large catering trays are built to set recipes. Employees who need highly specific modifications can use our Design Your Own Salad option through individual ordering." },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Order online for pickup. Not sure how many trays you need for the team? Call your nearest store."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
