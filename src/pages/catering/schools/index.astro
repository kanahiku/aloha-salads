---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import locationsCover from '~/assets/images/locations-cover.png';
import peach from '~/assets/images/peach-motif.png';
import bigLeaf from '~/assets/images/big-leaf.png';

const metadata = {
  title: 'School Catering Oahu | Teachers & Athletics | Aloha Salads',
  description:
    "Order fresh school catering for your campus. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.",
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Faculty and Staff Lunches',
    description:
      "Keep your teachers energized with nutrient-dense meals. Our signature salad trays provide a fresh alternative to heavy breakroom food during teacher appreciation days or planning sessions.",
  },
  {
    number: '02',
    title: 'Athletic Team Meals',
    description:
      "Provide quality fuel for your student-athletes. Our catering trays offer lean protein and fresh vegetables for pre-game meals or end-of-season banquets.",
  },
  {
    number: '03',
    title: 'Accommodating Every Diet',
    description:
      "Ensure every student and faculty member has a meal. We provide dedicated vegetarian options and plant-based trays to meet diverse dietary requirements across your campus.",
  },
  {
    number: '04',
    title: 'Quality Ingredients',
    description:
      "Every catering tray is built using the same high-quality components as our standard menu. We use our scratch-made dressings and premium produce, including vine-ripe Hau'ula tomatoes.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Catering"
    title="School Catering"
    content="Provide fresh food for your campus. We prepare large-format catering trays and wrap platters for school events and faculty lunches. All school orders are available for pickup across our six O'ahu locations."
    image={{ ...locationsCover, alt: 'Fresh catering tray set up for a school staff lunch in Oahu' }}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="School catering occasions">
    <img src={peach.src} alt="" aria-hidden="true" width={peach.width} height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none" loading="lazy" decoding="async" />
    <img src={bigLeaf.src} alt="" aria-hidden="true" width={bigLeaf.width} height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none" loading="lazy" decoding="async" />

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
        <div class="flex max-w-2xl flex-col gap-4">
          <Heading variant="eyebrow">What we cover</Heading>
          <Heading variant="h2">Fresh Catering for Every Campus</Heading>
          <Text variant="body-lg" color="default">
            From faculty lunches to athletic banquets, we support your school community with wholesome, locally sourced food.
          </Text>
        </div>
        <div class="shrink-0">
          <Button variant="primary" text="Order Catering Online" href={CATERING_CTA_HREF} hideNote={true} />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {occasions.map((occ) => (
          <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
            <span class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-page/[0.07] md:text-[120px]" aria-hidden="true">{occ.number}</span>
            <div class="relative flex flex-col gap-4">
              <span class="font-rough text-[15px] leading-none text-accent">{occ.number}</span>
              <Heading variant="h3" color="white">{occ.title}</Heading>
              <Text color="white" class="text-page/75 leading-relaxed">{occ.description}</Text>
            </div>
            <div class="mt-8 h-px w-12 bg-accent"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CateringSubNav excludeHref="/catering/schools" />

  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      { title: "How far in advance should I order for a school event?", description: "Please contact your nearest location to confirm the required lead time for your specific campus headcount." },
      { title: "Are serving utensils included for school orders?", description: "We provide the necessary serving bowls and serving utensils with every catering order upon request." },
      { title: "Do you offer meatless options for students and staff?", description: "Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray." },
      { title: "Can we accommodate specific food allergies?", description: "Yes. We can modify our catering trays to accommodate specific dietary requirements for your school group." },
      { title: "Do you provide drinks for school catering?", description: "Yes. You can include bottled beverages and our refreshing Big Island mamaki mint tea with your catering order." },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your school catering order online for fast pickup. Need to confirm serving sizes or lead times for a large group? Contact your nearest location directly."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
