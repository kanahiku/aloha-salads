---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import locationsCover from '~/assets/images/locations-cover.png';
import peach from '~/assets/images/peach-motif.png';
import bigLeaf from '~/assets/images/big-leaf.png';
import smallLeafMotif from '~/assets/images/small-leaf-motif.webp';

const metadata = {
  title: 'Catering Menu & Party Trays | Aloha Salads Oahu',
  description:
    "Order fresh catering trays for your next event. View our full catering menu with pricing, including our Sandwich Platter and Ono Island Ahi Tray.",
  ignoreTitleTemplate: true,
};

const menuItems = [
  { label: 'Sandwich Platter', price: '$85' },
  { label: 'Ono Island Ahi Tray', price: '$60' },
  { label: 'Kamuela Cobb Tray', price: '$55' },
  { label: 'Mandarin Ginger Tray', price: '$52' },
  { label: 'Aloha Caesar with Chicken Tray', price: '$45' },
  { label: 'Aloha Passion Tray', price: '$42' },
  { label: 'Aloha Mediterranean Tray', price: '$42' },
  { label: 'The Paniolo Tray', price: '$42' },
  { label: 'Tray of Pita Bread', price: '$24' },
];

const occasions = [
  {
    label: 'Corporate Catering',
    href: '/catering/corporate',
    description: 'Fresh trays for client meetings, team events, and office gatherings.',
  },
  {
    label: 'Office Lunch Catering',
    href: '/catering/office-lunches',
    description: 'Healthy lunch options delivered to your workplace.',
  },
  {
    label: 'Meeting Catering',
    href: '/catering/meetings',
    description: 'Nourish your team with wholesome food during any size meeting.',
  },
  {
    label: 'Event Catering',
    href: '/catering/events',
    description: 'Custom salad and wrap trays built for special events.',
  },
  {
    label: 'Party Catering',
    href: '/catering/parties',
    description: 'Crowd-pleasing island flavors for birthdays and celebrations.',
  },
  {
    label: 'School Catering',
    href: '/catering/schools',
    description: 'Wholesome, kid-friendly catering options for school events.',
  },
  {
    label: 'Large Group Catering',
    href: '/catering/large-groups',
    description: 'Scaled-up trays and platters for big gatherings across O\'ahu.',
  },
];
---

<PageLayout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Catering"
    title="Catering Menu"
    content="Provide fresh meals for your next gathering with our catering trays. We prepare scaled-up versions of our signature salads and wraps for pickup across our six O'ahu locations."
    image={{ ...locationsCover, alt: 'Large catering salad tray prepared by Aloha Salads for an Oahu event' }}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
    ]}
  />

  {/* ── 2. Pricing section ───────────────────────────────── */}
  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Catering menu and pricing">
    <img
      src={peach.src} alt="" aria-hidden="true"
      width={peach.width} height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none"
      loading="lazy" decoding="async"
    />
    <img
      src={bigLeaf.src} alt="" aria-hidden="true"
      width={bigLeaf.width} height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none"
      loading="lazy" decoding="async"
    />
    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="flex flex-col gap-12 lg:flex-row lg:items-start lg:gap-24">

        {/* Left — heading + ordering note */}
        <div class="flex flex-1 flex-col gap-8 lg:sticky lg:top-32">
          <div class="flex flex-col gap-4">
            <Heading variant="eyebrow">Pricing</Heading>
            <Heading variant="h2">Catering Menu and Pricing</Heading>
            <Text variant="body-lg" color="default">
              Our trays are built using the same high-quality components as our standard menu.
            </Text>
          </div>
          <div class="flex flex-col gap-3 border-l-4 border-accent/30 pl-6">
            <Heading variant="h4">Ordering Details</Heading>
            <Text color="default">
              Please contact your nearest location to confirm serving sizes per tray, minimum order requirements, and necessary lead times for large groups. Delivery availability and radius vary by restaurant.
            </Text>
          </div>
          <div class="mt-2">
            <Button variant="primary" text="Order Catering Online" href={CATERING_CTA_HREF} hideNote={true} />
          </div>
        </div>

        {/* Right — price list */}
        <div class="flex min-w-0 flex-1 flex-col">
          <ul class="flex flex-col" role="list">
            {menuItems.map((item, i) => (
              <li class:list={[
                'flex items-baseline justify-between gap-6 py-5',
                i < menuItems.length - 1 && 'border-b border-heading/10',
              ]}>
                <span class="font-rough text-[22px] leading-snug text-heading">{item.label}</span>
                <span class="shrink-0 font-rough text-[22px] leading-snug text-accent">{item.price}</span>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </section>

  {/* ── 3. Occasions grid ────────────────────────────────── */}
  <section class="not-prose relative w-full overflow-hidden bg-section-grey" aria-label="Catering occasion types">
    <div
      class="pointer-events-none absolute inset-0"
      style={`background-image: url('${smallLeafMotif.src}'); background-size: 3400px auto; background-position: top left; background-repeat: repeat;`}
      aria-hidden="true"
    ></div>
    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="flex flex-col gap-10 md:gap-16">

        <div class="flex flex-col gap-4">
          <Heading variant="eyebrow">By occasion</Heading>
          <Heading variant="h2">Catering for Every Occasion</Heading>
          <Text variant="body-lg" color="default" class="max-w-2xl">
            We accommodate groups of all sizes across different event types. Select your event category below to learn more.
          </Text>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {occasions.map((occ) => (
            <a
              href={occ.href}
              class="group flex h-full flex-col gap-4 bg-section-dark px-5 pb-5 pt-6 transition-opacity hover:opacity-90"
            >
              <div class="flex flex-1 flex-col gap-3">
                <Heading variant="h4" color="white">{occ.label}</Heading>
                <Text variant="small" color="white" class="text-page/75">{occ.description}</Text>
              </div>
              <div class="flex items-center gap-2 text-accent">
                <span class="font-heading text-[13px] uppercase tracking-widest leading-none">Learn more</span>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.75" class="size-3 transition-transform duration-200 group-hover:translate-x-0.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                </svg>
              </div>
            </a>
          ))}
        </div>

      </div>
    </div>
  </section>

  {/* ── 4. FAQs ──────────────────────────────────────────── */}
  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      {
        title: "Do you offer vegetarian catering options?",
        description:
          "Yes. We prepare meatless options including the Aloha Passion Tray and Aloha Mediterranean Tray.",
      },
      {
        title: "Does catering include serving utensils?",
        description:
          "Yes. We provide the necessary serving bowls and utensils with every catering order upon request.",
      },
      {
        title: "How do I place a catering order?",
        description:
          "You can place your catering order directly through our online ordering system or by calling your nearest location.",
      },
      {
        title: "Can I customize the catering trays?",
        description:
          "Yes. We can accommodate specific dietary requirements and ingredient modifications for your group.",
      },
      {
        title: "Where do I pick up my catering order?",
        description:
          "You can pick up your catering order at any of our six neighborhood restaurants across O'ahu.",
      },
    ]}
  />

  {/* ── 5. Ready to order CTA ────────────────────────────── */}
  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your catering order online for fast pickup. Need to confirm serving sizes or lead times for a large group? Contact your nearest location directly."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
