---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import TrayCard from '~/components/ui/TrayCard.astro';
import { CATERING_CTA_HREF } from '~/config/cta';
import peach from '~/assets/images/peach-motif.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';
import smallLeafMotif from '~/assets/images/small-leaf-motif.webp';
import { getCateringContent } from '~/lib/content/pageContent';
import { textToHtml } from '~/lib/content/richText';

const { main: content, subpages } = await getCateringContent();
const { shared } = content;

const metadata = {
  title: content.meta.title,
  description: content.meta.description,
  ignoreTitleTemplate: true,
};

// Occasion cards come from the sub-page documents (Catering → each page → "Catering page card").
const occasions = subpages
  .filter((sub) => sub.showOnCateringPage)
  .map((sub) => ({ label: sub.title, href: `/catering/${sub.slug}`, description: sub.cardDescription }));
---

<PageLayout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline={textToHtml(content.hero.tagline)}
    title={textToHtml(content.hero.title)}
    content={textToHtml(content.hero.content)}
    image={content.hero.image}
    actions={[{ variant: 'primary', text: shared.orderLabel, href: CATERING_CTA_HREF }]}
  />

  {/* ── 2. Pricing section ───────────────────────────────── */}
  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Catering menu and pricing">
    <img
      src={peach.src}
      alt=""
      aria-hidden="true"
      width={peach.width}
      height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none"
      loading="lazy"
      decoding="async"
    />
    <img
      src={bigLeaf.src}
      alt=""
      aria-hidden="true"
      width={bigLeaf.width}
      height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none"
      loading="lazy"
      decoding="async"
    />
    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="flex flex-col gap-10 md:gap-14">
        {/* Heading + ordering note */}
        <div class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-24">
          <div class="flex max-w-2xl flex-1 flex-col gap-4">
            <Heading variant="h2">{content.pricing.title}</Heading>
            <Text variant="body-lg" color="default">
              {content.pricing.intro}
            </Text>
          </div>
          <div class="flex max-w-xl flex-1 flex-col gap-6">
            <div class="flex flex-col gap-3 border-l-4 border-accent/30 pl-6">
              <Heading variant="h4">{content.pricing.orderingTitle}</Heading>
              <Text color="default">
                {content.pricing.orderingText}
              </Text>
            </div>
            <div>
              <Button variant="primary" text={shared.orderLabel} href={CATERING_CTA_HREF} hideNote={true} />
            </div>
          </div>
        </div>

        {/* Tray cards */}
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
          {content.trays.map((tray) => <TrayCard label={tray.name} price={tray.price} image={tray.image} />)}
        </div>
      </div>
    </div>
  </section>

  {/* ── 3. Occasions grid ────────────────────────────────── */}
  <section class="not-prose relative w-full overflow-hidden bg-section-grey" aria-label="Catering occasion types">
    <div
      class="pointer-events-none absolute inset-0"
      style={`background-image: url('${smallLeafMotif.src}'); background-size: 1700px auto; background-position: top left; background-repeat: repeat;`}
      aria-hidden="true"
    >
    </div>
    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="flex flex-col gap-10 md:gap-16">
        <div class="flex flex-col gap-4">
          <Heading variant="eyebrow">{content.occasions.eyebrow}</Heading>
          <Heading variant="h2">{content.occasions.title}</Heading>
          <Text variant="body-lg" color="default" class="max-w-2xl">
            {content.occasions.intro}
          </Text>
        </div>

        <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {
            occasions.map((occ) => (
              <a
                href={occ.href}
                class="group flex h-full flex-col gap-4 bg-section-dark px-5 pb-5 pt-6 transition-opacity hover:opacity-90"
              >
                <div class="flex flex-1 flex-col gap-3">
                  <Heading variant="h4" color="white">
                    {occ.label}
                  </Heading>
                  <Text variant="small" color="white" class="text-page/75">
                    {occ.description}
                  </Text>
                </div>
                <div class="flex items-center gap-2 text-page/90">
                  <span class="font-heading text-[13px] uppercase tracking-widest leading-none">
                    {content.occasions.linkLabel}
                  </span>
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 16 16"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    class="size-3 transition-transform duration-200 group-hover:translate-x-0.5"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 8h10M9 4l4 4-4 4" />
                  </svg>
                </div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {/* ── 4. Ready to order CTA ────────────────────────────── */}
  <CTABanner title={shared.readyTitle} subtitle={content.cta.subtitle} />

  {/* ── 5. FAQs ──────────────────────────────────────────── */}
  {
    content.faqs.length > 0 && (
      <FAQs
        isDark={true}
        title={shared.faqTitle}
        items={content.faqs.map((faq) => ({ title: faq.question, description: textToHtml(faq.answer) }))}
      />
    )
  }
</PageLayout>
