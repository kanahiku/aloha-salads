---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import locationsCover from '~/assets/images/locations-cover.webp';
import peach from '~/assets/images/peach-motif.webp';
import bigLeaf from '~/assets/images/big-leaf.webp';

const metadata = {
  title: 'Large Group Catering Oahu | Salads & Wraps | Aloha Salads',
  description:
    "Order fresh catering for your large group. We prepare salad trays, wrap platters, fresh soups, and beverages for pickup across our six Oahu locations.",
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Flexible Menu Options',
    description:
      "Feed your crowd with nutrient-dense meals. Our signature salad trays and sandwich platters offer easy sharing for big groups with varying tastes.",
  },
  {
    number: '02',
    title: 'Dietary Accommodations',
    description:
      "Ensure every guest has a meal they can enjoy. We provide dedicated vegetarian options and plant-based trays to meet diverse dietary requirements within your large group.",
  },
  {
    number: '03',
    title: 'Premium Ingredients',
    description:
      "Every catering tray is built using the same high-quality components as our standard menu. We use our scratch-made dressings and premium produce, including vine-ripe Hau'ula tomatoes.",
  },
  {
    number: '04',
    title: 'Seamless Pickup',
    description:
      "We package large orders efficiently so you can transport your food safely. You can retrieve your catering trays from any of our six neighborhood restaurants.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Catering"
    title="Large Group Catering"
    content="Provide fresh food for your large gathering. We prepare large-format catering trays and wrap platters for groups of all sizes. All large group orders are available for pickup across our six O'ahu locations."
    image={{ ...locationsCover, alt: 'Large catering tray spread prepared for a big gathering in Oahu' }}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Large group catering occasions">
    <img src={peach.src} alt="" aria-hidden="true" width={peach.width} height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none" loading="lazy" decoding="async" />
    <img src={bigLeaf.src} alt="" aria-hidden="true" width={bigLeaf.width} height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none" loading="lazy" decoding="async" />

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
        <div class="flex max-w-2xl flex-col gap-4">
          <Heading variant="eyebrow">What we cover</Heading>
          <Heading variant="h2">Fresh Catering for Large Groups</Heading>
          <Text variant="body-lg" color="default">
            No crowd too big. We scale our quality trays and platters to feed any size gathering across O'ahu.
          </Text>
        </div>
        <div class="shrink-0">
          <Button variant="primary" text="Order Catering Online" href={CATERING_CTA_HREF} hideNote={true} />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {occasions.map((occ) => (
          <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
            <span class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-page/[0.07] md:text-[120px]" aria-hidden="true">{occ.number}</span>
            <div class="relative flex flex-col gap-4">
              <span class="font-rough text-[15px] leading-none text-accent">{occ.number}</span>
              <Heading variant="h3" color="white">{occ.title}</Heading>
              <Text color="white" class="text-page/75 leading-relaxed">{occ.description}</Text>
            </div>
            <div class="mt-8 h-px w-12 bg-accent"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CateringSubNav excludeHref="/catering/large-groups" />

  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      { title: "How much notice is required for a large group order?", description: "Please contact your nearest location to confirm the required lead time for your specific headcount." },
      { title: "How do I calculate serving sizes for a large crowd?", description: "Please contact your nearest location to confirm specific serving sizes and tray yields based on your total guest count." },
      { title: "Are serving utensils included for large orders?", description: "We provide the necessary serving bowls and serving utensils with every catering order upon request." },
      { title: "Can I order meatless options for a large group?", description: "Yes. We prepare dedicated plant-based items including the Aloha Mediterranean Tray and the Aloha Passion Tray." },
      { title: "Do you provide drinks for large group catering?", description: "Yes. You can include bottled beverages and our refreshing Big Island mamaki mint tea with your catering order." },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your large group catering order online for fast pickup. Need to confirm serving sizes or lead times? Contact your nearest location directly."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
