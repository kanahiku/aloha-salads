---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CateringSubNav from '~/components/widgets/CateringSubNav.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { CATERING_CTA_HREF, LOCATION_CTA_HREF } from '~/config/cta';
import locationsCover from '~/assets/images/locations-cover.png';
import peach from '~/assets/images/peach-motif.png';
import bigLeaf from '~/assets/images/big-leaf.png';

const metadata = {
  title: 'Party Catering Oahu | Birthdays, Graduations & Showers | Aloha Salads',
  description:
    "Order fresh party catering for your next event. We provide salad trays and wrap platters for birthdays, graduations, baby showers, and sports banquets across our six Oahu locations.",
  ignoreTitleTemplate: true,
};

const occasions = [
  {
    number: '01',
    title: 'Birthday Party Catering',
    description:
      "Serve fresh options at your next birthday gathering. Our sandwich platters and signature salad trays provide easy meals for guests with varying dietary preferences.",
  },
  {
    number: '02',
    title: 'Graduation Party Catering',
    description:
      "Celebrate your graduate with a fresh menu. We offer scaled-up versions of our signature items designed to feed large crowds during graduation season.",
  },
  {
    number: '03',
    title: 'Shower Catering',
    description:
      "Our fresh salads provide a light menu option for baby showers and bridal showers. We can customize your order to include dedicated vegetarian or vegan platters, such as our Aloha Passion Tray.",
  },
  {
    number: '04',
    title: 'Sports Team Catering',
    description:
      "Provide nutrient-dense food for your athletes. Our catering trays offer lean protein and fresh vegetables for post-game meals or end-of-season banquets.",
  },
];
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Catering"
    title="Party Catering"
    content="Provide fresh food for your next celebration. We prepare large-format catering trays and wrap platters for parties of all sizes. All party orders are available for pickup across our six O'ahu locations."
    image={{ ...locationsCover, alt: 'Fresh catering tray spread set up for a party celebration in Oahu' }}
    actions={[
      { variant: 'primary', text: 'Order Catering Online', href: CATERING_CTA_HREF },
      { variant: 'ghost', tone: 'dark', text: 'View Full Catering Menu', href: '/catering' },
    ]}
  />

  <section class="not-prose relative w-full overflow-hidden bg-page" aria-label="Party catering occasions">
    <img src={peach.src} alt="" aria-hidden="true" width={peach.width} height={peach.height}
      class="pointer-events-none absolute right-0 top-0 w-[32%] max-w-[480px] select-none" loading="lazy" decoding="async" />
    <img src={bigLeaf.src} alt="" aria-hidden="true" width={bigLeaf.width} height={bigLeaf.height}
      class="pointer-events-none absolute bottom-0 left-[-20px] z-0 w-[28%] max-w-[420px] select-none" loading="lazy" decoding="async" />

    <div class="relative z-[1] mx-auto w-full max-w-container px-5 py-16 sm:px-8 md:px-16 md:py-[120px]">
      <div class="mb-12 flex flex-col gap-4 md:mb-16 md:flex-row md:items-end md:justify-between">
        <div class="flex max-w-2xl flex-col gap-4">
          <Heading variant="eyebrow">What we cover</Heading>
          <Heading variant="h2">Fresh Catering for Every Celebration</Heading>
          <Text variant="body-lg" color="default">
            From birthdays to banquets, we make every celebration taste as good as it feels.
          </Text>
        </div>
        <div class="shrink-0">
          <Button variant="primary" text="Order Catering Online" href={CATERING_CTA_HREF} hideNote={true} />
        </div>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {occasions.map((occ) => (
          <article class="group relative flex flex-col justify-between overflow-hidden bg-section-dark px-8 pb-8 pt-10 md:px-10 md:pb-10 md:pt-12">
            <span class="pointer-events-none absolute right-6 top-4 select-none font-rough text-[96px] leading-none text-page/[0.07] md:text-[120px]" aria-hidden="true">{occ.number}</span>
            <div class="relative flex flex-col gap-4">
              <span class="font-rough text-[15px] leading-none text-accent">{occ.number}</span>
              <Heading variant="h3" color="white">{occ.title}</Heading>
              <Text color="white" class="text-page/75 leading-relaxed">{occ.description}</Text>
            </div>
            <div class="mt-8 h-px w-12 bg-accent"></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <CateringSubNav excludeHref="/catering/parties" />

  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      { title: "Can I customize party trays for food allergies?", description: "Yes. We can modify our catering trays to accommodate specific dietary requirements for your party guests." },
      { title: "Do you provide plates and napkins for parties?", description: "We provide the necessary serving bowls and serving utensils with every catering order upon request." },
      { title: "How far in advance should I order for a large party?", description: "Please contact your nearest location to confirm the required lead time for your specific party size." },
      { title: "Can I pick up my party catering order on the weekend?", description: "Yes. We prepare and package catering orders seven days a week across our six O'ahu locations." },
      { title: "Do you offer beverages for party catering?", description: "Yes. You can add bottled drinks and our refreshing Big Island mamaki mint tea to complete your party menu." },
    ]}
  />

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your party catering order online for fast pickup. Need to confirm serving sizes or lead times for a large group? Contact your nearest location directly."
    ctaText="Order Catering Online"
    ctaHref={CATERING_CTA_HREF}
    secondaryCtaText="Find a Location"
    secondaryCtaHref={LOCATION_CTA_HREF}
  />
</PageLayout>
