---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import Heading from '~/components/ui/Heading.astro';
import Text from '~/components/ui/Text.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import { getSanityIngredientsImages } from '~/lib/content/sanity';

const ingredientsImages = await getSanityIngredientsImages();

const metadata = {
  title: 'Local Ingredients & Sourcing | Aloha Salads Oahu',
  description:
    'Discover how Aloha Salads sources fresh ingredients, including vine-ripe Hauula tomatoes, vessel-tracked wild ahi, and Big Island mamaki tea.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  {/* ── Page hero ─────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title="Our Ingredients: Freshly Sourced on Oahu"
    content="We are dedicated to supporting local farmers and fishermen while providing our customers with the freshest and healthiest ingredients available. Every dish is built with quality produce and seafood delivered directly to our kitchens across Oahu."
    image={ingredientsImages.hero}
    actions={[
      { variant: 'primary', text: 'View Menu', href: '/menu' },
      { variant: 'ghost-dark', text: 'Find a Location', href: '/locations' },
    ]}
  />

  {/* ── Ingredient sourcing facts ─────────────────────────── */}
  <LocalSourcing
    eyebrow=""
    title=""
    subtitle=""
    ctaText=""
    factsLayout="featured"
    compact
    facts={[
      {
        title: 'Fresh Local Produce',
        description:
          '<p><strong>Hauula Tomatoes:</strong> We maintain a standing weekly order for vine-ripe tomatoes grown in Hauula by Green Growers Inc.</p><p><strong>Oahu Farms:</strong> We receive Japanese cucumbers and a second tomato variety from Ho Farms, alongside regular produce deliveries featuring items like green onions, sweet basil, bean sprouts, and green bell peppers.</p>',
      },
      {
        title: 'Vessel-Tracked Wild Ahi',
        description:
          'We exclusively feature never-frozen local ahi for our seafood salads. Delivered four times a week to our busier stores by Garden & Valley Isle Seafood, a Honolulu seafood supplier, every delivery carries a lot number, origin as USA wild, and the name of the specific catch vessel that landed it.',
      },
      {
        title: 'Big Island Mamaki Mint Tea',
        description:
          'We brew our mamaki mint tea fresh in-store daily. The tea is sourced from Oribe Tea Co in Hilo on the Big Island, made with Hawaiian mamaki and locally grown ingredients.',
      },
      {
        title: 'Quality Dressings and Foundations',
        description:
          'Most of our signature salad dressings are made in house, in small batches through the week.',
      },
    ]}
  />

  <section class="not-prose relative w-full">
    <div class="mx-auto flex w-full max-w-container flex-col px-5 pt-4 pb-8 sm:px-8 md:px-16 md:pt-4 md:pb-16">
      <div class="flex w-full flex-col bg-card px-6 py-8 md:px-12 md:py-10">
        <div class="flex w-full flex-col items-start gap-5">
          <Heading variant="h2">Our Packaging</Heading>
          <div class="flex w-full flex-col gap-4">
            <Text variant="body-lg" color="default">
              We use different packaging materials depending on what you order. From salad containers to drink cups and utensils, each item has its own materials and purpose.
            </Text>
            <Text
              variant="body"
              color="default"
              html="Our salad containers come in two sizes, and both are made from <strong>molded fiber with no added PFAS</strong>. PFAS are chemicals sometimes added to food packaging to help resist grease and water."
            />
            <Text
              variant="body"
              color="default"
              html="For soups and bowls, we use containers featuring the Aloha Salads logo, paired with lids made from <strong>PLA (polylactic acid)</strong>, a type of plastic typically made from plant-based materials. Our 20-ounce cold drink cups and flat lids are also made from PLA."
            />
            <Text
              variant="body"
              color="default"
              html="We use <strong>AirCarbon straws</strong>, made with a material produced from greenhouse gases using naturally occurring microorganisms. We also use <strong>Karat PLA forks and spoons</strong>."
            />
            <Text variant="body" color="default">
              By sharing these details, we want you to know more about the materials used for each item, just as we share information about the ingredients in our food.
            </Text>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ── FAQs ──────────────────────────────────────────────── */}
  <FAQs
    isDark={true}
    title="Frequently Asked Questions"
    items={[
      {
        title: 'Can I view the full menu before ordering?',
        description:
          'Yes. You can explore our complete selection of salads, wraps, subs, and soups on our main menu page.',
      },
      {
        title: 'Where can I pick up an online order?',
        description:
          'You can order ahead for fast pickup at any of our six neighborhood restaurants across Oahu, located in Kailua, Kahala, Kaneohe, Kapolei, Mililani, and Pearlridge.',
      },
      {
        title: 'Do you offer catering services?',
        description: 'Yes. We offer a variety of priced catering trays and sandwich platters for group gatherings.',
      },
      {
        title: 'Are your dressings made in house?',
        description: 'Most of them, yes. Our signature dressings are made in house in small batches through the week.',
      },
    ]}
  />

  <CTABanner
    title="Ready to Taste the Difference?"
    subtitle="Order your favorite salad or bowl online for fast pickup at any of our six Oahu locations."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
