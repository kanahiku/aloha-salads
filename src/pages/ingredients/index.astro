---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getSanityIngredientsImages } from '~/lib/content/sanity';
import { getSanityIngredientsContent } from '~/lib/content/pageContent';
import { paragraphsToHtml, textToHtml } from '~/lib/content/richText';

const [ingredientsImages, content] = await Promise.all([getSanityIngredientsImages(), getSanityIngredientsContent()]);

const metadata = {
  title: content.meta.title,
  description: content.meta.description,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  {/* ── Page hero ─────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline={textToHtml(content.hero.tagline)}
    title={textToHtml(content.hero.title)}
    content={textToHtml(content.hero.content)}
    image={ingredientsImages.hero}
    actions={[
      { variant: 'primary', text: content.hero.primaryCtaLabel, href: '/menu' },
      { variant: 'ghost-dark', text: content.hero.secondaryCtaLabel, href: '/locations' },
    ]}
  />

  {/* ── Ingredient sourcing facts ─────────────────────────── */}
  <LocalSourcing
    eyebrow={content.sourcingEyebrow}
    factsLayout="featured"
    facts={content.facts.map((fact) => ({ title: fact.title, description: paragraphsToHtml(fact.description) }))}
    appendCard={{
      title: 'Our Packaging',
      description: [
        'We use different packaging materials depending on what you order. From salad containers to drink cups and utensils, each item has its own materials and purpose.',
        'Our salad containers come in two sizes, and both are made from molded fiber with no added PFAS. PFAS are chemicals sometimes added to food packaging to help resist grease and water.',
        'For soups and bowls, we use containers featuring the Aloha Salads logo, paired with lids made from PLA (polylactic acid), a type of plastic typically made from plant-based materials. Our 20-ounce cold drink cups and flat lids are also made from PLA.',
        'We use AirCarbon straws, made with a material produced from greenhouse gases using naturally occurring microorganisms. We also use Karat PLA forks and spoons.',
        'By sharing these details, we want you to know more about the materials used for each item, just as we share information about the ingredients in our food.',
      ].map((p) => `<p>${p}</p>`).join(''),
    }}
  />

  {/* ── Closing CTA ───────────────────────────────────────── */}
  <CTABanner title={content.cta.title} subtitle={content.cta.subtitle} />

  {/* ── FAQs ──────────────────────────────────────────────── */}
  {
    content.faqs.length > 0 && (
      <FAQs
        isDark={true}
        title={content.faqTitle}
        items={content.faqs.map((faq) => ({ title: faq.question, description: textToHtml(faq.answer) }))}
      />
    )
  }
</PageLayout>
