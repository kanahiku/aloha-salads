---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { PRIMARY_CTA_HREF } from '~/config/cta';
import locationsCover from '~/assets/images/locations-cover.webp';

const metadata = {
  title: 'Local Ingredients & Sourcing | Aloha Salads Oahu',
  description:
    "Discover how Aloha Salads sources fresh ingredients, including vine-ripe Hau'ula tomatoes, vessel-tracked wild ahi, and Big Island mamaki tea.",
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="Our Ingredients"
    title="Our Ingredients:<br/>Freshly Sourced on Oahu"
    content="We are dedicated to supporting local farmers and fishermen while providing our customers with the freshest and healthiest ingredients available. Every dish is built with quality produce and seafood delivered directly to our kitchens across O&lsquo;ahu."
    image={{ ...locationsCover, alt: 'Fresh salad bowl built with locally sourced ingredients from Oahu farms' }}
    actions={[
      { variant: 'primary', text: 'View Menu', href: '/menu' },
      { variant: 'ghost', tone: 'dark', text: 'Find a Location', href: '/locations' },
    ]}
  />

  <LocalSourcing
    eyebrow="What we source"
    title="Freshly sourced on O&lsquo;ahu, every day."
    subtitle="We have partnered with local farms and fishermen since 2006 — here is exactly what that means for every bowl we make."
    ctaText="View Full Menu"
    ctaHref="/menu"
    facts={[
      {
        title: "Fresh Local Produce",
        description:
          "We maintain a standing weekly order for vine-ripe Hau'ula tomatoes and receive Japanese cucumbers, green onions, sweet basil, bean sprouts, and bell peppers from O'ahu farms.",
      },
      {
        title: "Vessel-Tracked Wild Ahi",
        description:
          "We exclusively feature never-frozen local ahi. Every delivery carries a lot number, USA wild origin, and the name of the specific vessel that caught it.",
      },
      {
        title: "Big Island Mamaki Mint Tea",
        description:
          "Our mamaki mint tea is brewed fresh in-store daily using tea sourced from a company in Hilo on the Big Island, made with Hawaiian mamaki and locally grown ingredients.",
      },
      {
        title: "Quality Dressings",
        description:
          "All of our signature salad dressings are crafted from scratch daily in our kitchens using quality ingredients — never bottled, never pre-made.",
      },
    ]}
  />

  <FAQs
    isDark={true}
    tagline="Common questions"
    title="Frequently Asked Questions"
    items={[
      {
        title: "Can I view the full menu before ordering?",
        description:
          "Yes. You can explore our complete selection of salads, wraps, subs, and soups on our main menu page.",
      },
      {
        title: "Where can I pick up an online order?",
        description:
          "You can order ahead for fast pickup at any of our six neighborhood restaurants across O&rsquo;ahu, located in Kailua, Kahala, Kaneohe, Kapolei, Mililani, and Pearlridge.",
      },
      {
        title: "Do you offer catering services?",
        description:
          "Yes. We offer a variety of priced catering trays and sandwich platters for group gatherings.",
      },
      {
        title: "Are your dressings made from scratch?",
        description:
          "Yes. All of our signature salad dressings are crafted daily in our kitchens.",
      },
    ]}
  />

  <CTABanner
    title="Ready to Taste the Difference?"
    subtitle="Order your favorite salad or bowl online for fast pickup at any of our six O'ahu locations."
    ctaText="Order Online"
    ctaHref={PRIMARY_CTA_HREF}
  />
</PageLayout>
