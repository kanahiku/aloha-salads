---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import Button from '~/components/ui/Button.astro';
import FormContainer from '~/components/ui/Form.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getContactHelpOptions, getContactPage } from '~/lib/content';
import { CONTACT } from '~/config/contact';
import { PRIMARY_CTA_LABEL } from '~/config/cta';
import { contactAddress, mapsDirectionsHref, mapsEmbedSrc } from '~/data/pages/contact';

export const prerender = false;

const page = await getContactPage();
const helpOptions = page?.form.helpOptions?.length ? page.form.helpOptions : await getContactHelpOptions();
const mapsQuery = page?.form.mapsQuery || contactAddress.mapsQuery;

const metadata = {
  title: page?.meta.title || `Contact | ${CONTACT.businessName}`,
  description: page?.meta.description || `Contact ${CONTACT.businessName}.`,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero2>
    <Fragment slot="title">{page?.hero.title || 'Contact us'}</Fragment>
    <Fragment slot="subtitle">
      {
        page?.hero.subtitle ||
          `Send a message and we will get back to you. You can also call ${CONTACT.phone.display}.`
      }
    </Fragment>
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper id="message" containerClass="max-w-[1400px] mx-auto">
    <Headline title={page?.form.heading || 'Send a message'} classes={{ container: 'mb-[9px]' }} />
    <p class="text-[16px] md:text-[17px] font-normal leading-[160%] text-muted text-left max-w-3xl mb-[30px]">
      {page?.form.intro || 'Use the form and we will follow up by email or phone.'}
    </p>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 md:gap-12 items-start">
      <div class="rounded-lg bg-white p-4 sm:p-6 lg:p-8">
        <FormContainer
          inputs={[
            { type: 'text', name: 'name', label: 'Name *', autocomplete: 'name', required: true },
            { type: 'email', name: 'email', label: 'Email *', autocomplete: 'email', required: true },
            { type: 'tel', name: 'phone', label: 'Phone *', autocomplete: 'tel', required: true },
            { type: 'text', name: 'zip', label: 'ZIP Code *', autocomplete: 'postal-code', required: true },
            {
              type: 'select',
              name: 'topic',
              label: page?.form.topicLabel || 'How can we help? *',
              required: true,
              placeholder: page?.form.topicPlaceholder || 'Select a topic',
              options: helpOptions,
            },
          ]}
          textarea={{ label: page?.form.messageLabel || 'Message', name: 'message', rows: 5 }}
          button={page?.form.submitLabel || 'Send Message'}
        />
      </div>
      <div>
        <h3 class="text-[18px] md:text-[20px] font-medium leading-[130%] text-heading mb-3">
          {page?.form.mapHeading || CONTACT.businessName}
        </h3>
        <p class="text-[14px] md:text-[15px] font-medium leading-[160%] text-muted mb-4">
          {page?.form.addressLine1 || contactAddress.line1}
          <br />
          {page?.form.addressLine2 || contactAddress.city}
        </p>
        <div class="rounded-md overflow-hidden border border-accent/60 bg-card-dark aspect-[4/3] min-h-[280px]">
          <iframe
            title={`Map of ${CONTACT.businessName} at ${mapsQuery}`}
            src={mapsEmbedSrc(mapsQuery)}
            class="w-full h-full min-h-[280px]"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            allowfullscreen
          ></iframe>
        </div>
        <div class="mt-6">
          <Button
            variant="ghost-light"
            text={page?.form.directionsLabel || 'Get Directions'}
            href={mapsDirectionsHref(mapsQuery)}
            target="_blank"
          />
        </div>
      </div>
    </div>
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner
    title={page?.ctaBanner.title || 'Ready to get started?'}
    subtitle={page?.ctaBanner.subtitle || `Reach ${CONTACT.businessName} and we will take it from there.`}
    ctaText={page?.ctaBanner.ctaText || PRIMARY_CTA_LABEL}
    ctaHref={page?.ctaBanner.ctaHref}
    extraLines={page?.ctaBanner.extraLines}
    license={page?.ctaBanner.license}
    showAfterHoursNote={page?.ctaBanner.showAfterHoursNote}
  />
</Layout>
