---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import InteriorPage from '~/components/widgets/InteriorPage.astro';
import CareersApplication from '~/components/widgets/CareersApplication.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getInteriorPage } from '~/data/pages/interior';
import { site } from '~/config/site';
import { getSanityCareersImages } from '~/lib/content/sanity';

const page = getInteriorPage('/careers');
const careersImages = await getSanityCareersImages();

const metadata = {
  title: `${page.title} | ${site.name}`,
  description: page.metaDescription,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {/* Footer-only page: not in the primary nav. H1, intro, and Benefits come from interior.ts; hero photo from Sanity (Careers). */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    hideImage={!careersImages.hero}
    title={page.heading}
    content={page.lede}
    image={careersImages.hero}
  />

  {/* Same band as the Contact page: Benefits on the dark panel (left), application form on the cream card (right). */}
  <CareersApplication>
    <InteriorPage page={page} hideHero bare onDark />
  </CareersApplication>

  <CTABanner
    title="Ready to Order?"
    subtitle="Skip the line and place your order online for fast pickup. Planning a group event? We also offer a variety of catering options."
  />
</Layout>
