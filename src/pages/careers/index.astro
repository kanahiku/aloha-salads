---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import InteriorPage from '~/components/widgets/InteriorPage.astro';
import CareersApplication from '~/components/widgets/CareersApplication.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import { getSanityCareersImages } from '~/lib/content/sanity';
import { getSanityCareersContent } from '~/lib/content/pageContent';
import { textToHtml } from '~/lib/content/richText';

const [careersImages, content] = await Promise.all([getSanityCareersImages(), getSanityCareersContent()]);

const metadata = {
  title: content.meta.title,
  description: content.meta.description,
  ignoreTitleTemplate: true,
};

// Benefits render through the shared InteriorPage section list.
const benefitsPage = {
  heading: content.hero.title,
  lede: content.hero.content,
  sections:
    content.benefits.items.length > 0
      ? [{ heading: content.benefits.heading, items: content.benefits.items.map((title) => ({ title })) }]
      : [],
};
---

<Layout metadata={metadata}>
  {/* Footer-only page: not in the primary nav. Copy and hero photo come from Sanity (Careers). */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    hideImage={!careersImages.hero}
    title={textToHtml(content.hero.title)}
    content={textToHtml(content.hero.content)}
    image={careersImages.hero}
  />

  {/* Same band as the Contact page: Benefits on the dark panel (left), application form on the cream card (right). */}
  <CareersApplication title={content.applyTitle}>
    <InteriorPage page={benefitsPage} hideHero bare onDark />
  </CareersApplication>

  <CTABanner title={content.cta.title} subtitle={content.cta.subtitle} />
</Layout>
