---
import Layout from '~/layouts/PageLayout.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import SectionBg from '~/components/ui/SectionBg.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import ReviewsGrid from '~/components/widgets/ReviewsGrid.astro';
import { getReviewsPageContent } from '~/lib/content/pageContent';

export const prerender = false;

// Page text: Studio → Reviews page. The review cards themselves come live from Google and Yelp.
const page = await getReviewsPageContent();
const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero2>
    <Fragment slot="title">{page.heroTitle}</Fragment>
    {page.heroSubtitle && <Fragment slot="subtitle">{page.heroSubtitle}</Fragment>}
    <Fragment slot="bg">
      <SectionBg variant="hero" />
    </Fragment>
  </Hero2>

  <WidgetWrapper containerClass="max-w-container mx-auto">
    {page.listTitle && <Headline title={page.listTitle} classes={{ container: 'mb-[9px]' }} />}
    <ReviewsGrid showHeader={false} sources={['google', 'yelp']} variant="dark" showCta={false} />
    <Fragment slot="bg">
      <SectionBg variant="grey" />
    </Fragment>
  </WidgetWrapper>

  <CTABanner title={page.cta.title} subtitle={page.cta.subtitle || undefined} />
</Layout>
