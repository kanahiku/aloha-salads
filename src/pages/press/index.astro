---
import PageLayout from '~/layouts/PageLayout.astro';
import PressCards from '~/components/widgets/PressCards.astro';
import { pressContent } from '~/data/pages/press';
import { getPressItems } from '~/lib/content';

// Cards are managed in Sanity (Studio → Press cards).
const pressItems = await getPressItems();

const metadata = {
  title: pressContent.metadata.title,
  description: pressContent.metadata.description,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <PressCards title={pressContent.heading} subtitle={pressContent.lede} items={pressItems} />
</PageLayout>
