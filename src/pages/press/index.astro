---
import PageLayout from '~/layouts/PageLayout.astro';
import PressCards from '~/components/widgets/PressCards.astro';
import { getPressItems } from '~/lib/content';
import { getPressPageContent } from '~/lib/content/pageContent';

// Page text: Studio → Press & Media → Press page. Cards: Studio → Press & Media → Press cards.
const [page, pressItems] = await Promise.all([getPressPageContent(), getPressItems()]);

const metadata = {
  title: page.meta.title,
  description: page.meta.description,
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>
  <PressCards title={page.heading} subtitle={page.lede || undefined} items={pressItems} />
</PageLayout>
