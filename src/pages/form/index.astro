const RLAB = ['I do this easily', 'I do it differently or less', 'I no longer do this'];
const KEY = 'ra_fleet_v1';
const BUILD = 'v2.3 · 2026-09-02';
const OPTIN_ENDPOINT = '/api/subscribe';
const BANDTXT = ['Nothing flagged', 'Worth mentioning', 'Worth discussing'];

/* ═════════════════════════════ STATE ═════════════════════════════ */
let S = { answers: {}, radius: {}, priority: [], measured: {}, started: null, finished: null, ack: false };

function load() {
  try {
    const raw = localStorage.getItem(KEY);
    if (raw) {
      const o = JSON.parse(raw);
      ['answers','radius','measured'].forEach(k => { if (o[k]) S[k] = o[k]; });
      if (o.priority) S.priority = o.priority;
      S.started = o.started || null;
      S.finished = o.finished || null;
      S.previous = o.previous || null;
      S.ack = !!o.ack;
    }
  } catch(e) {}
}
function save() {
  try { localStorage.setItem(KEY, JSON.stringify(S)); } catch(e) {}
}
load();

/* ═════════════════════════════ SCORING ═════════════════════════════ */
function sysScore(sid) {
  let s = 0, n = 0;
  for (let i = 0; i < 3; i++) {
    const v = S.answers[sid + '_' + i];
    if (typeof v === 'number') { s += v; n++; }
  }
  /* Score any system with at least one answer. Unanswered items count as 0
     so the 0–9 total stays comparable. "Not answered" is only for n === 0. */
  return n === 0 ? null : s;
}
function band(sc) { return sc === null ? -1 : sc <= 2 ? 0 : sc <= 5 ? 1 : 2; }
function sysById(id) { return DATA.systems.find(s => s.id === id) || null; }
function answeredCount() { return Object.values(S.answers).filter(v => typeof v === 'number').length; }
function radiusFlagged() { return DATA.radius.filter(r => S.radius[r.id] === 1 || S.radius[r.id] === 2); }
function radiusAnswered() { return DATA.radius.filter(r => S.radius[r.id] !== undefined).length; }

/* ═════════════════════════════ DOM HELPERS ═════════════════════════════ */
function el(tag, cls, text) {
  const e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text != null) e.textContent = text;
  return e;
}

/* ═════════════════════════════ BUILD DOMAINS ═════════════════════════════ */
function buildDomain(di) {
  const host = document.getElementById('dom' + di);
  host.innerHTML = '';
  DATA.systems.forEach(sy => {
    if (sy.domain !== di) return;
    const card = el('div', 'quiz-system-card');

    /* System name header row */
    card.appendChild(el('div', 'quiz-system-name', sy.label));

    sy.q.forEach((stem, qi) => {
      const q = el('div', 'quiz-question');
      q.appendChild(el('div', 'quiz-q-stem', stem));

      /* Horizontal answer buttons */
      const opts = el('div', 'quiz-opts');
      const labs = DATA.scales[(sy.scale && sy.scale[qi]) || 'freq'] || [];
      labs.forEach((lab, vi) => {
        const b = el('button', 'quiz-opts-btn', lab);
        b.type = 'button';
        b.setAttribute('aria-pressed', S.answers[sy.id + '_' + qi] === vi ? 'true' : 'false');
        if (S.answers[sy.id + '_' + qi] === vi) b.classList.add('selected');
        b.onclick = function() {
          S.answers[sy.id + '_' + qi] = vi; save();
          opts.querySelectorAll('.quiz-opts-btn').forEach((o, oi) => {
            o.setAttribute('aria-pressed', oi === vi ? 'true' : 'false');
            o.classList.toggle('selected', oi === vi);
          });
          updateProgress();
        };
        opts.appendChild(b);
      });
      q.appendChild(opts);
      card.appendChild(q);
    });
    host.appendChild(card);
  });
}

/* ═════════════════════════════ BUILD RADIUS ═════════════════════════════ */
function buildRadius() {
  const host = document.getElementById('radlist');
  host.innerHTML = '';
  DATA.radius.forEach(r => {
    const card = el('div', 'quiz-system-card');
    card.appendChild(el('div', 'quiz-q-stem', r.label));
    if (r.note) {
      const note = el('div', 'quiz-small', r.note);
      note.style.marginBottom = '8px';
      note.style.opacity = '0.6';
      card.appendChild(note);
    }
    const opts = el('div', 'quiz-opts quiz-opts-three');
    RLAB.forEach((lab, vi) => {
      const b = el('button', 'quiz-opts-btn', lab);
      b.type = 'button';
      b.setAttribute('aria-pressed', S.radius[r.id] === vi ? 'true' : 'false');
      if (S.radius[r.id] === vi) b.classList.add('selected');
      b.onclick = function() {
        S.radius[r.id] = vi; save();
        opts.querySelectorAll('.quiz-opts-btn').forEach((o, oi) => {
          o.setAttribute('aria-pressed', oi === vi ? 'true' : 'false');
          o.classList.toggle('selected', oi === vi);
        });
        naBtn.setAttribute('aria-pressed', 'false');
        naBtn.classList.remove('selected');
        updateProgress();
      };
      opts.appendChild(b);
    });
    card.appendChild(opts);

    const naWrap = el('div', 'quiz-opts quiz-opts-na');
    const naBtn = el('button', 'quiz-opts-btn', "Doesn't apply to me");
    naBtn.type = 'button';
    naBtn.setAttribute('aria-pressed', S.radius[r.id] === 'n' ? 'true' : 'false');
    if (S.radius[r.id] === 'n') naBtn.classList.add('selected');
    naBtn.onclick = function() {
      S.radius[r.id] = 'n'; save();
      opts.querySelectorAll('.quiz-opts-btn').forEach(o => {
        o.setAttribute('aria-pressed', 'false');
        o.classList.remove('selected');
      });
      naBtn.setAttribute('aria-pressed', 'true');
      naBtn.classList.add('selected');
      updateProgress();
    };
    naWrap.appendChild(naBtn);
    card.appendChild(naWrap);
    host.appendChild(card);
  });
}

/* ═════════════════════════════ BUILD PRIORITY ═════════════════════════════ */
function buildPriority() {
  const flagged = radiusFlagged();
  const host = document.getElementById('prilist');
  host.innerHTML = '';
  S.priority = S.priority.filter(id => flagged.some(f => f.id === id));
  const intro = document.getElementById('pri-intro');
  const cnt = document.getElementById('pri-count');
  if (!flagged.length) {
    intro.textContent = 'You did not flag anything on the last page. That is a good result.';
    cnt.textContent = '';
    return;
  }
  intro.textContent = 'Pick up to three you would most want to be doing easily five years from now.';
  const card = el('div', 'quiz-system-card');
  flagged.forEach(r => {
    const b = el('button', 'quiz-opts-btn', r.label);
    b.type = 'button';
    b.style.cssText = 'width:100%;margin-bottom:8px;min-height:52px;font-size:13px;text-transform:none;letter-spacing:0;text-align:left;padding:14px 16px;';
    const isOn = () => S.priority.indexOf(r.id) >= 0;
    const paint = () => {
      b.setAttribute('aria-pressed', isOn() ? 'true' : 'false');
      b.classList.toggle('selected', isOn());
    };
    b.onclick = function() {
      const i = S.priority.indexOf(r.id);
      if (i >= 0) S.priority.splice(i, 1);
      else if (S.priority.length < 3) S.priority.push(r.id);
      save(); buildPriority();
    };
    paint();
    card.appendChild(b);
  });
  host.appendChild(card);
  cnt.textContent = S.priority.length + ' of 3 chosen';
}

/* ═════════════════════════════ BUILD RESULTS ═════════════════════════════ */
function buildResults() {
  const sc = document.getElementById('pane-screen');
  sc.innerHTML = '';
  const flagged = radiusFlagged();

  if (radiusAnswered()) {
    const rc = el('div', 'quiz-card');
    rc.appendChild(el('h3', 'quiz-card-subheading', 'The things you want to keep doing'));
    const applicable = DATA.radius.filter(r => S.radius[r.id] !== 'n' && S.radius[r.id] !== undefined).length;
    rc.appendChild(el('p', 'quiz-small', 'You noted changes in ' + flagged.length + ' of ' + applicable + ' activities.'));
    if (flagged.length) {
      const ul = el('div');
      ul.style.marginBottom = '12px';
      flagged.forEach(r => ul.appendChild(el('span', 'quiz-pill', r.label)));
      rc.appendChild(ul);
      const tally = {};
      flagged.forEach(r => r.sys.forEach(s => { tally[s] = (tally[s] || 0) + 1; }));
      const multi = Object.keys(tally).filter(k => tally[k] >= 2);
      if (multi.length) {
        const names = multi.map(k => { const s = sysById(k); return s ? s.label.toLowerCase() : k; });
        rc.appendChild(el('p', 'quiz-small', 'Several of these involve the same areas: ' + names.join(', ') + '.'));
      }
    }
    if (S.priority.length) {
      rc.appendChild(el('h3', 'quiz-card-subheading', 'What matters most to you'));
      const pl = el('div');
      pl.style.marginBottom = '8px';
      S.priority.forEach(id => {
        const r = DATA.radius.find(x => x.id === id);
        if (r) pl.appendChild(el('span', 'quiz-pill', r.label));
      });
      rc.appendChild(pl);
    }
    rc.appendChild(el('p', 'quiz-small', 'Changes like these have many causes, including things going on in your life. They are worth raising with a clinician.'));
    sc.appendChild(rc);
  }

  DATA.domains.forEach((dn, di) => {
    const card = el('div', 'quiz-card');
    card.appendChild(el('h3', 'quiz-card-subheading', dn));
    DATA.systems.forEach(sy => {
      if (sy.domain !== di) return;
      const s = sysScore(sy.id), b = band(s);
      const row = el('div', 'quiz-result-row');
      row.appendChild(el('div', 'quiz-result-name', sy.label));
      row.appendChild(el('div', 'quiz-result-tag quiz-tag-' + (b < 0 ? 0 : b), b < 0 ? 'Not answered' : BANDTXT[b]));
      card.appendChild(row);
    });
    sc.appendChild(card);
  });

  const moodScore = sysScore('mood');
  if (moodScore !== null && moodScore >= 5) {
    const mn = el('div', 'quiz-card');
    mn.appendChild(el('h3', 'quiz-card-subheading', 'One thing worth saying plainly'));
    mn.appendChild(el('p', 'quiz-small', 'Some of your answers describe low mood, lost interest or persistent worry. That is common, it is treatable, and it changes how everything else on this page feels. It is worth telling a doctor about even if nothing else here is.'));
    mn.appendChild(el('p', 'quiz-small', 'If things feel worse than that, you can call or text 988 in the US at any hour, or your local crisis line elsewhere.'));
    sc.appendChild(mn);
  }

  const d = el('div', 'quiz-note');
  d.textContent = 'This is not a diagnosis and it does not measure disease. It lists areas worth discussing with a clinician.';
  sc.appendChild(d);

  buildMeasured();
  buildHandoff();
}

function buildMeasured() {
  const me = document.getElementById('pane-measured');
  me.innerHTML = '';
  const safety = el('div', 'quiz-card');
  safety.appendChild(el('h3', 'quiz-card-subheading', 'Before anyone does the movement measurements'));
  safety.appendChild(el('p', 'quiz-small', 'Ask a doctor first if you have heart disease or chest pain on exertion, have fallen in the past six months, have osteoporosis or a fragility fracture, have had surgery in the last six months, feel dizzy on standing, or simply feel unwell today. Always do the balance and chair tests next to a wall or a partner who can steady you, never on your own.'));
  me.appendChild(safety);
  const mc = el('div', 'quiz-card');
  mc.appendChild(el('h3', 'quiz-card-subheading', 'Eight things you cannot measure properly at home'));
  mc.appendChild(el('p', 'quiz-small', 'Take this page to a clinician, or have them done at a measurement visit. Enter them here afterwards so next year has something to compare with.'));
  DATA.measured.forEach(m => {
    const r = el('div', 'quiz-measure-row');
    const L = el('div');
    L.appendChild(el('div', 'quiz-measure-label', m.label));
    L.appendChild(el('div', 'quiz-measure-how', m.how));
    if (m.ref) L.appendChild(el('div', 'quiz-measure-ref', m.ref));
    const inp = document.createElement('input');
    inp.type = 'text';
    inp.placeholder = m.unit;
    inp.value = S.measured[m.id] || '';
    inp.className = 'quiz-measure-input';
    inp.oninput = function() { S.measured[m.id] = inp.value.slice(0, 20); save(); };
    r.appendChild(L); r.appendChild(inp); mc.appendChild(r);
  });
  mc.appendChild(el('p', 'quiz-small', 'These reference points are population figures, not verdicts about you.'));
  me.appendChild(mc);

  /* Book-an-appointment bar — Figma 160:609 */
  const book = el('div', 'quiz-book-cta');
  const copy = el('div', 'quiz-book-cta-copy');
  copy.appendChild(el('p', 'quiz-book-cta-title', 'Not sure about these questions?'));
  copy.appendChild(el('p', 'quiz-book-cta-sub', 'Skip them and book an appointment with Athena Clinic.'));
  const bookBtn = el('a', 'quiz-book-cta-btn', 'Book an appointment');
  bookBtn.href = 'https://www.athenaclinic.com/contact/';
  bookBtn.target = '_blank';
  bookBtn.rel = 'noopener noreferrer';
  book.appendChild(copy);
  book.appendChild(bookBtn);
  me.appendChild(book);
}

function buildHandoff() {
  const h = document.getElementById('pane-handoff');
  h.innerHTML = '';
  const out = el('div', 'quiz-card');
  out.appendChild(el('h3', 'quiz-card-subheading', 'A summary for your clinician'));
  out.appendChild(el('p', 'quiz-small', 'Download or print stays on this device. Emailing the PDF sends it to you. We do not keep a copy of the file or of your answers.'));
