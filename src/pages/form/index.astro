function summaryText() {
  const L = [], nl = '\n';
  L.push('REBELLIOUS AGING CHECK-UP');
  L.push('Completed ' + new Date().toLocaleDateString());
  L.push('Self-reported. Not a diagnosis. Scores are 0-9 per area; higher means more reported difficulty.');
  if (S.priority.length) {
    L.push(''); L.push('WHAT I WANT TO KEEP DOING');
    S.priority.forEach(id => { const r = DATA.radius.find(x => x.id === id); if (r) L.push('  - ' + r.label); });
  }
  const flagged = radiusFlagged();
  if (flagged.length) {
    L.push(''); L.push('ACTIVITIES I HAVE CHANGED OR STOPPED');
    flagged.forEach(r => { L.push('  - ' + r.label + '  (' + (S.radius[r.id] === 2 ? 'no longer' : 'changed') + ')'); });
  }
  const ranked = DATA.systems.map(sy => ({ sy, s: sysScore(sy.id) })).filter(x => x.s !== null).sort((a,b) => b.s - a.s);
  const shown = ranked.filter(x => x.s >= 3);
  L.push(''); L.push('AREAS REPORTED, HIGHEST FIRST');
  if (!shown.length) L.push('  Nothing scored above the reporting threshold.');
  shown.forEach(x => { L.push('  ' + x.s + '/9  ' + x.sy.label + '  (' + DATA.domains[x.sy.domain] + ')'); });
  L.push(''); L.push('MEASUREMENTS');
  DATA.measured.forEach(m => { L.push('  ' + m.label + ': ' + (S.measured[m.id] || '________') + ' ' + m.unit); });
  L.push('');
  L.push('rebelliousaging.org  |  ' + BUILD + '  |  Produced on my own device; no answers were transmitted.');
  return L.join(nl);
}

function renderPrintable() {
  const p = document.getElementById('printable');
  p.innerHTML = '';

  /* Blank out browser-injected page-margin text (date, title, URL, page number).
     @page named margin boxes suppress Chrome/Edge/Safari's default content. */
  const blankPageStyle = document.createElement('style');
  blankPageStyle.textContent = [
    '@page {',
    '  @top-left   { content: ""; }',
    '  @top-center { content: ""; }',
    '  @top-right  { content: ""; }',
    '  @bottom-left   { content: ""; }',
    '  @bottom-center { content: ""; }',
    '  @bottom-right  { content: ""; }',
    '}'
  ].join('\n');
  p.appendChild(blankPageStyle);

  const w = el('div', 'rp-wrap');

  /* ── Header ── */
  const hdr = el('header', 'rp-header');
  const hdrRow = el('div', 'rp-header-row');
  hdrRow.appendChild(el('span', 'rp-brand', 'Rebellious Aging'));
  hdrRow.appendChild(el('span', 'rp-header-label', 'Clinical summary'));
  hdr.appendChild(hdrRow);
  const hdrMeta = el('div', 'rp-header-meta');
  hdrMeta.textContent = 'Completed ' + new Date().toLocaleDateString('en-US', { year:'numeric', month:'long', day:'numeric' }) + ' · Self-reported · Not a diagnosis · Scores 0–9 per area (higher = more reported difficulty)';
  hdr.appendChild(hdrMeta);
  w.appendChild(hdr);

  /* ── Disclaimer note ── */
  const note = el('p', 'rp-note');
  note.textContent = 'This document was produced on the patient\'s own device using a check-up tool at rebelliousaging.org. It is a structured self-report to support a clinical conversation. It is not a diagnostic instrument.';
  w.appendChild(note);

  /* ── Priorities ── */
  if (S.priority && S.priority.length) {
    const sec = el('section', 'rp-section');
    sec.appendChild(el('h2', 'rp-section-title', 'What this person wants to keep doing'));
    const pills = el('div', 'rp-pills');
    S.priority.forEach(id => {
      const r = DATA.radius.find(x => x.id === id);
      if (r) pills.appendChild(el('span', 'rp-pill', r.label));
    });
    sec.appendChild(pills);
    w.appendChild(sec);
  }

  /* ── Changed / stopped activities ── */
  const flagged = radiusFlagged();
  if (flagged.length) {
    const sec = el('section', 'rp-section');
    sec.appendChild(el('h2', 'rp-section-title', 'Activities changed or stopped'));
    flagged.forEach(r => {
      const row = el('div', 'rp-flag-row');
      row.appendChild(el('span', 'rp-flag-label', r.label));
      const stopped = S.radius[r.id] === 2;
      row.appendChild(el('span', 'rp-flag-tag ' + (stopped ? 'rp-tag-stopped' : 'rp-tag-changed'), stopped ? 'No longer' : 'Changed'));
      sec.appendChild(row);
    });
    w.appendChild(sec);
  }

  /* ── Areas flagged — sorted by score ── */
  const ranked = DATA.systems.map(sy => ({ sy, s: sysScore(sy.id) })).filter(x => x.s !== null).sort((a, b) => b.s - a.s);
  const flaggedSys = ranked.filter(x => x.s >= 3);
  const sec1 = el('section', 'rp-section');
  sec1.appendChild(el('h2', 'rp-section-title', 'Areas flagged, sorted by score'));
  if (!flaggedSys.length) {
    sec1.appendChild(el('p', 'rp-mini-na', 'Nothing scored above the reporting threshold (3/9).'));
  } else {
    flaggedSys.forEach(({ sy, s }) => {
      const row = el('div', 'rp-score-row');
      row.appendChild(el('div', 'rp-score-label', sy.label));
      row.appendChild(el('div', 'rp-score-domain', DATA.domains[sy.domain]));
      const barWrap = el('div', 'rp-score-bar-wrap');
      const bar = el('div', 'rp-score-bar' + (s >= 7 ? ' rp-bar-high' : s >= 5 ? ' rp-bar-mid' : ''));
      bar.style.width = Math.round(s / 9 * 100) + '%';
      barWrap.appendChild(bar);
      row.appendChild(barWrap);
      row.appendChild(el('div', 'rp-score-val', s + '/9'));
      sec1.appendChild(row);
    });
  }
  w.appendChild(sec1);

  /* ── All 32 systems — complete overview ── */
  const sec2 = el('section', 'rp-section');
  sec2.appendChild(el('h2', 'rp-section-title', 'All systems: complete overview'));
  DATA.domains.forEach((domain, di) => {
    const systems = DATA.systems.filter(sy => sy.domain === di);
    const domLabel = el('div', 'rp-domain-label', domain);
    sec2.appendChild(domLabel);
    systems.forEach(sy => {
      const s = sysScore(sy.id);
      const row = el('div', 'rp-mini-row');
      row.appendChild(el('span', 'rp-mini-label', sy.label));
      if (s !== null) {
        const bw = el('span', 'rp-mini-bar-wrap');
        const b = el('span', 'rp-mini-bar');
        b.style.width = Math.round(s / 9 * 100) + '%';
        bw.appendChild(b);
        row.appendChild(bw);
        row.appendChild(el('span', 'rp-mini-val', s + '/9'));
      } else {
        const na = el('span', 'rp-mini-na', 'not answered');
        na.style.gridColumn = '2 / 4';
        row.appendChild(na);
      }
      sec2.appendChild(row);
    });
  });
  w.appendChild(sec2);

  /* ── Measurements ── */
  const sec3 = el('section', 'rp-section');
  sec3.appendChild(el('h2', 'rp-section-title', 'Eight measurements to collect'));
  const measNote = el('p', 'rp-meas-note');
  measNote.textContent = 'These cannot be measured reliably at home. A free 20-minute measurement visit is available at Athena Clinic, Honolulu. rebelliousaging.org/measure';
  sec3.appendChild(measNote);
  const tbl = el('table', 'rp-table');
  const thead = el('thead');
  const headRow = el('tr');
  ['Test', 'How it is measured', 'Reference range', 'Result'].forEach(h => {
    const th = el('th'); th.textContent = h; headRow.appendChild(th);
  });
  thead.appendChild(headRow); tbl.appendChild(thead);
  const tbody = el('tbody');
  DATA.measured.forEach(m => {
    const tr = el('tr');
    tr.appendChild(el('td', 'rp-meas-name', m.label));
    tr.appendChild(el('td', null, m.how));
    const refTd = el('td', 'rp-meas-ref'); refTd.textContent = m.ref || '-'; tr.appendChild(refTd);
    const resultTd = el('td', 'rp-meas-result');
    resultTd.textContent = S.measured && S.measured[m.id] ? S.measured[m.id] + ' ' + m.unit : '________';
    tr.appendChild(resultTd);
    tbody.appendChild(tr);
  });
  tbl.appendChild(tbody);
  sec3.appendChild(tbl);
  w.appendChild(sec3);

  /* Footer removed — browser headers/footers suppressed via @page margin:0 */

  p.appendChild(w);
}

const PDF_FILENAME = 'rebellious-aging-check-up.pdf';
const HTML2PDF_SRC = 'https://cdn.jsdelivr.net/npm/html2pdf.js@0.10.1/dist/html2pdf.bundle.min.js';

function mailConfig() {
  const node = document.getElementById('quiz-mail-config');
  return {
    endpoint: (node && node.getAttribute('data-endpoint')) || '',
    site: (node && node.getAttribute('data-site')) || '',
    turnstileSitekey: (node && node.getAttribute('data-turnstile-sitekey')) || '',
  };
}

function loadHtml2Pdf() {
  if (window.html2pdf) return Promise.resolve(window.html2pdf);
  return new Promise(function(resolve, reject) {
    const existing = document.querySelector('script[data-html2pdf]');
    const done = function() {
      if (window.html2pdf) resolve(window.html2pdf);
      else reject(new Error('html2pdf failed to load'));
    };
    if (existing) {
      if (window.html2pdf) { resolve(window.html2pdf); return; }
      existing.addEventListener('load', done, { once: true });
      existing.addEventListener('error', function() { reject(new Error('html2pdf failed to load')); }, { once: true });
      return;
    }
    const script = document.createElement('script');
    script.src = HTML2PDF_SRC;
    script.async = true;
    script.dataset.html2pdf = 'true';
    script.addEventListener('load', done, { once: true });
    script.addEventListener('error', function() { reject(new Error('html2pdf failed to load')); }, { once: true });
    document.head.appendChild(script);
  });
}

function loadTurnstile() {
  if (window.turnstile) return Promise.resolve(window.turnstile);
  return new Promise(function(resolve, reject) {
    const ready = function() {
      if (window.turnstile) resolve(window.turnstile);
      else reject(new Error('Turnstile failed to load'));
    };
    const existing = document.querySelector('script[data-turnstile-api]');
    if (existing) {
      if (window.turnstile) { resolve(window.turnstile); return; }
      existing.addEventListener('load', ready, { once: true });
      existing.addEventListener('error', function() { reject(new Error('Turnstile failed to load')); }, { once: true });
      return;
    }
    const script = document.createElement('script');
    script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit';
    script.async = true;
    script.dataset.turnstileApi = 'true';
    script.addEventListener('load', ready, { once: true });
    script.addEventListener('error', function() { reject(new Error('Turnstile failed to load')); }, { once: true });
    document.head.appendChild(script);
  });
}

let handoffTurnstileId = '';

function renderHandoffTurnstile(slot) {
  const sitekey = mailConfig().turnstileSitekey;
  if (!slot || !sitekey) return;
  loadTurnstile().then(function(api) {
    if (!slot.isConnected) return;
    slot.innerHTML = '';
    handoffTurnstileId = api.render(slot, { sitekey });
  }).catch(function(err) { console.error(err); });
}

function blobToBase64(blob) {
  return new Promise(function(resolve, reject) {
    const reader = new FileReader();
    reader.onload = function() {
      const result = String(reader.result || '');
      const comma = result.indexOf(',');
      resolve(comma === -1 ? result : result.slice(comma + 1));
    };
    reader.onerror = reject;
    reader.readAsDataURL(blob);
  });
}

function downloadBlob(blob, filename) {
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = filename;
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  setTimeout(function() { URL.revokeObjectURL(url); }, 3000);
}

async function makePdfBlob() {
  renderPrintable();
  const node = document.getElementById('printable');
  const html2pdf = await loadHtml2Pdf();
  node.classList.add('pdf-capture');
  try {
    const source = node.querySelector('.rp-wrap') || node;
    return await html2pdf()
      .set({
        margin: 10,
        filename: PDF_FILENAME,
        image: { type: 'jpeg', quality: 0.92 },
        html2canvas: { scale: 1.5, useCORS: true, backgroundColor: '#ffffff' },
        jsPDF: { unit: 'mm', format: 'a4', orientation: 'portrait' },
        pagebreak: { mode: ['css', 'legacy'] },
      })
      .from(source)
      .outputPdf('blob');
  } finally {
    node.classList.remove('pdf-capture');
  }
}

async function emailSummaryPdf() {
  const emailInput = document.getElementById('handoff-email');
  const msg = document.getElementById('handoff-mail-msg');
  const btn = document.getElementById('btn-email-pdf');
  const cfg = mailConfig();
  const email = (emailInput && emailInput.value || '').trim();

  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
    if (msg) msg.textContent = 'That does not look like an email address.';
    return;
  }
  if (!cfg.endpoint || !cfg.site) {
    if (msg) msg.textContent = 'Email is not configured. Download or print instead.';
    return;
  }

  const turnstile = window.turnstile;
  const token = handoffTurnstileId && turnstile ? turnstile.getResponse(handoffTurnstileId) : '';
  if (!token) {
    if (msg) msg.textContent = 'Complete the spam check first.';
    return;
  }

  if (btn) btn.disabled = true;
  if (msg) msg.textContent = 'Preparing PDF…';

  let downloaded = false;
  try {
    const blob = await makePdfBlob();
    downloadBlob(blob, PDF_FILENAME);
    downloaded = true;
    if (msg) msg.textContent = 'Sending…';
    const pdf = await blobToBase64(blob);
    const res = await fetch(cfg.endpoint, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
      body: JSON.stringify({
        site: cfg.site,
        email: email,
        filename: PDF_FILENAME,
        pdf: pdf,
        turnstileToken: token,
      }),
    });
    const payload = await res.json().catch(function() { return null; });
    if (res.ok && payload && payload.ok) {
      if (msg) msg.textContent = 'Sent. A copy also downloaded to this device. We did not keep the file.';
    } else {
      throw new Error((payload && payload.error) || 'send failed');
    }
  } catch (err) {
    console.error(err);
    const detail = err && err.message ? String(err.message) : '';
    const known = /limit|spam|valid email|too large|Missing PDF/i.test(detail);
    if (msg) {
      if (known) msg.textContent = detail;
      else if (downloaded) msg.textContent = 'Could not email it. The PDF still downloaded. Attach that, or use Download / Print.';
      else msg.textContent = 'Could not build the PDF. Use Download / Print instead.';
    }
  } finally {
    if (btn) btn.disabled = false;
    if (handoffTurnstileId && window.turnstile) {
      try { window.turnstile.reset(handoffTurnstileId); } catch (e) {}
    }
  }
}

/* ═════════════════════════════ NAVIGATION ═════════════════════════════ */
const ORDER = ['home','dom0','dom1','dom2','dom3','dom4','dom5','radius','priority','results'];
const SECTION_TABS = ['screen','measured','handoff'];
const SECTION_NAMES = ['What you told us','To be measured','For your doctor'];
let at = 0;

/* ── Sync quiz-main padding-top to actual header height ── */
function syncMainPadding(isHome) {
  const header = document.getElementById('quiz-header');
  const main   = document.getElementById('quiz-main');
  if (!header || !main) return;
  main.style.paddingTop = isHome ? '0px' : (header.offsetHeight + 'px');
}

function show(i) {
  at = Math.max(0, Math.min(ORDER.length - 1, i));
  const cur = ORDER[at];

  ORDER.forEach(id => {
    const e = document.getElementById('sc-' + id);
    if (e) e.classList.toggle('on', id === cur);
  });

  /* Header visibility */
  const header = document.getElementById('quiz-header');
  const isHome = cur === 'home';
  const isResults = cur === 'results';
  header.classList.toggle('hidden', isHome);

  /* Question fill bar only — labels stay on Results */
  const track = document.getElementById('prog-track');
  if (track) track.classList.toggle('hidden', isResults);

  /* Bottom nav */
  const nav = document.getElementById('nav');
  nav.classList.toggle('hidden', isHome);

  /* main padding top: always matches actual rendered header height so content never hides under it */
  const main = document.getElementById('quiz-main');
  syncMainPadding(isHome);

  /* Update header progress */
  updateHeaderForScreen(cur);

  if (cur === 'radius') buildRadius();
  if (cur === 'priority') buildPriority();
  if (cur === 'results') {
    S.finished = Date.now(); save();
    buildResults();
    switchTab('screen', false);
  } else {
    syncNav();
  }

  updateProgress();
  document.getElementById('quiz-main').scrollTo(0, 0);
}

function updateHeaderForScreen(cur) {
  const progSection = document.getElementById('prog-section');
  const progTab = document.getElementById('prog-tab');

  if (cur.startsWith('dom')) {
    const di = parseInt(cur.replace('dom',''));
    progSection.textContent = 'Section ' + (di+1) + ' of 6';
    progTab.textContent = DATA.domains[di];
  } else if (cur === 'radius') {
    progSection.textContent = 'Last section';
    progTab.textContent = 'Activities';
  } else if (cur === 'priority') {
    progSection.textContent = 'Almost done';
    progTab.textContent = 'Priorities';
  } else if (cur === 'results') {
    progSection.textContent = 'Results';
    progTab.textContent = 'Your check-up';
  }
}

function updateProgress() {
  const total = 96 + 16;
  const done = answeredCount() + radiusAnswered();
  const pct = Math.round(done / total * 100);
  /* Two-div bar: fill shrinks-to-width, remaining takes the rest */
  const fillEl = document.getElementById('prog-fill');
  const remainEl = document.getElementById('prog-remaining');
  if (fillEl) fillEl.style.width = pct + '%';
  if (remainEl) remainEl.style.display = pct >= 100 ? 'none' : '';
  document.getElementById('prog-count').textContent = done + ' of ' + total + ' answered';
}

/* Current result step index — based on which pane is visible */
function curTab() {
  return SECTION_TABS.findIndex(t => {
    const pane = document.getElementById('pane-' + t);
    return pane && pane.classList.contains('on');
  });
}

function switchTab(name, scroll) {
  SECTION_TABS.forEach(t => {
    document.getElementById('pane-' + t).classList.toggle('on', t === name);
  });
  syncNav();
  if (scroll) {
    document.getElementById('quiz-main').scrollTo(0, 0);
  }
}

const NAV_ARROW = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true" style="flex-shrink:0"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>';

function syncNav() {
  const cur = ORDER[at];
  const nextBtn = document.getElementById('btn-next');
  const homeBtn = document.getElementById('btn-home');
  const backBtn = document.getElementById('btn-back');

  backBtn.classList.toggle('hidden', at <= 1);

  if (cur === 'results') {
    const last = curTab() === SECTION_TABS.length - 1;
    nextBtn.classList.toggle('hidden', last);
    if (homeBtn) homeBtn.classList.toggle('hidden', !last);
    if (!last) nextBtn.innerHTML = 'Next ' + NAV_ARROW;
    return;
  }

  nextBtn.classList.remove('hidden');
  if (homeBtn) homeBtn.classList.add('hidden');
  nextBtn.innerHTML = (cur === 'priority' ? 'See my results' : 'Next') + ' ' + NAV_ARROW;
}

/* Opt-in */
function submitOptIn() {
  const email = document.getElementById('optin-email').value.trim();
  const name = document.getElementById('optin-name').value.trim();
  const msg = document.getElementById('optin-msg');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) { msg.textContent = 'That does not look like an email address.'; return; }
  const payload = { email, first_name: name || null, source: 'direct', consent_at: new Date().toISOString() };
  msg.textContent = 'Sending…';
  fetch(OPTIN_ENDPOINT, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) })
    .then(r => { msg.textContent = r.ok ? 'Thank you. We will remind you in twelve months.' : 'That did not send. Your answers are still safe on this device.'; })
    .catch(() => { msg.textContent = 'That did not send. Your answers are still safe on this device.'; });
}

/* ═════════════════════════════ BOOT ═════════════════════════════ */
/* Fire on both hard load and Astro view-transition navigation */
function boot() {
  for (let i = 0; i < 6; i++) buildDomain(i);

  /* Keep padding-top in sync whenever the header height might change */
  window.addEventListener('resize', () => {
    const isHome = ORDER[at] === 'home';
    syncMainPadding(isHome);
  });

  /* Smart context-aware nav — one handler for the whole quiz lifetime */
  document.getElementById('btn-next').onclick = function() {
    if (ORDER[at] === 'results') {
      const i = curTab();
      if (i < SECTION_TABS.length - 1) switchTab(SECTION_TABS[i + 1], true);
    } else {
      show(at + 1);
    }
  };
  document.getElementById('btn-back').onclick = function() {
    if (ORDER[at] === 'results') {
      const i = curTab();
      if (i > 0) switchTab(SECTION_TABS[i - 1], true);
      else show(ORDER.indexOf('priority')); /* back to priority from step 1 */
    } else {
      show(at - 1);
    }
  };

  /* Ack checkbox */
  const ackBox = document.getElementById('ack');
  function syncAck() {
    const ok = ackBox.checked;
    document.getElementById('btn-start').disabled = !ok;
    const resumeBtn = document.getElementById('btn-resume');
    if (resumeBtn) resumeBtn.disabled = !ok;
  }
  if (S.ack) ackBox.checked = true;
  ackBox.onchange = function() { S.ack = ackBox.checked; save(); syncAck(); };
  syncAck();

  document.getElementById('btn-start').onclick = function() {
    if (!ackBox.checked) return;
    if (!S.started) { S.started = Date.now(); save(); }
    show(1);
  };
  document.getElementById('btn-resume').onclick = function() {
    if (!ackBox.checked) return;
    show(1);
  };

  if (answeredCount() > 0) {
    document.getElementById('btn-resume').classList.remove('hidden');
  }

  /* Opt-in */
  document.getElementById('btn-optin').onclick = submitOptIn;

  /* Step indicator dots are non-clickable — navigation is via main Back / Next buttons */

  /* Page prev/next */
  /* btn-pageprev / btn-pagenext no longer exist — results use main nav via switchTab() */

  /* Share/save card removed — handlers no longer needed */

  function saveTxt(txt) {
    try {
      const b = new Blob([txt], { type: 'text/plain' }), u = URL.createObjectURL(b);
      const a = document.createElement('a'); a.href = u;
      a.download = 'rebellious-aging-check-up.txt'; document.body.appendChild(a); a.click();
      document.body.removeChild(a); setTimeout(() => URL.revokeObjectURL(u), 3000);
      say('Saved to your downloads.');
    } catch(e) { say('Could not save automatically. Use Print instead.'); }
  }

  /* Delete / erase — two-step confirm */
  const eraseBtn = document.getElementById('btn-erase');
  const eraseMsg = document.getElementById('erase-msg');
  let armed = false, armTimer = null;
  function disarm() {
    armed = false;
    eraseBtn.classList.remove('armed');
    eraseBtn.innerHTML = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z" stroke="white" stroke-width="2" stroke-linecap="round"/></svg> Delete';
    eraseMsg.textContent = '';
  }
  eraseBtn.onclick = function() {
    if (!armed) {
      armed = true; eraseBtn.classList.add('armed');
      eraseBtn.textContent = 'Tap again to confirm';
      eraseMsg.textContent = 'This cannot be undone.';
      clearTimeout(armTimer); armTimer = setTimeout(disarm, 8000); return;
    }
    clearTimeout(armTimer);
    try { localStorage.removeItem('ra_fleet_v1'); } catch(e) {}
    location.reload();
  };

  /* Build ID */
  document.getElementById('buildid').textContent = 'Build ' + BUILD;

  show(0);
}

/* Hard load */
document.addEventListener('DOMContentLoaded', boot);
/* Astro view-transition navigation (soft load) */
document.addEventListener('astro:page-load', boot);
</script>
