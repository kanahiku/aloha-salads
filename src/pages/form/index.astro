---
import Layout from '~/layouts/Layout.astro';
import { EMAIL_SUMMARY_ENDPOINT, SITE_SLUG, TURNSTILE_SITE_KEY } from '~/lib/forms';

const metadata = {
  title: 'Rebellious Aging Check-up',
  description: 'A private 32-system self-check. Your answers never leave your device.',
  robots: 'noindex,nofollow',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Full-screen immersive quiz — no site nav -->
  <div id="quiz-root">
    <!-- TODO: replace with <Image> when asset is ready -->
    <div class="quiz-bg bg-section-grey" aria-hidden="true"></div>
    <div class="quiz-overlay" aria-hidden="true"></div>

    <!-- ═══════════════════════════════════ PROGRESS HEADER ═══════════════════════════════════ -->
    <!-- Sits outside <main> so it's always above compositing layers from backdrop-filter cards -->
    <header class="quiz-header hidden" id="quiz-header">
      <div class="quiz-header-inner">
        <div class="quiz-progress-row">
          <span class="quiz-prog-left" id="prog-section">Section 1 of 6</span>
          <span class="quiz-prog-center" id="prog-tab">Movement and structure</span>
          <span class="quiz-prog-right" id="prog-count">0 of 112 answered</span>
        </div>
        <div class="quiz-progress-track" id="prog-track">
          <div class="quiz-progress-fill" id="prog-fill"></div>
          <div class="quiz-progress-remaining" id="prog-remaining"></div>
        </div>
      </div>
    </header>

    <!-- ═══════════════════════════════════ SCREENS ══════════════════════════════════ -->
    <main class="quiz-main" id="quiz-main">

      <!-- HOME SCREEN -->
      <section class="quiz-screen on quiz-home-screen" id="sc-home">
        <div class="quiz-home-card">
          <!-- Eyebrow -->
          <p class="quiz-home-eyebrow">Thirty two systems, one check up</p>
          <!-- Heading -->
          <h1 class="quiz-home-heading">Nobody ages all at once.</h1>
          <!-- Body -->
          <p class="quiz-home-body">You have thirty-two biological ages and they disagree. This asks about the things you can already notice, and the things you have quietly stopped mentioning.</p>

          <!-- Start CTA -->
          <button class="quiz-btn-start" id="btn-start" disabled>
            Start the Checkup
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
          <button class="quiz-btn-resume hidden" id="btn-resume">Continue where I left off</button>

          <!-- Feature pills -->
          <div class="quiz-home-features">
            <span class="quiz-home-feature">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="1.5"/><path d="M12 6v6l4 2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
              15 mins
            </span>
            <span class="quiz-home-feature">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6v-8z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              Print ready results for clinicians
            </span>
          </div>

          <!-- Stop list disclosure -->
          <details class="quiz-stop-details">
            <summary class="quiz-stop-summary">⚠ Important: read before starting</summary>
            <div class="quiz-stop-body">
              <p>Put this down and contact a doctor today if any of these applies right now:</p>
              <ul>
                <li>Chest pain, pressure or tightness, especially on exertion</li>
                <li>Fainting, blacking out, or near-fainting</li>
                <li>New or sudden weakness, numbness, drooping or difficulty speaking</li>
                <li>Sudden loss or distortion of vision in either eye</li>
                <li>Coughing up blood, or blood in stool or urine</li>
                <li>Unintentional weight loss of more than 10 lb without trying</li>
                <li>A fall that caused injury, or repeated falls</li>
                <li>A new or rapidly changing mole, lump or skin lesion</li>
                <li>Sudden hearing loss in one ear</li>
                <li>New confusion, or a sharp change in memory over weeks rather than years</li>
                <li>Thoughts of harming yourself</li>
              </ul>
              <p><strong>In the US you can call or text 988 at any hour.</strong></p>
            </div>
          </details>

          <!-- Acknowledgement checkbox -->
          <label class="quiz-ack-row">
            <input type="checkbox" id="ack" class="quiz-checkbox">
            <span>I have read the list above, none of it applies to me right now, and I understand this is a check-up and not a diagnosis.</span>
          </label>

          <!-- Disclaimer -->
          <p class="quiz-home-disclaimer">No account. No server. No analytics. You can delete everything with one button at the end.</p>
        </div>
      </section>

      <!-- DOMAIN SECTIONS 0-5 -->
      <section class="quiz-screen" id="sc-dom0"><div id="dom0"></div></section>
      <section class="quiz-screen" id="sc-dom1"><div id="dom1"></div></section>
      <section class="quiz-screen" id="sc-dom2"><div id="dom2"></div></section>
      <section class="quiz-screen" id="sc-dom3"><div id="dom3"></div></section>
      <section class="quiz-screen" id="sc-dom4"><div id="dom4"></div></section>
      <section class="quiz-screen" id="sc-dom5"><div id="dom5"></div></section>

      <!-- RADIUS SECTION -->
      <section class="quiz-screen" id="sc-radius">
        <div class="quiz-section-intro">
          <p class="quiz-small" style="opacity:0.75">Everyone adjusts how they do things over time. Tell us where you are now. There are no wrong answers here. <strong>Answer from memory. Please do not try any of these out to find out, and never on your own.</strong></p>
        </div>
        <div id="radlist"></div>
      </section>

      <!-- PRIORITY SECTION -->
      <section class="quiz-screen" id="sc-priority">
        <div class="quiz-section-intro">
          <p class="quiz-small" id="pri-intro"></p>
          <p class="quiz-priority-count" id="pri-count"></p>
        </div>
        <div id="prilist"></div>
      </section>

      <!-- RESULTS SECTION -->
      <section class="quiz-screen" id="sc-results">
        <!-- Panes — 3 only, trend removed -->
        <div class="quiz-pane on" id="pane-screen"></div>
        <div class="quiz-pane" id="pane-measured"></div>
        <div class="quiz-pane" id="pane-handoff"></div>

        <!-- Share card removed per request -->

        <!-- Email reminder card -->
        <div class="quiz-card">
          <h3 class="quiz-card-subheading">A reminder in twelve months</h3>
          <p class="quiz-small" style="opacity:0.75;margin-bottom:16px">One set of answers puts you on a curve. Two give it a slope. If you would like a reminder, give us an email address. It is stored on its own and is never joined to anything you answered here.</p>
          <div class="quiz-field">
            <label class="quiz-field-label">First name (optional)</label>
            <input type="text" id="optin-name" placeholder="Your first name…" autocomplete="given-name" class="quiz-input">
          </div>
          <div class="quiz-field">
            <label class="quiz-field-label">Email</label>
            <input type="email" id="optin-email" placeholder="your@email.com" autocomplete="email" inputmode="email" class="quiz-input">
          </div>
          <button class="quiz-btn-primary" id="btn-optin" type="button">Remind me in a year</button>
          <p class="quiz-small" id="optin-msg" style="margin-top:8px;opacity:0.6"></p>
        </div>

        <!-- Delete card -->
        <div class="quiz-card quiz-delete-card">
          <div class="quiz-delete-inner">
            <div>
              <h3 class="quiz-card-subheading">Delete everything?</h3>
              <p class="quiz-small" style="opacity:0.75">Removes every answer from this device. Nothing was sent anywhere else.</p>
            </div>
            <button class="quiz-delete-btn" id="btn-erase" type="button">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 6h18M8 6V4a1 1 0 011-1h6a1 1 0 011 1v2m3 0v14a2 2 0 01-2 2H7a2 2 0 01-2-2V6h14z" stroke="white" stroke-width="2" stroke-linecap="round"/></svg>
              Delete
            </button>
          </div>
          <p class="quiz-small" id="erase-msg" style="margin-top:8px;opacity:0.6"></p>
        </div>

        <p class="quiz-small" style="text-align:center;opacity:0.35;margin-top:20px;padding-bottom:80px" id="buildid"></p>
      </section>

    </main>

    <!-- ═══════════════════════════════════ BOTTOM NAV ════════════════════════════════ -->
    <nav class="quiz-nav hidden" id="nav" aria-label="Quiz navigation">
      <div class="quiz-nav-inner">
        <button class="quiz-nav-back hidden" id="btn-back" type="button">
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M19 12H5M12 5l-7 7 7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          Back
        </button>
        <a class="quiz-nav-continue hidden" id="btn-home" href="/">
          Home
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 10.5L12 3l9 7.5V20a1 1 0 01-1 1h-5v-6H9v6H4a1 1 0 01-1-1v-9.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
        <button class="quiz-nav-continue" id="btn-next" type="button">
          Next
          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </nav>

  </div>

  <!-- Print-only summary — outside quiz-root so it is not hidden by it -->
  <div id="printable"></div>
  <div
    id="quiz-mail-config"
    hidden
    data-endpoint={EMAIL_SUMMARY_ENDPOINT}
    data-site={SITE_SLUG}
    data-turnstile-sitekey={TURNSTILE_SITE_KEY}
  ></div>
</Layout>

<style is:global>
  /* Override Layout body styles for the immersive quiz */
  body:has(#quiz-root) {
    background: #0a1318;
    overflow: hidden;
    padding: 0;
    margin: 0;
  }

  /* ══════════════════════════════════════════
     QUIZ SHELL
  ══════════════════════════════════════════ */
  #quiz-root {
    position: fixed;
    inset: 0;
    overflow: hidden;
    font-family: var(--aw-font-sans, 'Hanken Grotesk', sans-serif);
    color: #f5f4ef;
  }

  /* Background photo */
  .quiz-bg {
    position: absolute;
    inset: 0;
    background-size: cover;
    background-position: center 30%;
    background-repeat: no-repeat;
    z-index: 0;
  }
  .quiz-overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(10,19,24,0.55) 0%, rgba(10,19,24,0.35) 40%, rgba(10,19,24,0.65) 100%),
      linear-gradient(to right, rgba(0,0,0,0.25), rgba(0,0,0,0));
    z-index: 1;
  }

  /* ══════════════════════════════════════════
     PROGRESS HEADER — Figma node 128-3043
     Transparent, no background — photo shows through
  ══════════════════════════════════════════ */
  .quiz-header {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 200;
    /* Solid dark tint — no backdrop-filter, avoids compositing layer conflicts */
    background: rgba(10, 19, 24, 0.82);
    padding: 14px 20px 12px;
  }
  .quiz-header.hidden { display: none; }
  .quiz-header-inner {
    max-width: 680px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 10px; /* Figma: gap-[10px] */
  }

  /* 3-column text row */
  .quiz-progress-row {
    display: flex;
    align-items: center;
    width: 100%;
  }
  /* Left: "Section X of 6" — 12px, muted, uppercase, tracking 0.72px */
  .quiz-prog-left {
    flex: 1;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em; /* 0.72px / 12px */
    text-transform: uppercase;
    color: rgba(245,244,239,0.4);
    line-height: 1;
  }
  /* Center: "Movement and structure" — 14px, medium, white, tracking 0.84px */
  .quiz-prog-center {
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.06em; /* 0.84px / 14px */
    text-transform: uppercase;
    color: #f5f4ef;
    text-align: center;
    white-space: nowrap;
    line-height: 1;
  }
  /* Right: "0 of 112 answered" — 12px, muted, uppercase, text-right */
  .quiz-prog-right {
    flex: 1;
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245,244,239,0.4);
    text-align: right;
    line-height: 1;
  }

  /* Progress bar: two divs — filled (#2c4a5b) + remaining (#7ba3bd) */
  .quiz-progress-track {
    display: flex;
    align-items: flex-start;
    width: 100%;
    height: 4px;
    border-radius: 300px;
    overflow: clip; /* Figma: overflow-clip */
  }
  .quiz-progress-fill {
    height: 4px;
    background: #2c4a5b;
    transition: width 0.3s ease;
    flex-shrink: 0;
    /* starts at 0, grows via inline width style */
  }
  .quiz-progress-remaining {
    flex: 1;
    min-width: 1px;
    height: 4px;
    background: #7ba3bd;
  }

  /* ══════════════════════════════════════════
     MAIN SCROLL AREA
  ══════════════════════════════════════════ */
  .quiz-main {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
    z-index: 5;
    /* padding-top is set dynamically by JS to match the actual header height */
    padding-bottom: 88px;
  }
  .quiz-screen {
    display: none;
    max-width: 680px;
    margin: 0 auto;
    padding: 16px 20px 32px;
  }
  .quiz-screen.on { display: block; }

  /* ══════════════════════════════════════════
     HOME SCREEN
  ══════════════════════════════════════════ */
  .quiz-home-screen {
    min-height: calc(100vh - 88px);
    display: none;
    align-items: center;
    justify-content: center;
    padding-top: 32px;
    padding-bottom: 32px;
  }
  .quiz-home-screen.on {
    display: flex;
    flex-direction: column;
  }
  .quiz-home-card {
    width: 100%;
    max-width: 620px;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 32px;
    padding: 40px 36px 32px;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .quiz-home-eyebrow {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245,244,239,0.5);
    margin: 0 0 16px;
    text-align: center;
  }
  .quiz-home-heading {
    font-family: var(--aw-font-serif, 'Fraunces', serif);
    font-size: clamp(36px, 7vw, 52px);
    font-weight: 300;
    line-height: 1.1;
    color: #ffffff;
    margin: 0 0 16px;
    text-align: center;
  }
  .quiz-home-body {
    font-size: 16px;
    line-height: 1.6;
    color: rgba(245,244,239,0.8);
    text-align: center;
    margin: 0 0 28px;
  }

  /* Start CTA */
  .quiz-btn-start {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 56px;
    border: none;
    border-radius: 12px;
    background: #2c4a5b;
    color: #fff;
    font-family: inherit;
    font-size: 16px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.15s, opacity 0.15s;
    margin-bottom: 10px;
  }
  .quiz-btn-start:hover:not(:disabled) { background: #3a5f73; }
  .quiz-btn-start:disabled { opacity: 0.4; cursor: default; }

  /* Resume button */
  .quiz-btn-resume {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 48px;
    border: 1px solid rgba(245,244,239,0.3);
    border-radius: 12px;
    background: transparent;
    color: #f5f4ef;
    font-family: inherit;
    font-size: 15px;
    font-weight: 400;
    cursor: pointer;
    transition: background 0.15s;
    margin-bottom: 20px;
  }
  .quiz-btn-resume:hover { background: rgba(255,255,255,0.06); }

  /* Feature pills row */
  .quiz-home-features {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    margin-bottom: 24px;
    flex-wrap: wrap;
  }
  .quiz-home-feature {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    color: rgba(245,244,239,0.6);
  }
  .quiz-home-feature svg { flex-shrink: 0; opacity: 0.7; }

  /* Stop disclosure */
  .quiz-stop-details {
    border: 1px solid rgba(163,35,27,0.3);
    border-radius: 12px;
    padding: 14px 16px;
    margin-bottom: 20px;
    background: rgba(163,35,27,0.07);
  }
  .quiz-stop-summary {
    font-size: 13px;
    font-weight: 500;
    color: #e57373;
    cursor: pointer;
    list-style: none;
    user-select: none;
  }
  .quiz-stop-summary::-webkit-details-marker { display: none; }
  .quiz-stop-body {
    margin-top: 12px;
    font-size: 12px;
    line-height: 1.55;
    color: rgba(245,244,239,0.75);
  }
  .quiz-stop-body p { margin-bottom: 8px; }
  .quiz-stop-body ul {
    list-style: none;
    padding: 0;
    margin: 8px 0;
  }
  .quiz-stop-body ul li {
    position: relative;
    padding: 3px 0 3px 14px;
  }
  .quiz-stop-body ul li::before {
    content: '';
    position: absolute;
    left: 2px;
    top: 10px;
    width: 5px;
    height: 5px;
    background: #e57373;
    border-radius: 2px;
  }

  /* Ack checkbox */
  .quiz-ack-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    font-size: 13px;
    line-height: 1.5;
    color: rgba(245,244,239,0.85);
    cursor: pointer;
    margin-bottom: 20px;
  }
  .quiz-checkbox {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    margin-top: 1px;
    accent-color: #7ba3bd;
    cursor: pointer;
    border-radius: 4px;
  }

  /* Home disclaimer */
  .quiz-home-disclaimer {
    font-size: 12px;
    line-height: 1.5;
    color: rgba(245,244,239,0.4);
    text-align: center;
    margin: 0;
  }

  /* ══════════════════════════════════════════
     SECTION INTRO (radius / priority screens)
  ══════════════════════════════════════════ */
  .quiz-section-intro {
    margin-bottom: 16px;
    padding: 0 4px;
  }

  /* ══════════════════════════════════════════
     QUESTION CARDS
  ══════════════════════════════════════════ */
  .quiz-system-card {
    background: rgba(0,0,0,0.35);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid rgba(255,255,255,0.1);
    border-radius: 24px;
    padding: 20px 16px 20px;
    margin-bottom: 12px;
  }

  /* System name header row */
  .quiz-system-name {
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(245,244,239,0.5);
    padding-bottom: 8px;
    border-bottom: 1px solid rgba(245,244,239,0.5);
    margin-bottom: 24px;
    opacity: 1; /* already low-opacity via color */
  }

  /* Individual question block */
  .quiz-question {
    padding-bottom: 24px;
    border-bottom: 1px solid rgba(248,247,243,0.15);
    margin-bottom: 24px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .quiz-question:last-child {
    padding-bottom: 0;
    border-bottom: none;
    margin-bottom: 0;
  }

  /* Question stem */
  .quiz-q-stem {
    font-size: 16px;
    line-height: 1.4;
    color: #f5f4ef;
    font-weight: 400;
    margin-bottom: 12px;
  }

  /* Answer buttons — horizontal 4-up */
  .quiz-opts {
    display: flex;
    gap: 8px;
    align-items: stretch;
  }
  .quiz-opts-btn {
    flex: 1;
    min-width: 0;
    min-height: 64px;
    border: 1.5px solid rgba(248,247,243,0.3);
    background: rgba(255,255,255,0.06);
    border-radius: 10px;
    font-family: var(--aw-font-sans, 'Hanken Grotesk', sans-serif);
    font-size: 13px;
    font-weight: 500;
    color: rgba(245,244,239,0.9);
    cursor: pointer;
    padding: 10px 8px;
    text-align: center;
    transition: background 0.12s, border-color 0.12s, color 0.12s;
    line-height: 1.3;
  }
  .quiz-opts-btn:hover {
    background: rgba(255,255,255,0.12);
    border-color: rgba(248,247,243,0.5);
  }
  .quiz-opts-btn.selected,
  .quiz-opts-btn[aria-pressed="true"] {
    background: #567f9b;
    border-color: #567f9b;
    color: #fff;
    font-weight: 600;
  }

  /* Radius — 3 options in a horizontal row */
  .quiz-opts-three {
    display: flex;
    flex-direction: row;
    gap: 8px;
  }
  .quiz-opts-three .quiz-opts-btn {
    flex: 1;
    min-width: 0;
    font-size: 13px;
    font-weight: 500;
    min-height: 64px;
    text-align: center;
    padding: 10px 6px;
  }

  /* N/A option — full-width below the 3-up row, same border style as others */
  .quiz-opts-na {
    margin-top: 8px;
    display: flex;
  }
  .quiz-opts-na .quiz-opts-btn {
    flex: 1;
    min-height: 52px;
    font-size: 13px;
    font-weight: 500;
    text-align: center;
    padding: 10px 14px;
    /* Same solid border as the other options — no dashes */
    border-style: solid;
    border-color: rgba(248,247,243,0.3);
    color: rgba(245,244,239,0.7);
    background: rgba(255,255,255,0.04);
  }
