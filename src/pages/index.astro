---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BrandBar from '~/components/widgets/BrandBar.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import Locations from '~/components/widgets/Locations.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { escapeHtml, textToHtml } from '~/lib/content/richText';
import { getSanityHomepageImages, getSanityHomepageContent } from '~/lib/content/sanity';
import { getStoreLocations } from '~/lib/content/locationContent';

const [homepageImages, content, stores] = await Promise.all([
  getSanityHomepageImages(),
  getSanityHomepageContent(),
  getStoreLocations(),
]);

// Copy comes from Sanity as plain text; Hero2 renders title/subtitle as HTML, so escape it first.
const heroTitleHtml = textToHtml(content.hero.title);
// Hero background is chosen in Sanity (Homepage → "Hero background"). Image OR video, never both;
// `heroVideo` is only set when video is selected and its file + poster are uploaded, otherwise
// the hero falls back to the photo.
const heroVideo = homepageImages.heroMedia === 'video' ? homepageImages.heroVideo : undefined;

const metadata = {
  title: content.meta.title,
  description: content.meta.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    id="home-hero"
    variant="overlay"
    overlapHeader={false}
    tagline={escapeHtml(content.hero.tagline)}
    title={heroTitleHtml}
    subtitle={escapeHtml(content.hero.subtitle)}
    {...heroVideo ? { video: heroVideo } : { image: homepageImages.hero }}
    actions={[
      { variant: 'primary', text: content.hero.primaryCtaLabel, href: PRIMARY_CTA_HREF },
      { variant: 'ghost', text: content.hero.secondaryCtaLabel, href: CATERING_CTA_HREF },
    ]}
  />

  {/* ── 2. Brand bar ─────────────────────────────────────── */}
  <BrandBar items={content.brandBar} />

  {/* ── 3. Menu categories ───────────────────────────────── */}
  <MenuCategories
    eyebrow={content.menu.eyebrow}
    title={content.menu.title}
    subtitle={content.menu.subtitle}
    ctaText={content.menu.ctaLabel}
    ctaHref="/menu"
    maxRows={2}
  />

  {/* ── 4. Local sourcing — text only, same layout as menu subpages ── */}
  <LocalSourcing
    eyebrow="Local sourcing"
    title="Our Local Sourcing"
    subtitle="We partner with Hawaii growers and suppliers to bring quality ingredients into our kitchens. We feature vine-ripe tomatoes from Hauula and exclusively use never-frozen local ahi sourced through a Honolulu seafood supplier with vessel-level catch traceability."
    ctaText="Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={false}
  />

  {/* ── 5. Testimonials — fetched from Sanity ────────────── */}
  <Testimonials id="reviews" eyebrow={content.reviews.eyebrow} heading={content.reviews.title} />

  {/* ── 6. Locations ─────────────────────────────────────── */}
  <Locations
    id="locations"
    eyebrow={content.locations.eyebrow}
    title={content.locations.title}
    subtitle={content.locations.subtitle}
    ctaText={content.locations.ctaLabel}
    ctaHref="/locations"
    viewLabel={content.locations.viewLabel}
    locations={stores.slice(0, 4)}
    image={homepageImages.locations}
  />

  {/* ── 7. Salad builder — hidden (not in copy brief) ───── */}
  {/* <SaladBuilder id="salad-builder" /> */}

  {/* ── 8. Our story — hidden (not in copy brief) ─────── */}
  {/* <OurStory id="our-story" /> */}
</Layout>
