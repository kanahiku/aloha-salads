---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BrandBar from '~/components/widgets/BrandBar.astro';
import FeaturedDishes from '~/components/widgets/FeaturedDishes.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import SaladBuilder from '~/components/widgets/SaladBuilder.astro';
import Locations from '~/components/widgets/Locations.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import OurStory from '~/components/widgets/OurStory.astro';
import { site } from '~/config/site';
import { PRIMARY_CTA_LABEL, PRIMARY_CTA_HREF } from '~/config/cta';
import heroCover from '~/assets/images/hero-cover.png';

const metadata = {
  title: site.name,
  description: site.description,
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero2
    id="home-hero"
    variant="overlay"
    overlapHeader={false}
    tagline="Kailua-born since 2006 · Six spots on O‘ahu"
    title="Salads with a side of aloha."
    subtitle="Island-grown produce, never-frozen local ahi, and bowls built the way you like them. Real food, made with care — the way we'd feed our own family."
    image={{ ...heroCover, alt: 'Fresh ahi salad with island greens and avocado' }}
    actions={[
      { variant: 'primary', text: PRIMARY_CTA_LABEL, href: PRIMARY_CTA_HREF },
      { variant: 'ghost', text: 'find a location', href: '/locations' },
    ]}
  />
  <BrandBar />
  <FeaturedDishes
    eyebrow="Featured dishes"
    title="The ones people come back for."
    subtitle="A few island favorites — or skip the menu entirely and build your own."
    ctaText="view full menu"
    ctaHref="/menu"
    dishes={[
      {
        title: 'Ono Island Ahi',
        description: 'Fresh local ahi, never frozen, over crisp island greens.',
      },
      {
        title: 'Aloha Passion',
        description: 'Blue cheese, candied walnuts, and a bright vinaigrette.',
      },
      {
        title: 'The Paniolo',
        description: 'Cheddar, black beans, and a smoky BBQ ranch.',
      },
    ]}
  />
  <LocalSourcing
    eyebrow="Our ingredients & local sourcing"
    title="Sourced close to home, on purpose."
    subtitle="We've bought from local farmers and fishermen since day one in Kailua. Here's what that actually means on your plate — in specifics, not adjectives."
    ctaText="See where our food comes from"
    ctaHref="/ingredients"
    facts={[
      {
        title: 'Never-frozen ahi',
        description: 'Fresh, local ahi — delivered, not frozen, not shipped in from far away.',
      },
      {
        title: 'Island-grown produce',
        description: 'Greens and vegetables from local Hawai‘i farms, in season whenever we can.',
      },
      {
        title: 'Māmaki mint tea',
        description: 'Brewed from māmaki grown on Hawai‘i Island — a true taste of the islands.',
      },
      {
        title: '100% compostable',
        description: 'Every piece of our packaging is eco-friendly and fully compostable. All of it.',
      },
    ]}
  />
  <Locations id="locations" />
  <SaladBuilder id="salad-builder" />
  <Testimonials id="reviews" />
  <OurStory id="our-story" />
</Layout>
