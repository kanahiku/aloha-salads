---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import BrandBar from '~/components/widgets/BrandBar.astro';
import MenuCategories from '~/components/widgets/MenuCategories.astro';
import Locations from '~/components/widgets/Locations.astro';
import Testimonials from '~/components/widgets/Testimonials.astro';
import LocalSourcing from '~/components/widgets/LocalSourcing.astro';
import { PRIMARY_CTA_HREF, CATERING_CTA_HREF } from '~/config/cta';
import { getSanityHomepageImages } from '~/lib/content/sanity';

const homepageImages = await getSanityHomepageImages();
// Hero background is chosen in Sanity (Homepage → "Hero background"). Image OR video, never both;
// `heroVideo` is only set when video is selected and its file + poster are uploaded, otherwise
// the hero falls back to the photo.
const heroVideo = homepageImages.heroMedia === 'video' ? homepageImages.heroVideo : undefined;

const metadata = {
  title: 'Aloha Salads | Fresh Salads & Local Ahi on Oahu',
  description:
    'Founded in Kailua in 2006, Aloha Salads serves fresh island-grown produce and never-frozen local ahi across six Oahu locations. Order online for pickup.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  {/* ── 1. Hero ───────────────────────────────────────────── */}
  <Hero2
    id="home-hero"
    variant="overlay"
    overlapHeader={false}
    tagline="Kailua-born since 2006 · Six spots on Oahu"
    title="Aloha Salads: Fresh Food<br/>Crafted Daily on Oahu."
    subtitle="Founded in Kailua in May 2006, Aloha Salads provides fresh, locally grown food tailored to active island lifestyles. Voted First Place Hawaiis Best 2024 in the Peoples Choice Awards by the Star Advertiser, we operate six neighborhood restaurants across Oahu."
    {...heroVideo ? { video: heroVideo } : { image: homepageImages.hero }}
    actions={[
      { variant: 'primary', text: 'Order Online', href: PRIMARY_CTA_HREF },
      { variant: 'ghost', text: 'Order Catering', href: CATERING_CTA_HREF },
    ]}
  />

  {/* ── 2. Brand bar ─────────────────────────────────────── */}
  <BrandBar />

  {/* ── 3. Menu categories ───────────────────────────────── */}
  <MenuCategories
    eyebrow="Order Now"
    title="Explore Our Full Menu"
    subtitle="We prepare fresh meals daily across our six Oahu locations. Browse our core categories below to find your meal or order ahead for fast pickup."
    ctaText="View Full Menu"
    ctaHref="/menu"
    maxRows={2}
  />

  {/* ── 4. Local sourcing — text only, same layout as menu subpages ── */}
  <LocalSourcing
    eyebrow="Local sourcing"
    title="Our Local Sourcing"
    subtitle="We partner with Hawaii growers and suppliers to bring quality ingredients into our kitchens. We feature vine-ripe tomatoes from Hauula and exclusively use never-frozen local ahi sourced through a Honolulu seafood supplier with vessel-level catch traceability."
    ctaText="Our Ingredients"
    ctaHref="/ingredients"
    withPhoto={false}
  />

  {/* ── 5. Testimonials — fetched from Sanity ────────────── */}
  <Testimonials id="reviews" heading="What Our Customers Say" />

  {/* ── 6. Locations ─────────────────────────────────────── */}
  <Locations
    id="locations"
    eyebrow="Visit Now"
    title="Visit a Store Near You"
    subtitle="Stop by any of our six Oahu locations in Kailua, Kahala, Kaneohe, Kapolei, Mililani, or Pearlridge."
    ctaText="View All Locations"
    ctaHref="/locations"
    image={homepageImages.locations}
  />

  {/* ── 7. Salad builder — hidden (not in copy brief) ───── */}
  {/* <SaladBuilder id="salad-builder" /> */}

  {/* ── 8. Our story — hidden (not in copy brief) ─────── */}
  {/* <OurStory id="our-story" /> */}
</Layout>
