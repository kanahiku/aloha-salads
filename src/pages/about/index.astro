---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import ourStoryCover from '~/assets/images/our-story-cover.webp';

const metadata = {
  title: 'About Aloha Salads | Our Story & Local Sourcing on Oahu',
  description:
    'Learn about Aloha Salads. Founded in Kailua in 2006, we serve fresh, locally sourced food across six Oahu locations. Read our story.',
  ignoreTitleTemplate: true,
};
---

<PageLayout metadata={metadata}>

  {/* ── Page hero ─────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    tagline="About Us"
    title="About Aloha Salads"
    content="Kailua-born since 2006. Six locations across O'ahu. Twenty years of fresh, locally sourced food made with ingredients you can trust."
    image={{ ...ourStoryCover, alt: 'Aloha Salads team at the original Kailua location' }}
    actions={[
      { variant: 'primary', text: 'View Menu', href: '/menu' },
      { variant: 'ghost-dark', text: 'Find a Location', href: '/locations' },
    ]}
  />

  {/* ── 1. Our Mission ────────────────────────────────────── */}
  <TextSplit eyebrow="Our Mission" heading="Our Mission">
    <div class="flex flex-col gap-6">
      <blockquote class="border-l-4 border-accent pl-6">
        <Text variant="body-lg" color="default" class="italic">
          "Aloha Salads was established to serve fresh, locally grown food of the highest quality at affordable prices. We remain dedicated to supporting local farmers and fishermen while providing our customers with fresh and delicious ingredients."
        </Text>
      </blockquote>
      <Text variant="body" color="muted">
        That commitment has guided every decision we have made since May 2006 — from the produce we source to the dressings we make from scratch every morning.
      </Text>
    </div>
  </TextSplit>

  {/* ── 2. Our Story ──────────────────────────────────────── */}
  <TextSplit
    eyebrow="Our Story"
    heading="Our Story"
    withImage
    imageAspect="4 / 5"
    class="bg-section-grey"
  >
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Aloha Salads opened its first location at Kailua Shopping Center in May 2006. From day one, the goal was straightforward: give the community a place to eat food that is genuinely good for you, made with ingredients you can trust, at prices that make that easy to do every day.
      </Text>
      <Text variant="body" color="default">
        Twenty years later, that original promise still runs the kitchen. What started as a single neighborhood spot has grown into six locations across O'ahu — each one serving the same scratch-made dressings, the same never-frozen local ahi, and the same produce sourced as close to home as possible.
      </Text>
      <Text variant="body" color="default">
        In 2024, the Star Advertiser's People's Choice Awards named us <strong>First Place, Hawaii's Best</strong>. We're proud of it — and more proud that it came from the community we've been serving since the beginning.
      </Text>
      <Text variant="body-lg" color="muted" class="text-sm italic">
        {/* TODO: Founder story — additional details coming soon */}
        Founder story coming soon.
      </Text>
    </div>
    <img
      slot="image"
      src={ourStoryCover.src}
      alt="Aloha Salads original Kailua location"
      width={ourStoryCover.width}
      height={ourStoryCover.height}
      class="h-full w-full rounded-[32px] object-cover"
      loading="lazy"
      decoding="async"
    />
  </TextSplit>

  {/* ── 3. Sustainability — image left / text right ──────────── */}
  <TextSplit
    eyebrow="Sustainability"
    heading="Sustainability"
    withImage
    imageReverse
    imageAspect="4 / 3"
  >
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        The most straightforward thing we do for sustainability is buy local — on a standing weekly order, not as a trend. Hau'ula tomatoes come in every week from a single O'ahu farm. Our produce comes from island growers wherever the season and supply hold up. The ahi on your plate was never frozen and came from Hawaii waters.
      </Text>
      <Text variant="body" color="default">
        Keeping the supply chain short means less transport, less cold-chain energy, and money that stays in the state. It also means the food is fresher when it reaches your bowl.
      </Text>
      {/* TODO: Packaging — details to be confirmed and added here */}
      <Text variant="body" color="muted" class="text-sm italic">
        Packaging details coming soon.
      </Text>
      <div>
        <Button variant="primary" text="See Our Ingredients" href="/ingredients" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  {/* ── 4. Our Vendors — text left / image right ─────────── */}
  <TextSplit
    eyebrow="Our Vendors"
    heading="Our Vendors"
    withImage
    imageAspect="4 / 3"
    class="bg-section-grey"
  >
    <div class="flex flex-col gap-6">
      <Text variant="body-lg" color="default">
        Every delivery of local ahi arrives with a lot number and the name of the catch vessel on the paperwork. We know where the fish came from. That traceability is non-negotiable.
      </Text>
      <Text variant="body" color="default">
        Our other key suppliers — produce, proteins, and pantry — are all confirmed and operating on standing orders. We're not publishing names yet, but the sourcing page covers what's on your plate and where it comes from.
      </Text>
      <div>
        <Button variant="primary" text="See Our Ingredients" href="/ingredients" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  {/* ── Find a Location CTA ───────────────────────────────── */}
  <CTABanner
    title="Find a Location"
    subtitle="Six neighborhood restaurants across O'ahu. Come see us."
    ctaText="Find a Location"
    ctaHref="/locations"
  />

</PageLayout>
