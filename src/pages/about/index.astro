---
import PageLayout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import TextSplit from '~/components/widgets/TextSplit.astro';
import CTABanner from '~/components/widgets/CTABanner.astro';
import Text from '~/components/ui/Text.astro';
import Button from '~/components/ui/Button.astro';
import { getSanityAboutImages } from '~/lib/content/sanity';
import { getSanityAboutContent } from '~/lib/content/pageContent';
import { inlineToHtml, textToHtml } from '~/lib/content/richText';

const [aboutImages, content] = await Promise.all([getSanityAboutImages(), getSanityAboutContent()]);
const { mission, story, sustainability, vendors } = content;

const metadata = {
  title: content.meta.title,
  description: content.meta.description,
  ignoreTitleTemplate: true,
};

// First paragraph is the lead (larger); the rest are body copy.
const [storyLead, ...storyRest] = story.paragraphs;
const [sustainabilityLead, ...sustainabilityRest] = sustainability.paragraphs;
const [vendorsLead, ...vendorsRest] = vendors.paragraphs;
---

<PageLayout metadata={metadata}>
  {/* ── Page hero ─────────────────────────────────────────── */}
  <Hero2
    variant="split-dark"
    overlapHeader={false}
    title={textToHtml(content.hero.title)}
    content={textToHtml(content.hero.content)}
    image={aboutImages.hero}
    imageFit="contain"
    actions={[
      { variant: 'primary', text: content.hero.primaryCtaLabel, href: '/menu' },
      { variant: 'ghost-dark', text: content.hero.secondaryCtaLabel, href: '/locations' },
    ]}
  />

  {/* ── 1. Our Mission ────────────────────────────────────── */}
  <TextSplit heading={mission.heading}>
    <div class="flex flex-col gap-6">
      <blockquote class="border-l-4 border-accent pl-6">
        <Text variant="body-lg" color="default" class="italic">"{mission.quote}"</Text>
      </blockquote>
      <Text variant="body" color="muted">{mission.body}</Text>
    </div>
  </TextSplit>

  {/* ── 2. Our Story ──────────────────────────────────────── */}
  <TextSplit heading={story.heading} withImage image={aboutImages.story} imageAspect="4 / 5" class="bg-card">
    <div class="flex flex-col gap-6">
      {storyLead && <Text variant="body-lg" color="default" html={inlineToHtml(storyLead)} />}
      {storyRest.map((paragraph) => <Text variant="body" color="default" html={inlineToHtml(paragraph)} />)}
      {
        story.note && (
          <Text variant="body-lg" color="muted" class="text-sm italic">
            {story.note}
          </Text>
        )
      }
    </div>
  </TextSplit>

  {/* ── 3. Sustainability — image left / text right ──────────── */}
  <TextSplit
    heading={sustainability.heading}
    withImage
    image={aboutImages.sustainability}
    imageReverse
    imageAspect="4 / 3"
  >
    <div class="flex flex-col gap-6">
      {sustainabilityLead && <Text variant="body-lg" color="default" html={inlineToHtml(sustainabilityLead)} />}
      {sustainabilityRest.map((paragraph) => <Text variant="body" color="default" html={inlineToHtml(paragraph)} />)}
      {
        sustainability.note && (
          <Text variant="body" color="muted" class="text-sm italic">
            {sustainability.note}
          </Text>
        )
      }
      <div>
        <Button variant="primary" text={sustainability.ctaLabel} href="/ingredients" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  {/* ── 4. Our Vendors — text left / image right ─────────── */}
  <TextSplit
    heading={vendors.heading}
    withImage
    image={aboutImages.vendors}
    imageAspect="4 / 3"
    class="bg-section-grey"
  >
    <div class="flex flex-col gap-6">
      {vendorsLead && <Text variant="body-lg" color="default" html={inlineToHtml(vendorsLead)} />}
      {vendorsRest.map((paragraph) => <Text variant="body" color="default" html={inlineToHtml(paragraph)} />)}
      <div>
        <Button variant="primary" text={vendors.ctaLabel} href="/ingredients" hideNote={true} />
      </div>
    </div>
  </TextSplit>

  {/* ── Find a Location CTA ───────────────────────────────── */}
  <CTABanner title={content.cta.title} subtitle={content.cta.subtitle} />
</PageLayout>
