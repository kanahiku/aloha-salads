---
import Layout from '~/layouts/PageLayout.astro';
import Hero2 from '~/components/widgets/Hero2.astro';
import Header from '~/components/widgets/Header.astro';
import PodcastFilter from '~/components/widgets/PodcastFilter.astro';
import PodcastEpisodes from '~/components/widgets/PodcastEpisodes.astro';
import { site } from '~/config/site';
import { navigationData } from '~/data/navigation';

const metadata = {
  title: `Podcast | ${site.name}`,
  description:
    "Aging isn't a decline to manage — it's a chapter to author. Across 28 fearless episodes, we dismantle the stereotypes society hands us and reclaim every system of the body.",
  ignoreTitleTemplate: true,
};

const header = navigationData.header;

const filterTabs = [
  { label: 'Head & Senses', id: 'head-senses' },
  { label: 'Core & Vital Systems', id: 'core-vital' },
  { label: 'Structural & Movement', id: 'structural' },
  { label: 'Cellular & Deep Biology', id: 'cellular' },
];

const sampleEpisode = {
  title: 'Brain',
  tag: 'head & senses',
  description:
    'Lorem ipsum dolor sit amet, consectetur adipiscing elit. Ut et massa mi. Aliquam in hendrerit urna. Pellentesque sit amet sapien fringilla, mattis ligula consectetur, ultrices mauris.',
  ctaText: 'Read the guidebook',
  ctaHref: '/guidebooks',
};
---

<Layout metadata={metadata}>
  <Fragment slot="header" />

  <Hero2
    variant="page"
    stacked
    overlapHeader={false}
    title="The Rebellious Aging Podcast"
    subtitle="Aging isn't a decline to manage — it's a chapter to author. Across 28 fearless episodes, we dismantle the stereotypes society hands us and reclaim every system of the body, from mitochondria to mindset. This is not gentle wellness. This is a community of rebels choosing strength, clarity, and vitality on our own terms."
  >
    <Header
      slot="nav"
      embedded
      isSticky={false}
      links={header.links}
      actions={header.actions}
    />
  </Hero2>

  <PodcastFilter
    id="roadmap"
    eyebrow="the roadmap"
    heading="Every system. Every stereotype. One by one."
    description="The full series rolls out over the coming months. Here's the incredible roadmap ahead — organized by the systems they reclaim. Subscribe on your platform of choice so you never miss a drop."
    tabs={filterTabs}
  />

  <PodcastEpisodes
    id="head-senses-dark"
    tone="dark"
    eyebrow="8 episodes"
    heading="Head & Senses"
    description="How perception, cognition, and identity evolve — and how to keep them sharp."
    episodes={[sampleEpisode]}
  />

  <PodcastEpisodes
    id="head-senses-light"
    tone="light"
    eyebrow="8 episodes"
    heading="Head & Senses"
    description="How perception, cognition, and identity evolve — and how to keep them sharp."
    episodes={[sampleEpisode]}
  />
</Layout>
